#!/usr/bin/env bash
#
# dolt-flatten-maintenance: weekly threshold-triggered Dolt history flatten
# for EVERY managed bead database above a commit-depth threshold.
#
# Generalized 2026-07-14 from bin/gascity-dolt-flatten-maintenance (gascity db
# only) per mayor scope-add nudge gc-481831 on dr-84l; the flatten operation
# class was Stephanie-authorized 2026-07-13 ("do the bloat fix as soon as
# possible") and executed cleanly on mem/EnterpriseBench/gascity/gc that night
# (dr-84l: 7743/9132/3664/376 commits -> 1 each, health gates green).
#
# Why this exists: every bead write auto-commits one Dolt commit, so history
# depth grows unbounded per db. Past a few thousand commits the workflow /
# convoy queries slow enough to blow the 30s sling sub-timeout and kill
# dispatches (2026-06-17 incident: convoy list 68s -> 11s after flattening).
# dolt-gc-maintenance (online CALL DOLT_GC) can't fix this — the history is
# reachable, not garbage. bd compact fails on these stores (cherry-pick
# replays historical FK-violating intermediates). bd flatten squashes all
# history off the CLEAN current HEAD with no replay, which works.
#
# Per db, ascending depth (learn on small): threshold gate -> rig-dir mapping
# with project-id identity check -> quiescence guard -> bd dry-run cross-check
# -> snapshot-first+verify -> flatten -> post-depth + health gate -> rotate
# snapshots (keep newest 1) -> reclaim disk. Any per-db failure ABORTS the
# remaining dbs and mails mayor (dr-84l abort rule). Never silent. NEVER
# deletes a bead; preserves all rows (bd gc runs --skip-decay). Runs against
# the live server endpoint (never `dolt` inside .beads/dolt while the server
# holds the LOCK).
#
# DOLT_FLATTEN_DRY_RUN=1: stop each db after the read-only checks (threshold,
# mapping, quiescence, bd dry-run) — zero writes, no mail, report to log only.
#
set -euo pipefail

# --- config (review before install) -----------------------------------------
INFO_FILE="/home/ds/gas-city/.beads/dolt/.dolt/sql-server.info"  # pid:port:uuid
DOLT_BIN="/home/ds/.local/bin/dolt"
BD="/home/ds/.local/bin/bd"
GC="/home/ds/go/bin/gc"             # for the anomaly surface mail
THRESHOLD=5000                      # flatten only above this commit depth
HIGH_WATER=10000                    # quiescence-abort above this => surface to mayor
SNAPSHOT_KEEP=1                     # keep most-recent N pre-flatten snapshots per db
SNAP_PREFIX="pre-flatten-"
QUIESCE_WAIT=30                     # seconds to watch for active writes
LOG="$HOME/.gc/dolt-flatten-maintenance.log"
DRY_RUN="${DOLT_FLATTEN_DRY_RUN:-0}"
# roots scanned for a db's rig dir (.beads/metadata.json declares dolt_database)
SEARCH_ROOTS=(/home/ds/gas-city /home/ds/gascity /home/ds/gascity-packs
              /home/ds/gascity-dashboard /home/ds/projects/*)
# ----------------------------------------------------------------------------

mkdir -p "$(dirname "$LOG")"
log() { echo "$(date -Iseconds) $*" | tee -a "$LOG" >&2; }

# best-effort surface to mayor; never let a notify failure crash the run.
# No --from: gc validates senders against known sessions, so a made-up name is
# rejected (the pre-generalize script's --from was a latent bug its WARN hid).
notify_mayor() {
  [ "$DRY_RUN" = "1" ] && { log "DRY-RUN: would mail mayor: $1"; return 0; }
  "$GC" mail send mayor --notify -s "$1" -m "$2" \
    >>"$LOG" 2>&1 || log "WARN: notify_mayor failed (mail unavailable in this context)"
}

log "=== flatten-maintenance run start (dry_run=${DRY_RUN}) ==="

if [[ ! -f "$INFO_FILE" ]]; then
  log "ERROR: sql-server.info not found at $INFO_FILE — is the managed dolt server up?"
  exit 1
fi
PORT="$(cut -d: -f2 "$INFO_FILE")"
if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then
  log "ERROR: could not parse port from $INFO_FILE (got '$PORT')"
  exit 1
fi
DOLT=("$DOLT_BIN" --host 127.0.0.1 --port "$PORT" --user root --no-tls --password '')

if ! "${DOLT[@]}" sql -q "SELECT 1;" >/dev/null 2>&1; then
  log "ERROR: dolt server 127.0.0.1:${PORT} unreachable"
  exit 1
fi

# single scalar from a csv result (header on line 1, value on line 2)
sql_scalar() { "${DOLT[@]}" sql -q "$1" -r csv 2>/dev/null | sed -n '2p'; }
db_depth()   { sql_scalar "USE \`$1\`; SELECT COUNT(*) FROM dolt_log;"; }

# rig dir for a db: scan roots for .beads/metadata.json declaring this
# dolt_database (backend=dolt, dolt_mode=server), then require the dir's
# project_id to match the db's metadata._project_id (identity check; multiple
# valid matches are clones of the same store — first sorted wins). Empty
# output = unmapped.
map_db_dir() {
  local db="$1" dir cands=() pid m
  for dir in "${SEARCH_ROOTS[@]}"; do
    m="$dir/.beads/metadata.json"
    [ -f "$m" ] || continue
    if python3 -c "
import json,sys
j=json.load(open('$m'))
sys.exit(0 if j.get('backend')=='dolt' and j.get('dolt_mode')=='server'
             and j.get('dolt_database')=='$db' else 1)" 2>/dev/null; then
      cands+=("$dir")
    fi
  done
  [ "${#cands[@]}" -eq 0 ] && return 0
  pid="$(sql_scalar "USE \`$db\`; SELECT value FROM metadata WHERE \`key\`='_project_id';")"
  if [ -z "$pid" ]; then
    # no identity recorded db-side: only a UNIQUE candidate is safe
    [ "${#cands[@]}" -eq 1 ] && echo "${cands[0]}"
    return 0
  fi
  for dir in $(printf '%s\n' "${cands[@]}" | sort); do
    if python3 -c "
import json,sys
sys.exit(0 if json.load(open('$dir/.beads/metadata.json')).get('project_id')=='$pid' else 1)" 2>/dev/null; then
      echo "$dir"
      return 0
    fi
  done
}

# real bead databases only — skip dolt/mysql system schemas and the probe db
mapfile -t DBS < <("${DOLT[@]}" sql -q "SHOW DATABASES;" -r csv 2>/dev/null \
  | tail -n +2 \
  | grep -ivE '^(information_schema|mysql|__gc_probe|Database)$')
if [[ ${#DBS[@]} -eq 0 ]]; then
  log "ERROR: no databases returned from server on port $PORT"
  exit 1
fi

# threshold gate across the fleet; queue above-threshold dbs ascending by depth
QUEUE=()  # "depth db" lines
for db in "${DBS[@]}"; do
  depth="$(db_depth "$db")"
  if [[ ! "$depth" =~ ^[0-9]+$ ]]; then
    log "WARN: could not read commit depth for $db (got '$depth'); skipping"
    continue
  fi
  if [ "$depth" -gt "$THRESHOLD" ]; then
    QUEUE+=("$depth $db")
    log "queued  $db depth=$depth (> $THRESHOLD)"
  else
    log "below   $db depth=$depth"
  fi
done
if [ "${#QUEUE[@]}" -eq 0 ]; then
  log "no db above threshold ${THRESHOLD}; done"
  exit 0
fi
mapfile -t QUEUE < <(printf '%s\n' "${QUEUE[@]}" | sort -n)

FLATTENED=() ANOMALIES=()

# per-db worker: returns 0 = flattened, 1 = skipped (safe, logged), 2 = FAILED
flatten_db() {
  local db="$1" depth="$2" dir depth2 dryn snap snap_depth new_depth i b
  dir="$(map_db_dir "$db")"
  if [ -z "$dir" ]; then
    log "SKIP $db: no rig dir maps to it (metadata.json/dolt_database + project_id scan)"
    ANOMALIES+=("$db depth=$depth UNMAPPED — no rig dir passes the identity check; flatten it manually or fix the metadata")
    return 1
  fi
  log "$db -> $dir (identity-checked)"

  # quiescence guard: depth stable across the window
  sleep "$QUIESCE_WAIT"
  depth2="$(db_depth "$db")"
  if [ "${depth2:-0}" -ne "$depth" ]; then
    log "SKIP $db: not quiescent (depth ${depth}->${depth2} in ${QUIESCE_WAIT}s)"
    if [ "${depth2:-0}" -gt "$HIGH_WATER" ]; then
      ANOMALIES+=("$db depth=$depth2 NEVER-QUIESCES past high-water $HIGH_WATER — dispatch will slide toward the 30s sling cliff; needs a deliberately-quiesced manual window")
    fi
    return 1
  fi

  # store-identity cross-check: bd from this dir must see the same history
  dryn="$("$BD" -C "$dir" flatten --dry-run --json 2>>"$LOG" \
          | python3 -c 'import json,sys; print(json.load(sys.stdin).get("commit_count",-1))' 2>/dev/null || echo -1)"
  if [ "$dryn" != "$depth2" ]; then
    log "SKIP $db: bd dry-run from $dir sees ${dryn} commits, server sees ${depth2} — wrong store or mid-write; not flattening"
    ANOMALIES+=("$db depth=$depth2 IDENTITY-MISMATCH — bd@$dir dry-run=$dryn vs server=$depth2")
    return 1
  fi
  if [ "$DRY_RUN" = "1" ]; then
    log "DRY-RUN $db: would flatten ${depth2} commits -> 1 via bd -C $dir"
    return 1
  fi

  # snapshot FIRST, then verify it resolves to the full pre-flatten tip
  snap="${SNAP_PREFIX}$(date -u +%Y%m%d-%H%M%S)"
  "${DOLT[@]}" sql -q "USE \`$db\`; CALL DOLT_BRANCH('${snap}');" >/dev/null
  snap_depth="$(sql_scalar "USE \`$db\`; SELECT COUNT(*) FROM dolt_log AS OF '${snap}';")"
  if [ "${snap_depth:-0}" -ne "$depth2" ]; then
    log "FAIL $db: snapshot ${snap} depth ${snap_depth} != pre-flatten depth ${depth2}; NOT flattening"
    return 2
  fi
  log "$db snapshot ${snap} verified (${snap_depth} commits) — safety net in place"

  # flatten (off the clean current HEAD; never deletes a bead)
  if ! "$BD" -C "$dir" flatten --force >>"$LOG" 2>&1; then
    log "FAIL $db: bd flatten --force errored (recovery branch ${snap} intact)"
    return 2
  fi
  # the flatten recipe leaves exactly 2 commits (original init root + squash
  # snapshot — verified on scix_experiments 2026-07-14); allow +1 for a
  # concurrent post-swap write. More than that = the swap didn't take.
  new_depth="$(db_depth "$db")"
  if [ "${new_depth:-0}" -gt 3 ]; then
    log "FAIL $db: post-flatten depth ${new_depth} > 3 (recovery branch ${snap} intact)"
    return 2
  fi

  # health gate (dr-84l): store answers queries + supervisor still up.
  # Deliberately NOT `gc session list` — that rides the /v0/city/status path
  # with the known multi-minute hang (dr-7smz8) and would eat the order timeout.
  if ! "$BD" -C "$dir" list --limit 1 >/dev/null 2>>"$LOG"; then
    log "FAIL $db: health gate — bd list errors post-flatten (recovery branch ${snap})"
    return 2
  fi
  if ! systemctl --user is-active --quiet gascity-supervisor; then
    log "FAIL $db: health gate — gascity-supervisor not active post-flatten"
    return 2
  fi
  log "$db flattened ${depth2} -> ${new_depth}; health gate green"

  # rotate: keep most-recent SNAPSHOT_KEEP pre-flatten snapshots, drop the rest
  i=0
  while read -r b; do
    [ -z "$b" ] && continue
    i=$((i+1))
    if [ "$i" -gt "$SNAPSHOT_KEEP" ]; then
      "${DOLT[@]}" sql -q "USE \`$db\`; CALL DOLT_BRANCH('-D', '${b}');" >/dev/null
      log "$db rotated out old snapshot ${b}"
    fi
  done < <("${DOLT[@]}" sql -q "USE \`$db\`; SELECT name FROM dolt_branches WHERE name LIKE '${SNAP_PREFIX}%' ORDER BY name DESC;" -r csv 2>/dev/null | tail -n +2)

  # reclaim disk now that rotated-out snapshots are unreferenced
  "$BD" -C "$dir" gc --skip-decay --force >>"$LOG" 2>&1 \
    || log "WARN: $db bd gc failed (nightly dolt-gc-maintenance will reclaim)"
  FLATTENED+=("$db ${depth2}->${new_depth}")
  return 0
}

for entry in "${QUEUE[@]}"; do
  depth="${entry%% *}"; db="${entry#* }"
  rc=0; flatten_db "$db" "$depth" || rc=$?
  if [ "$rc" -eq 2 ]; then
    log "ABORT: $db failed; not proceeding to remaining dbs (dr-84l abort rule)"
    notify_mayor "dolt flatten ABORTED at $db — remaining dbs untouched" \
"dolt-flatten-maintenance failed on db '$db' and stopped before the remaining above-threshold dbs (abort rule from dr-84l). Flattened this run before the failure: ${FLATTENED[*]:-none}. The per-db recovery branch (${SNAP_PREFIX}*) is intact where noted. Inspect ${LOG} and the store before re-firing."
    exit 1
  fi
done

log "run summary: flattened=[${FLATTENED[*]:-none}] anomalies=${#ANOMALIES[@]}"
if [ "${#ANOMALIES[@]}" -gt 0 ]; then
  notify_mayor "dolt flatten: ${#ANOMALIES[@]} db(s) need attention" \
"dolt-flatten-maintenance completed (flattened: ${FLATTENED[*]:-none}) but these dbs could not be handled automatically:
$(printf ' - %s\n' "${ANOMALIES[@]}")
Log: ${LOG}"
fi
log "run end"
