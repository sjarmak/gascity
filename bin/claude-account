#!/usr/bin/env bash
# claude-account: launch claude with per-account credential isolation.
# Each account gets its own CLAUDE_CONFIG_DIR but shares skills, hooks,
# MCP configs, settings, and rules from the main ~/.claude/ directory
# via symlinks. This avoids the credential race condition (overwriting
# a shared .credentials.json) while preserving full Claude Code config.
#
# Bootstrap (symlink seeding + JSON config writes) is serialized per
# account via flock, and every JSON write uses tmp + os.replace, so
# concurrent launches against the same account can't corrupt
# .claude.json or settings.json. See bd issue gc-arr.
set -euo pipefail

ACCOUNT="${1:?Usage: claude-account <1-5|auto> [args...]}"
shift

# "auto" mode: delegate to csu_pick.sh which reads Claude usage utilization
# and returns the lowest-loaded account number. See bin/csu_pick.sh for the
# selection rule and tunables. Falls back to "1" if the picker fails.
if [ "$ACCOUNT" = "auto" ]; then
  PICK_BIN="$(dirname "${BASH_SOURCE[0]}")/csu_pick.sh"
  if [ -x "$PICK_BIN" ]; then
    PICKED="$("$PICK_BIN" 2>/dev/null || true)"
  else
    PICKED=""
  fi
  case "$PICKED" in
    [1-9]) ACCOUNT="$PICKED" ;;
    *)     ACCOUNT="1" ;;
  esac
  echo "claude-account: auto picked account$ACCOUNT" >&2
fi

export CLAUDE_CONFIG_DIR="$HOME/.claude-homes/account${ACCOUNT}/.claude"

if [ ! -f "$CLAUDE_CONFIG_DIR/.credentials.json" ]; then
  echo "ERROR: Credentials not found at $CLAUDE_CONFIG_DIR/.credentials.json" >&2
  exit 1
fi

# Serialize the bootstrap section. The lock fd (9) is closed before
# exec claude, so the agent process does not inherit it.
ACCOUNT_HOME="$(dirname "$CLAUDE_CONFIG_DIR")"
mkdir -p "$ACCOUNT_HOME"
exec 9>"$ACCOUNT_HOME/.claude-account.lock"
flock 9

# Symlink shared config from ~/.claude/ into the account dir.
# Idempotent — existing files/links are left alone.
for item in commands hooks skills mcp-configs settings.json settings.local.json rules agents ecc scripts; do
  src="$HOME/.claude/$item"
  dest="$CLAUDE_CONFIG_DIR/$item"
  if [ -e "$src" ] && [ ! -e "$dest" ]; then
    ln -s "$src" "$dest"
  fi
done

# Bootstrap onboarding state if this account has never completed it.
# Without hasCompletedOnboarding, Claude shows the interactive theme
# picker and login flow which block headless/agent sessions.
# .claude.json lives in the PARENT of CLAUDE_CONFIG_DIR.
CLAUDE_JSON="$ACCOUNT_HOME/.claude.json"
if [ -f "$CLAUDE_JSON" ]; then
  if ! python3 -c "import json,sys; d=json.load(open('$CLAUDE_JSON')); sys.exit(0 if d.get('hasCompletedOnboarding') else 1)" 2>/dev/null; then
    python3 - "$CLAUDE_JSON" <<'PYEOF'
import json, os, sys, tempfile
path = sys.argv[1]
with open(path) as f:
    d = json.load(f)
d['hasCompletedOnboarding'] = True
d.setdefault('lastOnboardingVersion', '2.1.92')
d.setdefault('numStartups', 1)
d.setdefault('installMethod', 'native')
d.setdefault('autoUpdates', False)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or '.', prefix='.claude-account.')
try:
    with os.fdopen(fd, 'w') as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, path)
except Exception:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PYEOF
  fi
else
  tmp="$(mktemp -p "$ACCOUNT_HOME" .claude-account.XXXXXX)"
  printf '%s' '{"hasCompletedOnboarding": true, "numStartups": 1, "installMethod": "native", "autoUpdates": false}' > "$tmp"
  mv -f "$tmp" "$CLAUDE_JSON"
fi

# Ensure skipDangerousModePermissionPrompt is set (supplements
# --dangerously-skip-permissions flag).
SETTINGS="$CLAUDE_CONFIG_DIR/settings.json"
if [ -f "$SETTINGS" ]; then
  if ! python3 -c "import json,sys; sys.exit(0 if json.load(open('$SETTINGS')).get('skipDangerousModePermissionPrompt') else 1)" 2>/dev/null; then
    python3 - "$SETTINGS" <<'PYEOF'
import json, os, sys, tempfile
path = sys.argv[1]
with open(path) as f:
    d = json.load(f)
d['skipDangerousModePermissionPrompt'] = True
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or '.', prefix='.claude-account.')
try:
    with os.fdopen(fd, 'w') as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, path)
except Exception:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PYEOF
  fi
fi

# Pool workers are unattended; named sessions retain human-facing tools and
# prompts. Keep one discriminator for both startup-modal and tool-modal policy
# so the two controls cannot silently drift apart.
IS_UNATTENDED_POOL=0
case "$(basename "${GC_TEMPLATE:-}")" in
  *-worker | *polecat) IS_UNATTENDED_POOL=1 ;;
esac

# Pre-accept the trust dialog for every managed working directory. For
# unattended pool workers only, also pre-accept the external-includes import
# prompt; named sessions keep that security decision visible to their human.
if [ -f "$CLAUDE_JSON" ]; then
  python3 - "$CLAUDE_JSON" "$IS_UNATTENDED_POOL" <<'PYEOF'
import json, os, sys, tempfile

claude_json = sys.argv[1]
unattended_pool = sys.argv[2] == '1'
work_dir = os.environ.get('GC_WORK_DIR', os.getcwd())

with open(claude_json) as f:
    d = json.load(f)

projects = d.setdefault('projects', {})
changed = False

keys = ['hasTrustDialogAccepted']
if unattended_pool:
    # Importing an AGENTS.md/CLAUDE.md outside the trusted project otherwise
    # parks a worker before normal tool execution (dr-oo8d).
    keys.extend([
        'hasClaudeMdExternalIncludesApproved',
        'hasClaudeMdExternalIncludesWarningShown',
    ])
for _k in keys:
    if not projects.get(work_dir, {}).get(_k):
        projects.setdefault(work_dir, {})[_k] = True
        changed = True

if changed:
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(claude_json) or '.', prefix='.claude-account.')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(d, f, indent=2)
        os.replace(tmp, claude_json)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise
PYEOF
fi

# Set CLAUDE_PLUGIN_ROOT so ECC hooks (quality-gate, format, typecheck) can find their scripts.
export CLAUDE_PLUGIN_ROOT="$HOME/.claude"

# Strip interactive-modal tools from UNATTENDED pool workers only (dr-3sz).
# A pool worker (GC_TEMPLATE basename ends in -worker or polecat) has no human
# at its TUI to answer an AskUserQuestion modal, so invoking it parks the
# session forever: it reads "active" in `gc session list` but is unreachable for
# routed work. Named sessions (PLs, mayor, city-infra-pl — *.project-lead / *-pl
# / mayor) keep the tool; a human-shaped agent is watching them. Fail-open:
# anything not clearly a pool worker gets no flag, so this branch can never
# break a launch (unset/empty GC_TEMPLATE -> basename "." -> no match).
WORKER_TOOL_ARGS=()
if (( IS_UNATTENDED_POOL )); then
  WORKER_TOOL_ARGS=(--disallowedTools AskUserQuestion)
fi

# Release the bootstrap lock before handing control to claude.
exec 9>&-

exec claude --dangerously-skip-permissions "${WORKER_TOOL_ARGS[@]}" "$@"
