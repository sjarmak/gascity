#!/usr/bin/env python3
"""Safe close for file-store (.gc/beads.json) beads that have no CLI close path.

The gc file provider has no worker-accessible close command: `gc bd` refuses the
file provider, `bd` targets the dolt store, and `gc runtime drain-ack` only
stops the session — it does not close the workflow. So mol-do-work / mol-ad-hoc
workflow beads (root + steps + work bead) created in .gc/beads.json strand OPEN
after the work is done, and the pool respawns polecats onto the still-open work
bead (city-infra flow-stall, mayor gc-487394). This is the stopgap close path
until gc-source handles file-provider workflow finalize natively.

SAFE against the live supervisor — identical contract to
bin/beads-json-compact-order-tracking.py: LOCK_EX on .gc/beads.json.lock (the
same cross-process flock every FileStore write takes, filestore.go:66/188/212),
backup, atomic tempfile+rename. Mutates the target beads IN PLACE inside the
loaded object, so seq / deps / every other key are preserved byte-for-byte.

Only flips beads currently open/in_progress; already-closed / missing ids are
reported and skipped. Refuses to run without an explicit id list.

Usage:  gc-filestore-close [--apply] [--note "why"] <id> [<id> ...]
        FSCLOSE_APPLY=1 also enables apply. Default = dry-run.
"""
import argparse
import datetime
import fcntl
import json
import os
import shutil
import sys
import tempfile
from pathlib import Path

BEADS = Path("/home/ds/gas-city/.gc/beads.json")
LOCK = Path(str(BEADS) + ".lock")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("ids", nargs="+", help="file-store bead ids to close")
    ap.add_argument("--apply", action="store_true", help="mutate (default dry-run)")
    ap.add_argument("--note", default="", help="close note recorded in metadata")
    args = ap.parse_args()
    apply = args.apply or os.environ.get("FSCLOSE_APPLY", "") == "1"
    targets = set(args.ids)

    now = datetime.datetime.now(datetime.timezone.utc)
    stamp = now.isoformat()

    lock_fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        raw = json.loads(BEADS.read_text())
        key = "issues" if "issues" in raw else "beads"
        items = raw[key]
        index = {b.get("id"): b for b in items}

        to_close, skip = [], []
        for bid in args.ids:
            b = index.get(bid)
            if b is None:
                skip.append((bid, "not found"))
            elif b.get("status") == "closed":
                skip.append((bid, "already closed"))
            elif b.get("status") not in ("open", "in_progress"):
                skip.append((bid, f"unexpected status {b.get('status')!r}"))
            else:
                to_close.append(b)

        for bid, why in skip:
            print(f"  skip {bid}: {why}")
        for b in to_close:
            print(f"  close {b['id']}  ({b.get('status')})  {b.get('title','')[:50]}")
        print(f"close={len(to_close)} skip={len(skip)} apply={apply}")

        if not apply or not to_close:
            return 0

        backup = Path(f"{BEADS}.bak-fsclose-{now.strftime('%Y%m%dT%H%M%SZ')}")
        shutil.copy2(BEADS, backup)
        for b in to_close:
            b["status"] = "closed"
            b["updated_at"] = stamp
            md = b.get("metadata")
            if not isinstance(md, dict):
                md = {}
                b["metadata"] = md
            md["gc.closed_by"] = "city-infra-pl:gc-filestore-close"
            if args.note:
                md["gc.close_note"] = args.note

        with tempfile.NamedTemporaryFile("w", dir=BEADS.parent, delete=False) as tmp:
            json.dump(raw, tmp, indent=2)
            tmp.flush()
            os.fsync(tmp.fileno())
            tmppath = tmp.name
        os.replace(tmppath, BEADS)
        os.chmod(BEADS, 0o644)
        print(f"closed {len(to_close)} beads: backup={backup.name} new_size={BEADS.stat().st_size}")
        return 0
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


if __name__ == "__main__":
    sys.exit(main())
