#!/usr/bin/env python3
"""Stop hook: nudge the mayor to hand off once context passes a threshold.

Fires on every Stop (a natural safe stopping point). If this session is the
mayor and the transcript's latest usage shows context >= MAYOR_HANDOFF_PCT
(default 50) of MAYOR_CTX_WINDOW (default 1,000,000 tokens, Opus 1M), the
hook BLOCKS the stop with instructions to run `gc handoff` now. The handoff
restarts the session fresh, which naturally clears the condition.

Loop safety: when `stop_hook_active` is true (this stop is the continuation
our own block forced), we always allow the stop — one nudge per stop, never
an infinite block loop. Non-mayor sessions in this cwd (e.g. city-infra-pl)
exit immediately.

Installed via /home/ds/gas-city/.claude/settings.json hooks.Stop
(project-level so it follows the mayor across account homes; the mayor is
no longer pinned to one account). Added 2026-07-05 per Stephanie.
"""
import json
import os
import sys

THRESHOLD_PCT = float(os.environ.get("MAYOR_HANDOFF_PCT", "50"))
CTX_WINDOW = int(os.environ.get("MAYOR_CTX_WINDOW", "1000000"))


def main() -> int:
    if os.environ.get("GC_AGENT") != "mayor":
        return 0

    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0  # fail open: never trap a session over a parse error

    if payload.get("stop_hook_active"):
        return 0

    transcript = payload.get("transcript_path", "")
    if not transcript or not os.path.exists(transcript):
        return 0

    # Latest assistant usage = current context occupancy: prompt-side tokens
    # (fresh input + cache reads + cache writes) plus that turn's output.
    usage = None
    try:
        with open(transcript, "r", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or '"usage"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                u = (entry.get("message") or {}).get("usage") or entry.get("usage")
                if isinstance(u, dict) and "input_tokens" in u:
                    usage = u
    except OSError:
        return 0

    if not usage:
        return 0

    context_tokens = (
        (usage.get("input_tokens") or 0)
        + (usage.get("cache_read_input_tokens") or 0)
        + (usage.get("cache_creation_input_tokens") or 0)
        + (usage.get("output_tokens") or 0)
    )
    pct = 100.0 * context_tokens / CTX_WINDOW

    if pct < THRESHOLD_PCT:
        return 0

    print(json.dumps({
        "decision": "block",
        "reason": (
            f"CONTEXT CHECK: this session is at ~{pct:.0f}% of its "
            f"{CTX_WINDOW:,}-token window (>= {THRESHOLD_PCT:.0f}% handoff "
            "threshold). This is a safe stopping point — hand off NOW per "
            "protocol: (1) make sure the running ledger/notes capture "
            "in-flight state, then (2) run:\n"
            '  gc handoff "HANDOFF: <one-line summary>" "<detailed context: '
            "in-flight work, pending Stephanie decisions, next actions, "
            'pointers to ledger files>"\n'
            "The handoff restarts you fresh with the mail as context. Do not "
            "start new work first."
        ),
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
