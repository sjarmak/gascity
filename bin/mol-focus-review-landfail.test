#!/usr/bin/env bash
# RED-proof regression for dr-1ovf: mol-focus-review's land step must leave a
# land-failed, review-passed target in a DISTINGUISHABLE, durable recovery state
# — never a silent drain into an open bead that reads like healthy in-flight work
# (the mem-egxu2 / mem-f0n07 failure). Two linked proofs:
#   A. reproduce the dirty-base / concurrent-main collision and show the ff-only
#      land actually FAILS (the condition that must trigger recovery);
#   B. run the REAL land_fail() extracted from the formula (no copy drift) under
#      mock bd/gc and assert it emits the typed recovery stamp + alert + non-zero
#      exit (so the close never runs).
# The RED direction is inherent: the pre-fix code did a bare `exit 1` here, which
# emits NONE of the stamps B asserts — so B fails against the old formula and
# passes against the fixed one. Runs offline; mock bd/gc never touch the store.
set -uo pipefail

CITY="${GC_CITY_ROOT:-/home/ds/gas-city}"
FORMULA="$CITY/formulas/mol-focus-review.formula.toml"
[ -r "$FORMULA" ] || { echo "FAIL: formula not readable at $FORMULA"; exit 1; }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/mfr-landfail.XXXXXX")
CAP="$WORK/bd-gc-calls.log"
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT

fails=0
note() { echo "  - $*"; fails=$((fails+1)); }

# ---------------------------------------------------------------------------
# A. Reproduce the dirty-base collision: an ff-only land into a base tree whose
#    working copy has an uncommitted edit to a path the incoming commit touches.
# ---------------------------------------------------------------------------
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
base="$WORK/base"
git init -q -b main "$base"
( cd "$base"
  echo v0 > f.txt; git add f.txt; git commit -qm base
  git branch work/dr-TEST
  git switch -q work/dr-TEST
  echo v1 > f.txt; git add f.txt; git commit -qm "impl on work"
  git switch -q main
  # concurrent/dirty base: an uncommitted local edit to the same path
  echo local-uncommitted > f.txt )

if git -C "$base" merge --ff-only work/dr-TEST >/dev/null 2>&1; then
  note "A: ff-only land SUCCEEDED against a dirty base — collision not reproduced"
else
  echo "A OK: ff-only land refused against dirty base (the collision that must trigger recovery)"
fi
# commits must remain on the work branch (nothing landed)
if git -C "$base" merge-base --is-ancestor work/dr-TEST main 2>/dev/null; then
  note "A: work/dr-TEST unexpectedly reachable from main after the failed land"
fi

# ---------------------------------------------------------------------------
# B. Run the REAL land_fail() from the formula under mock bd/gc; assert the stamp.
# ---------------------------------------------------------------------------
awk '/^land_fail\(\) \{/{f=1} f{print} f&&/^}$/{exit}' "$FORMULA" \
  | sed 's/{{issue}}/dr-TEST/g; s/{{base_branch}}/main/g' > "$WORK/landfail.fn"
grep -q 'needs_recovery' "$WORK/landfail.fn" || { echo "FAIL: could not extract land_fail() from formula"; exit 1; }

bd() { echo "bd $*" >> "$CAP"; }
gc() { echo "gc $*" >> "$CAP"; }
# shellcheck disable=SC1090
source "$WORK/landfail.fn"

: > "$CAP"
( land_fail ff_only_collision ); rc=$?

grep -q 'bd update dr-TEST --status blocked'      "$CAP" || note "B: target not set blocked"
grep -q 'gc.outcome=fail'                         "$CAP" || note "B: gc.outcome=fail (root-honored failure contract) not stamped"
grep -q 'gc.failure_reason=land_failed'           "$CAP" || note "B: gc.failure_reason=land_failed distinguisher not stamped"
grep -q 'gc.land_failed_reason=ff_only_collision' "$CAP" || note "B: specific reason not stamped"
grep -q 'gc.needs_recovery=true'                  "$CAP" || note "B: needs_recovery marker (durable) not stamped"
grep -q 'nudge mayor'                             "$CAP" || note "B: durable alert not routed"
[ "$rc" = "1" ]                                          || note "B: land_fail must exit non-zero so the close never runs (got rc=$rc)"

if [ "$fails" -eq 0 ]; then
  echo "PASS: dr-1ovf land_fail regression — collision reproduced, typed recovery state + alert emitted, close blocked."
  exit 0
fi
echo "FAIL: dr-1ovf land_fail regression — $fails assertion(s) failed."
exit 1
