#!/usr/bin/env bash
# stale-worktree-reaper: remove abandoned git worktrees and their branches.
#
# Selection criteria (ALL must hold):
#   - Worktree is registered with git (`git worktree list`)
#   - Worktree is locked (the orchestrator's reach-cleanup phase never ran)
#   - No live process holds an open file in the worktree
#   - Working tree is clean (no uncommitted changes)
#   - HEAD's last commit is older than $STALE_THRESHOLD (default 24h)
#   - Branch tip IS reachable from the rig's default branch (i.e. work merged)
#
# Action: `git worktree unlock` + `git worktree remove --force` + `git branch -D <branch>`.
#
# Default mode is DRY-RUN. Pass --apply to actually clean up.
#
# Companion to stale-claim-reaper. The bead-side reaper unclaims abandoned
# in_progress beads; this one removes the worktree+branch scaffolding the
# same dead workers left behind.
#
# Usage:
#   stale-worktree-reaper                # dry-run report
#   stale-worktree-reaper --apply        # actually clean up
#   stale-worktree-reaper --rig codeprobe # scope to one rig
#   stale-worktree-reaper --threshold 7d # custom threshold
#
# Local fallback for the upstream proposal at gascity gc-1b2 (which
# explicitly punts on worktree cleanup).

set -uo pipefail

CITY="${GC_STORE_ROOT:-/home/ds/gas-city}"
AUDIT_LOG="${STALE_WORKTREE_AUDIT_LOG:-${CITY}/.gc/stale-worktree-reaper.log}"
STALE_THRESHOLD="${STALE_WORKTREE_THRESHOLD:-24h}"
# Shorter threshold for adopt-pr-*/ship-* worktrees (mayor gc-431319): their PR is
# merged/closed (still gated by the merge-into-default check below), so they are
# safe to reap sooner. Base pool members (polecat-N) never match this pattern AND
# are on detached origin/main (skipped as detached-head), so they are untouched.
SHORT_STALE_THRESHOLD="${STALE_WORKTREE_SHORT_THRESHOLD:-6h}"

APPLY=0
NUDGE_MAYOR=0
ONLY_RIG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)         APPLY=1; shift ;;
    --nudge-mayor)   NUDGE_MAYOR=1; shift ;;
    --threshold)     STALE_THRESHOLD="$2"; shift 2 ;;
    --rig)           ONLY_RIG="$2"; shift 2 ;;
    -h|--help)
      sed -n 's/^# \{0,1\}//p' "$0" | head -25
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$(dirname "$AUDIT_LOG")"

threshold_to_seconds() {
  local t="$1" num unit
  num="${t%[a-z]}"
  unit="${t##*[0-9]}"
  case "$unit" in
    s) echo "$num" ;;
    m) echo $((num * 60)) ;;
    h) echo $((num * 3600)) ;;
    d) echo $((num * 86400)) ;;
    *) echo "stale-worktree-reaper: bad threshold '$t'" >&2; exit 2 ;;
  esac
}

# Decide whether a worktree's working-copy state counts as empty/clean and thus
# eligible for reaping. Echoes one of: clean | dirty | unknown.
#
#   - clean   : no uncommitted work; safe to reap (subject to other gates)
#   - dirty   : uncommitted work present; NOT reapable
#   - unknown : the emptiness probe errored or was ambiguous; FAIL CLOSED,
#               i.e. the caller MUST treat this as live (NOT reapable)
#
# Git path (no jj): byte-for-byte the original check — `git status --porcelain`
# line count, where 0 lines == clean.
#
# jj path (only when `jj` is on PATH AND a .jj dir exists in the worktree):
# jj auto-snapshots uncommitted edits into the working-copy commit, so a plain
# `git status` reads clean even with live work. Probe the jj working-copy commit
# instead: reapable only if it is empty AND there are no unpushed changes. Any
# probe error (e.g. `jj log` racing the auto-import) yields "unknown" so the
# caller fails closed. A short retry-with-backoff dodges the transient race.
worktree_emptiness() {
  local wt=$1

  if command -v jj >/dev/null 2>&1 && [[ -d "$wt/.jj" ]]; then
    local attempt out rc
    for attempt in 1 2 3; do
      out=$(jj --repository "$wt" --no-pager --color never log \
              --no-graph -r '@ & empty() & ~description(exact:"")' \
              -T '"x"' 2>/dev/null)
      rc=$?
      if (( rc == 0 )); then
        # The working-copy commit (@) is the empty marker only if it is empty.
        # Separately confirm there are no unpushed (not-on-any-remote) changes.
        local unpushed urc
        unpushed=$(jj --repository "$wt" --no-pager --color never log \
                     --no-graph -r '@ | (remote_bookmarks()..@)' \
                     -T '"x"' 2>/dev/null)
        urc=$?
        if (( urc != 0 )); then
          sleep "0.$((attempt * 2))"
          continue
        fi
        # @ empty (only "x" present from the first probe) AND nothing beyond
        # what is already on a remote (unpushed reduces to just @, i.e. "x").
        if [[ "$out" == "x" && "$unpushed" == "x" ]]; then
          echo clean
        else
          echo dirty
        fi
        return 0
      fi
      sleep "0.$((attempt * 2))"
    done
    # Every attempt errored — fail closed.
    echo unknown
    return 0
  fi

  # Git-only path: identical to the original inline check.
  local n
  n=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l)
  if (( n > 0 )); then
    echo dirty
  else
    echo clean
  fi
  return 0
}

THRESHOLD_SECONDS=$(threshold_to_seconds "$STALE_THRESHOLD")
SHORT_THRESHOLD_SECONDS=$(threshold_to_seconds "$SHORT_STALE_THRESHOLD")
NOW_EPOCH=$(date +%s)
CUTOFF_EPOCH=$((NOW_EPOCH - THRESHOLD_SECONDS))
SHORT_CUTOFF_EPOCH=$((NOW_EPOCH - SHORT_THRESHOLD_SECONDS))

# Per-worktree cutoff: adopt-pr-*/ship-* leaf names reap at the shorter threshold
# (merge-check below still gates), everything else at the default.
wt_cutoff_for() {
  local leaf
  leaf=$(basename "$1")
  if [[ "$leaf" == ship-* || "$leaf" == *adopt-pr* ]]; then
    echo "$SHORT_CUTOFF_EPOCH"
  else
    echo "$CUTOFF_EPOCH"
  fi
}

log_event() {
  local event=$1 rig=$2 wt=$3 extra=${4:-'{}'}
  local ts
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  jq -cn --arg ts "$ts" --arg event "$event" --arg rig "$rig" --arg wt "$wt" \
         --argjson extra "$extra" \
    '{ts:$ts, event:$event, rig:$rig, worktree:$wt} + $extra' \
    >> "$AUDIT_LOG"
}

declare -A RIG_PATHS
while IFS=$'\t' read -r rig path; do
  [[ -n "$path" ]] && RIG_PATHS["$rig"]="$path"
done < <(gc rig list 2>/dev/null | awk '
  /^  [a-zA-Z][a-zA-Z0-9_-]+:/ { name=$1; sub(/:$/,"",name); current=name }
  /^    Path:/ { sub(/^    Path:[ \t]+/,""); print current "\t" $0 }')

# Resolve a rig's default branch. Falls back to "main" if not detectable.
default_branch() {
  local rig_path=$1
  # Prefer the symbolic ref of origin/HEAD if set.
  local sym
  sym=$(git -C "$rig_path" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || true
  if [[ -n "$sym" ]]; then
    echo "${sym##*/}"
    return
  fi
  # Fallback: prefer main, then master.
  if git -C "$rig_path" show-ref --verify --quiet refs/heads/main; then echo "main"; return; fi
  if git -C "$rig_path" show-ref --verify --quiet refs/heads/master; then echo "master"; return; fi
  echo "main"
}

reaped=()        # rig|worktree|branch|reason
skipped=()       # rig|worktree|reason
candidates=0

scan_rig() {
  local rig=$1
  local rig_path=${RIG_PATHS[$rig]:-}
  [[ -n "$rig_path" ]] || return 0
  [[ -d "$rig_path/.git" || -f "$rig_path/.git" ]] || return 0

  local default_br
  default_br=$(default_branch "$rig_path")

  # Walk all worktrees registered in this rig (excluding the primary one).
  while IFS= read -r wt_path; do
    [[ -z "$wt_path" ]] && continue
    # Skip the primary checkout (always the rig path itself).
    [[ "$wt_path" == "$rig_path" ]] && continue
    candidates=$((candidates + 1))

    # Get porcelain-format details.
    local porcelain branch is_locked
    porcelain=$(git -C "$rig_path" worktree list --porcelain 2>/dev/null \
                | awk -v p="$wt_path" 'BEGIN{found=0} /^worktree / {found=($2==p)} found {print}')
    branch=$(awk '/^branch /{sub("refs/heads/",""); print $2; exit}' <<<"$porcelain")
    is_locked=0
    grep -q '^locked' <<<"$porcelain" && is_locked=1

    if (( !is_locked )); then
      log_event "skipped_not_locked" "$rig" "$wt_path" \
        "$(jq -cn --arg b "$branch" '{branch:$b}')"
      skipped+=("$rig|$wt_path|not-locked")
      continue
    fi

    # Live process check — anything holding files open?
    local live_pids
    live_pids=$(lsof +D "$wt_path" 2>/dev/null | tail -n +2 | awk '{print $2}' | sort -u | tr '\n' ',' | sed 's/,$//')
    if [[ -n "$live_pids" ]]; then
      log_event "skipped_live_process" "$rig" "$wt_path" \
        "$(jq -cn --arg p "$live_pids" '{pids:$p}')"
      skipped+=("$rig|$wt_path|live-process")
      continue
    fi

    # Uncommitted / live work? (git-aware by default, jj-aware when applicable)
    local emptiness
    emptiness=$(worktree_emptiness "$wt_path")
    if [[ "$emptiness" == "dirty" ]]; then
      # Preserve the original git-path diagnostic: count of porcelain lines.
      local dirty
      dirty=$(git -C "$wt_path" status --porcelain 2>/dev/null | wc -l)
      log_event "skipped_dirty" "$rig" "$wt_path" \
        "$(jq -cn --arg d "$dirty" '{dirty_files:$d}')"
      skipped+=("$rig|$wt_path|dirty")
      continue
    fi
    if [[ "$emptiness" != "clean" ]]; then
      # FAIL CLOSED: an errored/ambiguous jj probe is treated as live work.
      log_event "skipped_emptiness_unknown" "$rig" "$wt_path" \
        "$(jq -cn --arg p "$emptiness" '{probe:$p}')"
      skipped+=("$rig|$wt_path|emptiness-unknown")
      continue
    fi

    # Last-commit staleness (per-worktree cutoff: adopt-pr-*/ship-* use the shorter one).
    local last_epoch wt_cutoff
    last_epoch=$(git -C "$wt_path" log -1 --format=%ct HEAD 2>/dev/null) || continue
    wt_cutoff=$(wt_cutoff_for "$wt_path")
    if (( last_epoch >= wt_cutoff )); then
      log_event "skipped_recent" "$rig" "$wt_path" \
        "$(jq -cn --arg t "$last_epoch" --arg c "$wt_cutoff" '{last_commit_epoch:$t, cutoff:$c}')"
      skipped+=("$rig|$wt_path|recent-commit")
      continue
    fi

    # Reachability from default branch (only delete if merged).
    if [[ -z "$branch" ]]; then
      log_event "skipped_detached" "$rig" "$wt_path" '{}'
      skipped+=("$rig|$wt_path|detached-head")
      continue
    fi
    local tip
    tip=$(git -C "$rig_path" rev-parse "$branch" 2>/dev/null) || continue
    if ! git -C "$rig_path" merge-base --is-ancestor "$tip" "$default_br" 2>/dev/null; then
      log_event "skipped_unmerged" "$rig" "$wt_path" \
        "$(jq -cn --arg b "$branch" --arg db "$default_br" \
              '{branch:$b, default_branch:$db}')"
      skipped+=("$rig|$wt_path|unmerged-into-$default_br")
      continue
    fi

    reaped+=("$rig|$wt_path|$branch|merged-into-$default_br")
    log_event "stale_worktree_detected" "$rig" "$wt_path" \
      "$(jq -cn --arg b "$branch" --arg db "$default_br" --arg t "$STALE_THRESHOLD" \
            '{branch:$b, default_branch:$db, threshold:$t}')"
  done < <(git -C "$rig_path" worktree list --porcelain 2>/dev/null \
           | awk '/^worktree /{print $2}')
}

# Allow tests to source this script and exercise the decision functions
# without triggering a full scan. (No effect when executed directly.)
if [[ "${STALE_WORKTREE_REAPER_LIB:-0}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

if [[ -n "$ONLY_RIG" ]]; then
  scan_rig "$ONLY_RIG"
else
  for rig in "${!RIG_PATHS[@]}"; do
    scan_rig "$rig"
  done
fi

count=${#reaped[@]}

out=$(mktemp)
trap 'rm -f "$out"' EXIT
{
  echo "stale-worktree-reaper: ${count} stale worktree(s) detected (threshold: $STALE_THRESHOLD, candidates: $candidates, skipped: ${#skipped[@]})"
  if (( count > 0 )); then
    echo
    printf '%-22s %-60s %s\n' RIG WORKTREE BRANCH
    printf '%-22s %-60s %s\n' --- -------- ------
    for row in "${reaped[@]}"; do
      IFS='|' read -r rig wt branch reason <<<"$row"
      printf '%-22s %-60s %s\n' "$rig" "$wt" "$branch"
    done
    echo
    if (( APPLY )); then
      echo "Mode: APPLY (removing worktrees + deleting branches)"
    else
      echo "Mode: DRY-RUN (re-run with --apply to clean up)"
    fi
  fi
} > "$out"

cat "$out"

reaped_ok=0
if (( APPLY )) && (( count > 0 )); then
  for row in "${reaped[@]}"; do
    IFS='|' read -r rig wt branch reason <<<"$row"
    rig_path=${RIG_PATHS[$rig]}
    if git -C "$rig_path" worktree unlock "$wt" 2>/dev/null \
       && git -C "$rig_path" worktree remove --force "$wt" 2>/dev/null \
       && git -C "$rig_path" branch -D "$branch" 2>/dev/null; then
      reaped_ok=$((reaped_ok + 1))
      log_event "stale_worktree_reaped" "$rig" "$wt" \
        "$(jq -cn --arg b "$branch" '{branch:$b}')"
    else
      log_event "reap_failed" "$rig" "$wt" \
        "$(jq -cn --arg b "$branch" '{branch:$b}')"
    fi
  done
  echo
  echo "Reaped $reaped_ok of $count worktree+branch pair(s)."
fi

if (( NUDGE_MAYOR )) && (( count > 0 )); then
  msg="stale-worktree-reaper: $count stale worktree(s) detected
$(cat "$out")

Likely cause: orchestrator process died before reaching its worktree-teardown phase.
Run 'stale-worktree-reaper --apply' to clean up.
Tracking upstream as gascity gc-1b2 (worktree side currently out of scope)."
  gc session nudge mayor "$msg" 2>/dev/null \
    || echo "warn: gc session nudge mayor failed; report still in audit log" >&2
fi

exit 0
