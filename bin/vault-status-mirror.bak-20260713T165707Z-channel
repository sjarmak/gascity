#!/usr/bin/env python3
"""vault-status-mirror: mirror new Obsidian Projects/*.md daily-log entries to Slack.

PLs already write dated status to the Obsidian vault under the standing
VAULT_NOTES directive (template-fragments/pl-periodic-directives). This is the
missing leg: publish each NEW newest-dated `### YYYY-MM-DD` daily-log block to
the gascity channel, once, when it changes.

Idempotent: a per-project sha256 sentinel under ~/.gc/vault-mirror-sentinels/.
First run (sentinel dir absent) SEEDS every sentinel without posting, so it
never backfills months of history into Slack. Read-only on the vault.

Codepoint-safe throughout (Python str slicing), so it cannot reproduce the
`head -c` byte-split that broke overnight-digest.
"""
import os
import re
import sys
import time
import hashlib
import subprocess

VAULT = os.environ.get("VAULT_PROJECTS_DIR", "/home/ds/brain/Projects")
CHANNEL = os.environ.get("VAULT_MIRROR_CHANNEL", "C0B25SS12CD")
SENTINEL_DIR = os.environ.get(
    "VAULT_MIRROR_SENTINELS", os.path.expanduser("~/.gc/vault-mirror-sentinels")
)
AUDIT_LOG = os.environ.get(
    "VAULT_MIRROR_LOG", os.path.expanduser("~/.gc/vault-status-mirror.log")
)
MAXLEN = int(os.environ.get("VAULT_MIRROR_MAXLEN", "3500"))

DATE_HDR = re.compile(r"^###\s+(\d{4}-\d{2}-\d{2})\b", re.M)


def log(msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}\n"
    try:
        with open(AUDIT_LOG, "a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass
    sys.stderr.write(line)


def resolve_publish_sid():
    """Stable session for slack attribution: $GC_SESSION_ID else pinned mayor.

    publish-to-channel attributes to --session; a detached order run has no
    $GC_SESSION_ID and would fail fast without this (the flow-patrol bug)."""
    sid = os.environ.get("GC_SESSION_ID")
    if sid:
        return sid
    try:
        out = subprocess.run(
            ["gc", "session", "list"],
            capture_output=True, text=True, timeout=30,
        ).stdout
    except (subprocess.SubprocessError, OSError):
        return ""
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "mayor" and "pin" in line:
            return parts[0]
    return ""


def parse_note(path):
    """Return (slug, title, date, block) for a project-status note, or None."""
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return None
    fm = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    front = fm.group(1) if fm else ""
    if "project-status" not in front:
        return None
    pm = re.search(r"^project:\s*(.+)$", front, re.M)
    project = pm.group(1).strip() if pm else ""
    tm = re.search(r"^#\s+(.+)$", text, re.M)
    title = tm.group(1).strip() if tm else (project or os.path.basename(path))
    hdrs = list(DATE_HDR.finditer(text))
    if not hdrs:
        return None
    start = hdrs[0].start()
    end = hdrs[1].start() if len(hdrs) > 1 else len(text)
    block = text[start:end].strip()
    date = hdrs[0].group(1)
    slug = re.sub(r"[^A-Za-z0-9]+", "-", (project or title)).strip("-").lower()
    return slug, title, date, block


def publish(title, date, block, sid):
    body = f"*{title}* — status update ({date})\n\n{block}"
    if len(body) > MAXLEN:
        body = body[: MAXLEN - 1].rstrip() + "…"  # codepoint-safe truncation
    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8") as tf:
        tf.write(body)
        tmp = tf.name
    try:
        cmd = ["gc", "slack", "publish-to-channel",
               "--conversation-id", CHANNEL, "--kind", "room"]
        if sid:
            cmd += ["--session", sid]
        cmd += ["--body-file", tmp]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
        return r.returncode == 0
    except (subprocess.SubprocessError, OSError):
        return False
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def main():
    if not os.path.isdir(VAULT):
        log(f"ERROR: vault dir absent: {VAULT}")
        return 1
    seed = not os.path.isdir(SENTINEL_DIR)
    os.makedirs(SENTINEL_DIR, exist_ok=True)
    sid = resolve_publish_sid()

    posted = skipped = seeded = failed = 0
    # Walk nested Projects/<name>/<name>.md layout (2026-07-11 reorg) as well as
    # any flat Projects/*.md still present. parse_note's project-status
    # frontmatter gate is the real filter: arch-review + issues-log pages carry
    # different tags and return None, so only about-pages mirror.
    md_paths = []
    for root, _dirs, files in os.walk(VAULT):
        for name in files:
            if name.endswith(".md"):
                md_paths.append(os.path.join(root, name))
    for path in sorted(md_paths):
        name = os.path.basename(path)
        if name.endswith("Issues Log.md") or name == "Projects Index.md":
            continue
        parsed = parse_note(path)
        if not parsed:
            continue
        slug, title, date, block = parsed
        sha = hashlib.sha256(block.encode("utf-8")).hexdigest()
        sfile = os.path.join(SENTINEL_DIR, f"{slug}.sha")
        prev = ""
        if os.path.exists(sfile):
            try:
                prev = open(sfile, encoding="utf-8").read().strip()
            except OSError:
                prev = ""
        if sha == prev:
            skipped += 1
            continue
        if seed:
            with open(sfile, "w", encoding="utf-8") as fh:
                fh.write(sha)
            seeded += 1
            continue
        if publish(title, date, block, sid):
            with open(sfile, "w", encoding="utf-8") as fh:
                fh.write(sha)
            posted += 1
            log(f"posted {slug} ({date}) to {CHANNEL}")
        else:
            failed += 1
            log(f"ERROR: publish {slug} ({date}) to {CHANNEL} failed")

    if seed:
        log(f"SEED run: seeded {seeded} sentinel(s), posted 0 (first run)")
    else:
        log(f"tick: posted {posted}, skipped {skipped}, failed {failed}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
