#!/usr/bin/env python3
"""mail-dupe-dedupe: keep newest per (recipient, subject, body); archive rest.

Some scheduled escalators (mol-dog-reaper, etc.) fire a body-identical
mail every interval against a backlog condition that won't resolve until
an upstream schema migration. The inbox queues many copies of the same
content. Triage burns time on duplicates that contain zero new info.

This janitor groups open mayor-addressed message beads by
(recipient, subject, sha256(body)) and archives all but the newest in
each group. The newest is left visible so mayor still sees the current
state of the recurring condition (and the count of dups suppressed is
logged).

Env:
  JANITOR_MIN_DUPES   - only act on groups with ≥ this many beads (default 2)
  JANITOR_DRY_RUN     - any non-empty value = list IDs but don't archive
  JANITOR_MAX_BATCH   - chunk size for `gc mail archive` (default 50)
  JANITOR_RECIPIENT   - filter target recipient (default "mayor")
"""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

BEADS_PATH = Path("/home/ds/gas-city/.gc/beads.json")
MIN_DUPES = int(os.environ.get("JANITOR_MIN_DUPES", "2"))
DRY_RUN = bool(os.environ.get("JANITOR_DRY_RUN", "").strip())
MAX_BATCH = int(os.environ.get("JANITOR_MAX_BATCH", "50"))
RECIPIENT = os.environ.get("JANITOR_RECIPIENT", "mayor")


def body_sha(body: str) -> str:
    return hashlib.sha256((body or "").encode("utf-8", errors="ignore")).hexdigest()


def collect_groups() -> dict[tuple[str, str, str], list[dict]]:
    if not BEADS_PATH.exists():
        return {}
    data = json.loads(BEADS_PATH.read_text())
    beads = data.get("beads", []) if isinstance(data, dict) else data
    groups: dict[tuple[str, str, str], list[dict]] = defaultdict(list)
    for b in beads:
        if b.get("status") not in ("open", "in_progress"):
            continue
        if b.get("issue_type") != "message":
            continue
        if b.get("assignee") != RECIPIENT and b.get("owner") != RECIPIENT:
            continue
        subject = b.get("title", "") or ""
        body = b.get("description", "") or ""
        key = (RECIPIENT, subject, body_sha(body))
        groups[key].append(b)
    return groups


def select_archivable(groups: dict) -> list[str]:
    ids: list[str] = []
    for key, beads in groups.items():
        if len(beads) < MIN_DUPES:
            continue
        beads_sorted = sorted(beads, key=lambda b: b.get("created_at", ""))
        for b in beads_sorted[:-1]:
            ids.append(b["id"])
    return ids


def archive_batches(ids: list[str]) -> tuple[int, int]:
    archived = 0
    failed = 0
    for i in range(0, len(ids), MAX_BATCH):
        chunk = ids[i : i + MAX_BATCH]
        result = subprocess.run(
            ["gc", "mail", "archive", *chunk],
            capture_output=True, text=True, timeout=120,
        )
        if result.returncode == 0:
            archived += sum(1 for line in result.stdout.splitlines() if "Archived" in line)
        else:
            failed += len(chunk)
            print(f"batch failed: {result.stderr.strip()[:200]}", file=sys.stderr)
    return archived, failed


def main() -> int:
    groups = collect_groups()
    ids = select_archivable(groups)
    if not ids:
        print(f"mail-dupe-dedupe: 0 duplicates found (min_dupes={MIN_DUPES})")
        return 0
    if DRY_RUN:
        print(f"mail-dupe-dedupe [DRY RUN]: would archive {len(ids)} duplicate(s)")
        sample_groups = [
            (key, beads) for key, beads in groups.items() if len(beads) >= MIN_DUPES
        ]
        for (recipient, subject, _sha), beads in sample_groups[:5]:
            print(f"  group ({len(beads)}× to {recipient}): {subject[:80]}")
        return 0
    archived, failed = archive_batches(ids)
    print(
        f"mail-dupe-dedupe: archived {archived} duplicate(s), {failed} failed "
        f"(groups={sum(1 for _, beads in groups.items() if len(beads) >= MIN_DUPES)})"
    )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
