#!/usr/bin/env bash
# Regression test for gc-sling's city HQ routing behavior (dr-h6ze).
#
# The source bug was fixed upstream by making `gc sling` resolve the selected
# bead store from its authoritative on-disk identity instead of ambient
# GC_BEADS. The floor-local wrapper must therefore remain a pass-through: a
# reintroduced `GC_BEADS=bd` override would hide regressions in the source fix
# and revive the persistent-provider divergence this wrapper must avoid.
#
# Strategy: stub `gc` on PATH and record the provider environment seen by every
# `gc sling` call. The stub models the corrected source behavior: routing is
# authoritative and independent of the ambient provider.
#
# Asserts:
#   1. dr- bead    -> stub `gc sling` sees ambient GC_BEADS=file and routes
#   2. non-dr bead -> stub `gc sling` sees GC_BEADS=file AND result=ROUTED
#                     (ambient provider untouched for every bead)
#   3. dr- bead    -> default --nudge is still injected (existing contract kept)
#   4. dr- bead    -> no stray per-rig worktree is created
#
# dr-vn1i AC1 — authoritative per-rig base ref (resolve_authoritative_base), the
# two-slot RED fixture. Sources the REAL helper (GC_SLING_LIB_ONLY=1 seam, no
# logic copy => no drift) and asserts:
#   5a. TWO SLOTS whose MUTABLE local default branch sits at DIFFERENT commits
#       both resolve to the SAME pinned upstream SHA (the split-base bug).
#   5b. a configured-but-unresolvable ref FAILS CLOSED (rc 3).
#   5c. an unconfigured rig falls through to the default branch (rc 0, fail-open).
#
# Run:  bash /home/ds/gas-city/bin/gc-sling.test

set -uo pipefail

SLING="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/gc-sling"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

TARGET="city-infra-polecat"
SLING_LOG="$WORK/sling.log"
SELECT_LOG="$WORK/select.log"
BD_LOG="$WORK/bd.log"

# --- fixture intercept config: rules:[] exercises the REAL live code path ------
# (empty ruleset => id/title match miss => the terminal `exec ... gc sling`,
# which is exactly the exec the fix patches).
CFG="$WORK/sling-intercept.yaml"
printf 'rules: []\n' > "$CFG"

# --- stub `gc` on PATH --------------------------------------------------------
STUB="$WORK/stubbin"
mkdir -p "$STUB"
cat > "$STUB/gc" <<EOF
#!/usr/bin/env bash
# Minimal gc stub for gc-sling.test. Records sling calls and models corrected
# authoritative store resolution, which is independent of ambient GC_BEADS.
SLING_LOG="$SLING_LOG"
TARGET="$TARGET"
BD_LOG="$BD_LOG"
EOF
cat >> "$STUB/gc" <<'EOF'
sub="${1:-}"; shift || true
case "$sub" in
  session)
    # `gc session list --json` -> one live session for TARGET so the dead-target
    # guard sees a claimant and stays quiet. The session's work_dir defaults to
    # the (non-git) city root path but can be pointed at a real git checkout via
    # STUB_SESSION_WORKDIR, to exercise the worktree guard (assertion 4).
    if [[ "${1:-}" == "list" ]]; then
      wd="${STUB_SESSION_WORKDIR:-/home/ds/gas-city/$TARGET}"
      template="${STUB_SESSION_TEMPLATE:-/home/ds/gas-city/$TARGET}"
      printf '{"sessions":[{"template":"%s","work_dir":"%s","state":"idle"}]}\n' "$template" "$wd"
    fi
    ;;
  rig)
    if [[ "${1:-}" == "list" ]]; then
      if [[ -n "${STUB_RIG_PATH:-}" ]]; then
        printf '{"rigs":[{"name":"gascity","prefix":"gc","path":"%s"}]}\n' "$STUB_RIG_PATH"
      else
        printf '{"rigs":[]}\n'
      fi
    fi
    ;;
  bd)
    if [[ " $* " == *" update "* ]]; then
      printf '%s\n' "$*" >> "$BD_LOG"
      exit 0
    fi
    if [[ -n "${STUB_EXISTING_WORKDIR:-}" ]]; then
      printf '[{"id":"stub","title":"stub bead","metadata":{"work_dir":"%s"}}]\n' "$STUB_EXISTING_WORKDIR"
      exit 0
    fi
    # Title-lookup path. Emit a bead so a title exists; rules:[] means it is
    # never matched, but the call must not error.
    printf '[{"id":"stub","title":"stub bead"}]\n'
    ;;
  sling)
    # bead = the SECOND positional (first is the target, which itself contains
    # dashes — e.g. city-infra-polecat — so a "first token with a dash" scan would
    # wrongly grab the target). Skip values belonging to global flags so the
    # fixture also exercises flags placed before the target.
    bead=""; target=""; pos=0; skip=0
    for a in "$@"; do
      if (( skip )); then skip=0; continue; fi
      case "$a" in
        --rig|--city) skip=1; continue ;;
      esac
      [[ "$a" == -* ]] && continue
      pos=$((pos + 1))
      [[ $pos -eq 1 ]] && target="$a"
      [[ $pos -eq 2 ]] && { bead="$a"; break; }
    done
    gcb="${GC_BEADS:-unset}"
    nudged="no"; for a in "$@"; do [[ "$a" == "--nudge" ]] && nudged="yes"; done
    printf 'ROUTED target=%s bead=%s GC_BEADS=%s nudge=%s args=%s\n' "$target" "$bead" "$gcb" "$nudged" "$*" >> "$SLING_LOG"
    exit 0
    ;;
esac
exit 0
EOF
chmod +x "$STUB/gc"

# Fixed selector result for wrapper plumbing. Pure selection behavior is tested
# in test_gc_harness_select.py; this fixture proves gc-sling consumes the JSON,
# records it, strips wrapper-only flags, and routes to the selected target.
cat > "$STUB/gc-harness-select" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SELECT_LOG"
cat <<'JSON'
{"ok":true,"target":"gascity/codex-2","provider":"codex-2","family":"openai","role":"implementation","reason":"fixture","independent_review":false,"evidence":{"rig":"gascity","selected_at":"2026-07-23T02:00:00+00:00"}}
JSON
EOF
chmod +x "$STUB/gc-harness-select"

run_sling() { # run_sling <bead>
  PATH="$STUB:$PATH" \
  GC_BEADS=file \
  GC_SLING_NO_WORKTREE=1 \
  GC_SLING_INTERCEPT_CONFIG="$CFG" \
  GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
    bash "$SLING" "$TARGET" "$1" >/dev/null 2>&1
}

# run_sling_wt <bead> <session-workdir> : worktree guard ENABLED (no
# GC_SLING_NO_WORKTREE), with the target session rooted at a real git checkout.
run_sling_wt() {
  PATH="$STUB:$PATH" \
  GC_BEADS=file \
  STUB_SESSION_WORKDIR="$2" \
  GC_SLING_INTERCEPT_CONFIG="$CFG" \
  GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
    bash "$SLING" "$TARGET" "$1" >/dev/null 2>&1
}

run_auto_sling() {
  PATH="$STUB:$PATH" \
  GC_BEADS=file \
  GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
  GC_HARNESS_LOCK="$WORK/harness.lock" \
  GC_SLING_NO_WORKTREE=1 \
  GC_SLING_INTERCEPT_CONFIG="$CFG" \
  GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
    bash "$SLING" auto "$1" --harness-role implementation \
      --implementation-family codex >/dev/null 2>&1
}

run_auto_sling_wt() {
  PATH="$STUB:$PATH" \
  GC_BEADS=file \
  GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
  GC_HARNESS_LOCK="$WORK/harness.lock" \
  STUB_RIG_PATH="$2" \
  GC_SLING_BASE_REFS_CONF="$WORK/empty-base-refs.conf" \
  GC_SLING_INTERCEPT_CONFIG="$CFG" \
  GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
    bash "$SLING" auto "$1" --harness-role implementation >/dev/null 2>&1
}

fail() { echo "FAIL: $1" >&2; echo "  sling.log:"; sed 's/^/    /' "$SLING_LOG" 2>/dev/null >&2; exit 1; }

# --- assertion 1: dr- bead keeps ambient provider; source resolves the store ----
: > "$SLING_LOG"
run_sling "dr-80uo"
line=$(grep 'bead=dr-80uo' "$SLING_LOG" 2>/dev/null | head -1)
[[ -n "$line" ]] || fail "no sling recorded for dr-80uo"
[[ "$line" == ROUTED* ]] || fail "dr- bead did not route: $line"
[[ "$line" == *"GC_BEADS=file"* ]] || fail "dr- sling overrode ambient provider: $line"

# --- assertion 2: non-dr bead keeps the ambient provider (no over-broadening) --
: > "$SLING_LOG"
run_sling "gc-abc12"
line=$(grep 'bead=gc-abc12' "$SLING_LOG" 2>/dev/null | head -1)
[[ -n "$line" ]] || fail "no sling recorded for gc-abc12"
[[ "$line" == ROUTED* ]] || fail "non-dr bead did not route: $line"
[[ "$line" == *"GC_BEADS=file"* ]] || fail "non-dr sling had provider overridden (over-broad): $line"

# --- assertion 3: dr- bead still gets the default --nudge injection ------------
: > "$SLING_LOG"
run_sling "dr-80uo"
line=$(grep 'bead=dr-80uo' "$SLING_LOG" 2>/dev/null | head -1)
[[ "$line" == *"nudge=yes"* ]] || fail "dr- sling lost default --nudge injection: $line"

# --- assertion 4: worktree guard cuts NO stray worktree for a dr- bead --------
# The guard runs before the store fix and, absent the dr- short-circuit, would
# resolve rig "dr" (not a real rig), silently no-op its metadata writes, and —
# when the target session sits inside a real rig checkout — cut a stray per-bead
# worktree under THAT repo for a city-HQ tracking bead (code-reviewer, dr-h6ze).
# Set up a real git checkout as the session work_dir, run with the guard ENABLED,
# and assert (a) the bead still routes via the bd store and (b) no
# <repo>-<beadshort> worktree was created.
GITREPO="$WORK/rigcheckout"
git init -q -b main "$GITREPO"
git -C "$GITREPO" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init
: > "$SLING_LOG"
run_sling_wt "dr-80uo" "$GITREPO"
line=$(grep 'bead=dr-80uo' "$SLING_LOG" 2>/dev/null | head -1)
[[ "$line" == ROUTED*"GC_BEADS=file"* ]] || fail "dr- sling broke or overrode provider with worktree guard enabled: $line"
[[ ! -e "${GITREPO}-80uo" ]] || fail "stray worktree cut for dr- bead under rig checkout: ${GITREPO}-80uo"
[[ -z "$(git -C "$GITREPO" worktree list --porcelain 2>/dev/null | grep -F '80uo')" ]] \
  || fail "dr- bead registered a worktree in the rig checkout"

# --- dr-vn1i AC1: authoritative per-rig base ref (resolve_authoritative_base) --
# The two-slot RED fixture. A worktree cut from a MUTABLE local branch drifts as
# that branch moves; the authoritative base must stay pinned to the resolved
# remote-tracking SHA regardless. We test the REAL helper (sourced via the
# GC_SLING_LIB_ONLY seam) so the fixture can never drift from shipped logic.

# rab <rig> <toplevel> <default_branch> -> echoes "<rc>\t<stdout>" of the real helper.
# The helper runs in a bash -c subshell (source sets `set -euo pipefail`, isolated
# from this file's `set -uo pipefail`); rc 3 (fail-closed) is captured via `|| _rc`.
rab() {
  local _rc=0 _out
  _out=$(GC_SLING_LIB_ONLY=1 GC_SLING_BASE_REFS_CONF="$BRC" \
         bash -c 'source "$0"; resolve_authoritative_base "$1" "$2" "$3"' \
         "$SLING" "$1" "$2" "$3" 2>/dev/null) || _rc=$?
  printf '%s\t%s' "$_rc" "$_out"
}

# Canonical "upstream" with two commits — the authoritative base.
UP="$WORK/upstream"
git init -q -b main "$UP"
git -C "$UP" -c user.email=t@t -c user.name=t commit -q --allow-empty -m up1
git -C "$UP" -c user.email=t@t -c user.name=t commit -q --allow-empty -m up2
UP_SHA=$(git -C "$UP" rev-parse HEAD)

# Two pool slots: independent clones with an 'upstream' remote pointing at UP.
SLOT1="$WORK/slot1"; SLOT2="$WORK/slot2"
for s in "$SLOT1" "$SLOT2"; do
  git clone -q "$UP" "$s"
  git -C "$s" remote rename origin upstream
  git -C "$s" fetch -q upstream
done
# Drive each slot's MUTABLE local main to a DIFFERENT commit (the split-base bug:
# identical dispatches would otherwise start from whatever the local branch holds).
git -C "$SLOT1" -c user.email=t@t -c user.name=t commit -q --allow-empty -m slot1-drift
git -C "$SLOT2" -c user.email=t@t -c user.name=t commit -q --allow-empty -m slot2-a
git -C "$SLOT2" -c user.email=t@t -c user.name=t commit -q --allow-empty -m slot2-b
[[ "$(git -C "$SLOT1" rev-parse main)" != "$(git -C "$SLOT2" rev-parse main)" ]] \
  || fail "AC1 setup: the two slots' local mains should differ"

BRC="$WORK/base.conf"

# --- assertion 5a: two divergent slots resolve to the SAME pinned upstream SHA -
printf 'testrig upstream/main\n' > "$BRC"
r1=$(rab testrig "$SLOT1" main); rc1="${r1%%$'\t'*}"; out1="${r1#*$'\t'}"
r2=$(rab testrig "$SLOT2" main); rc2="${r2%%$'\t'*}"; out2="${r2#*$'\t'}"
[[ "$rc1" == 0 && "$rc2" == 0 ]] || fail "AC1a: authoritative resolve returned nonzero (rc1=$rc1 rc2=$rc2)"
sha1=$(awk '{print $3}' <<<"$out1"); sha2=$(awk '{print $3}' <<<"$out2")
committish1=$(awk '{print $1}' <<<"$out1"); ref1=$(awk '{print $2}' <<<"$out1")
[[ "$sha1" == "$UP_SHA" && "$sha2" == "$UP_SHA" ]] \
  || fail "AC1a: slots did not pin to upstream SHA (sha1=$sha1 sha2=$sha2 want=$UP_SHA)"
[[ "$sha1" == "$sha2" ]] || fail "AC1a: two slots resolved DIFFERENT base SHAs ($sha1 vs $sha2) — split-base bug"
[[ "$committish1" == "$UP_SHA" ]] || fail "AC1a: worktree committish is not the pinned SHA (got '$committish1')"
[[ "$ref1" == "upstream/main" ]] || fail "AC1a: recorded base ref is not the authoritative ref (got '$ref1')"

# --- assertion 5b: configured-but-unresolvable ref FAILS CLOSED (rc 3) ---------
printf 'testrig upstream/does-not-exist\n' > "$BRC"
rb=$(rab testrig "$SLOT1" main); rcb="${rb%%$'\t'*}"
[[ "$rcb" == 3 ]] || fail "AC1b: unresolvable configured base did not fail closed (rc=$rcb, want 3)"

# --- assertion 5c: unconfigured rig falls through to default branch (rc 0) -----
printf 'testrig upstream/main\n' > "$BRC"   # entry exists for testrig, NOT otherrig
rc=$(rab otherrig "$SLOT1" main); rcc="${rc%%$'\t'*}"; outc="${rc#*$'\t'}"
[[ "$rcc" == 0 ]] || fail "AC1c: unconfigured rig did not fall through (rc=$rcc)"
[[ "$(awk '{print $1}' <<<"$outc")" == "main" ]] \
  || fail "AC1c: unconfigured rig base is not the default branch (got '$outc')"

# --- assertion 6: role-based auto target selects, records, and routes --------
: > "$SLING_LOG"; : > "$SELECT_LOG"; : > "$BD_LOG"
run_auto_sling "gc-abc12"
line=$(grep 'bead=gc-abc12' "$SLING_LOG" 2>/dev/null | head -1)
[[ "$line" == *"target=gascity/codex-2"* ]] \
  || fail "auto sling did not route to selector target: $line"
[[ "$line" != *"--harness-role"* && "$line" != *"--implementation-family"* ]] \
  || fail "wrapper-only harness flags leaked into gc sling: $line"
grep -q '^implementation --bead gc-abc12 --implementation-family codex --json$' "$SELECT_LOG" \
  || fail "selector did not receive role/bead/family: $(cat "$SELECT_LOG")"
grep -q -- '--set-metadata gc.harness_provider=codex-2' "$BD_LOG" \
  || fail "selection provider was not recorded on bead: $(cat "$BD_LOG")"
grep -q -- '--set-metadata gc.harness_selection=' "$BD_LOG" \
  || fail "selection evidence JSON was not recorded on bead: $(cat "$BD_LOG")"
grep -q -- '--set-metadata gc.harness_independent_review=false' "$BD_LOG" \
  || fail "false review-independence result was not preserved: $(cat "$BD_LOG")"

# --- assertion 6b: flags before auto keep their positions --------------------
: > "$SLING_LOG"
PATH="$STUB:$PATH" \
GC_BEADS=file \
GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
GC_HARNESS_LOCK="$WORK/harness.lock" \
GC_SLING_NO_WORKTREE=1 \
GC_SLING_INTERCEPT_CONFIG="$CFG" \
GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
  bash "$SLING" --rig gascity auto gc-abc12 --harness-role implementation >/dev/null 2>&1
line=$(grep 'bead=gc-abc12' "$SLING_LOG" 2>/dev/null | head -1)
[[ "$line" == *"target=gascity/codex-2"*"args=--rig gascity gascity/codex-2 gc-abc12"* ]] \
  || fail "flag before auto corrupted forwarded arguments: $line"

# --- assertion 7: cold implicit auto target still gets an isolated worktree ---
# The session fixture belongs to TARGET, not the selector's gascity/codex-2
# target. Auto routing must therefore fall back to the bead rig's repository
# instead of skipping isolation merely because the on-demand agent is cold.
: > "$BD_LOG"
: > "$WORK/empty-base-refs.conf"
run_auto_sling_wt "gc-abc13" "$GITREPO"
[[ -d "${GITREPO}-abc13" ]] \
  || fail "cold implicit auto target did not get a per-bead worktree from its rig path"
grep -q -- "--set-metadata work_dir=${GITREPO}-abc13" "$BD_LOG" \
  || fail "cold implicit target worktree was not recorded on bead: $(cat "$BD_LOG")"

# --- assertion 8: auto target fails closed when isolation cannot be resolved --
: > "$SLING_LOG"
if PATH="$STUB:$PATH" \
   GC_BEADS=file \
   GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
   GC_HARNESS_LOCK="$WORK/harness.lock" \
   GC_SLING_BASE_REFS_CONF="$WORK/empty-base-refs.conf" \
   GC_SLING_INTERCEPT_CONFIG="$CFG" \
   GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
     bash "$SLING" auto gc-abc14 --harness-role implementation >/dev/null 2>&1; then
  fail "auto dispatch succeeded without a live work_dir or resolvable rig path"
fi
[[ -z "$(cat "$SLING_LOG")" ]] \
  || fail "failed isolation still reached gc sling: $(cat "$SLING_LOG")"

# --- assertion 9: shared checkout metadata does not count as isolation --------
: > "$SLING_LOG"
if PATH="$STUB:$PATH" \
   GC_BEADS=file \
   GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
   GC_HARNESS_LOCK="$WORK/harness.lock" \
   STUB_RIG_PATH="$GITREPO" \
   STUB_EXISTING_WORKDIR="$GITREPO" \
   GC_SLING_BASE_REFS_CONF="$WORK/empty-base-refs.conf" \
   GC_SLING_INTERCEPT_CONFIG="$CFG" \
   GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
     bash "$SLING" auto gc-abc16 --harness-role implementation >/dev/null 2>&1; then
  fail "auto dispatch accepted the shared rig checkout as bead isolation"
fi
[[ -z "$(cat "$SLING_LOG")" ]] \
  || fail "shared-checkout isolation failure still reached gc sling: $(cat "$SLING_LOG")"

# --- assertion 10: cold explicit target preserves best-effort behavior --------
: > "$SLING_LOG"
PATH="$STUB:$PATH" \
GC_BEADS=file \
STUB_RIG_PATH="$GITREPO" \
GC_SLING_BASE_REFS_CONF="$WORK/empty-base-refs.conf" \
GC_SLING_INTERCEPT_CONFIG="$CFG" \
GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
  bash "$SLING" cold-pool gc-abc17 >/dev/null 2>&1
line=$(grep 'bead=gc-abc17' "$SLING_LOG" 2>/dev/null | head -1)
[[ "$line" == *"target=cold-pool"* ]] \
  || fail "cold explicit target no longer preserves pass-through behavior: $line"
[[ ! -e "${GITREPO}-abc17" ]] \
  || fail "cold explicit target unexpectedly used the auto-only rig fallback"

# --- assertion 11: remote-city globals are parsed then explicitly refused -----
: > "$SLING_LOG"
remote_err="$WORK/remote.err"
if PATH="$STUB:$PATH" \
   GC_BEADS=file \
   GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
   GC_HARNESS_LOCK="$WORK/harness.lock" \
     bash "$SLING" --context other-city auto gc-abc18 \
       --harness-role implementation >/dev/null 2>"$remote_err"; then
  fail "auto routing unexpectedly accepted a remote city context"
fi
grep -q 'limited to the current local city' "$remote_err" \
  || fail "remote city refusal was misparsed as a positional target: $(cat "$remote_err")"
[[ -z "$(cat "$SLING_LOG")" ]] \
  || fail "remote-city refusal still reached gc sling: $(cat "$SLING_LOG")"

# --- assertion 12: sibling provider sessions cannot redirect the auto repo ----
OTHERREPO="$WORK/other-repo"
git init -q -b main "$OTHERREPO"
git -C "$OTHERREPO" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init
: > "$SLING_LOG"; : > "$BD_LOG"
PATH="$STUB:$PATH" \
GC_BEADS=file \
GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
GC_HARNESS_LOCK="$WORK/harness.lock" \
STUB_RIG_PATH="$GITREPO" \
STUB_SESSION_TEMPLATE="codex" \
STUB_SESSION_WORKDIR="$OTHERREPO" \
GC_SLING_BASE_REFS_CONF="$WORK/empty-base-refs.conf" \
GC_SLING_INTERCEPT_CONFIG="$CFG" \
GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
  bash "$SLING" auto gc-abc19 --harness-role implementation >/dev/null 2>&1
[[ -d "${GITREPO}-abc19" ]] \
  || fail "auto target did not use the selected bead rig repository"
[[ ! -e "${OTHERREPO}-abc19" ]] \
  || fail "codex-2 auto target collided with a codex session repository"

# --- assertion 13: core dry-run has no wrapper write/worktree side effects ----
: > "$SLING_LOG"; : > "$BD_LOG"
PATH="$STUB:$PATH" \
GC_BEADS=file \
GC_HARNESS_SELECTOR="$STUB/gc-harness-select" \
GC_HARNESS_LOCK="$WORK/harness.lock" \
STUB_RIG_PATH="$GITREPO" \
GC_SLING_BASE_REFS_CONF="$WORK/empty-base-refs.conf" \
GC_SLING_INTERCEPT_CONFIG="$CFG" \
GC_SLING_INTERCEPT_LOG="$WORK/intercept.log" \
  bash "$SLING" auto gc-abc20 --harness-role implementation --dry-run >/dev/null 2>&1
line=$(grep 'bead=gc-abc20' "$SLING_LOG" 2>/dev/null | head -1)
[[ "$line" == *"--dry-run"* ]] || fail "auto dry-run did not reach core dry-run: $line"
[[ ! -s "$BD_LOG" ]] || fail "auto dry-run wrote bead metadata: $(cat "$BD_LOG")"
[[ ! -e "${GITREPO}-abc20" ]] || fail "auto dry-run created a worktree"

echo "PASS: provider/nudge/worktree contracts hold; authoritative bases are pinned; role-based auto routing selects under lock, preserves flags/evidence, dry-run, and explicit targets, isolates cold implicit targets to the bead rig, rejects shared checkouts/remote contexts, fails closed without isolation, and dispatches"
