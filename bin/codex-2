#!/usr/bin/env bash
# codex-2 — launch the isolated secondary Codex account with unattended permissions.

set -euo pipefail

export CODEX_HOME="$HOME/.codex-homes/codex-2"
[[ -d "$CODEX_HOME" ]] \
  || {
    printf 'codex-2: account home is missing: %s\n' "$CODEX_HOME" >&2
    exit 1
  }
CODEX_BIN="${CODEX_CLI_BIN:-$HOME/.nvm/versions/node/v22.22.2/bin/codex}"
[[ -x "$CODEX_BIN" ]] \
  || {
    printf 'codex-2: Codex executable is missing: %s\n' "$CODEX_BIN" >&2
    exit 1
  }
exec "$CODEX_BIN" --yolo "$@"
