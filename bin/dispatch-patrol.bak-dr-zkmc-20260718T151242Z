#!/usr/bin/env bash
# dispatch-patrol: keep work ROUTING across rigs; auto-nudge PLs, escalate stuck.
#
# The routing-assurance monitor (Stephanie 2026-06-08). Complements:
#   flow-patrol  (2x/day digest — is work flowing)
#   stall-watch  (15m breakage push — in-progress stalls / capacity / sessions)
# This one closes the gap both miss: a rig with a READY backlog sitting
# UNDISPATCHED (open, non-rollup/epic, no assignee + no gc.routed_to) while its
# worker pool is idle. Each run it auto-nudges that rig's PL to route the
# backlog; if the backlog persists across cycles (PL not dispatching) or a rig
# has backlog but no live PL, it ESCALATES to #all-agent-city — the human's
# "surface as needed" signal.
#
# Skips gascity (gated PR work — never blind-drained). mem gets a paced nudge
# (epic sequence — order matters), not a drain.
#
# Usage:
#   dispatch-patrol           # dry-run: print planned nudges + escalations
#   dispatch-patrol --push    # live: nudge PLs + post escalations
# Env:
#   DISPATCH_PATROL_CHANNEL    escalation channel (default C0B0TQMQF2B all-agent-city)
#   DISPATCH_BACKLOG_MIN       min actionable backlog to act on (default 3)
#   DISPATCH_NUDGE_COOLDOWN_H  hours between PL nudges for a rig (default 1)
#   DISPATCH_ESCALATE_CYCLES   non-shrinking cycles before escalating (default 3)

set -uo pipefail
CITY=/home/ds/gas-city
CHANNEL="${DISPATCH_PATROL_CHANNEL:-C0B0TQMQF2B}"
STATE="${DISPATCH_PATROL_STATE:-$CITY/.gc/dispatch-patrol-state.json}"
AUDIT_LOG="${DISPATCH_PATROL_AUDIT_LOG:-$CITY/.gc/dispatch-patrol.log}"
BACKLOG_MIN="${DISPATCH_BACKLOG_MIN:-3}"
NUDGE_COOLDOWN_H="${DISPATCH_NUDGE_COOLDOWN_H:-1}"
ESCALATE_CYCLES="${DISPATCH_ESCALATE_CYCLES:-3}"
SKIP_RIGS="${DISPATCH_SKIP_RIGS:-gascity codeprobe}"   # space-separated; gascity=gated PR work; codeprobe=dep-gated behind 1f8m (false-positive loop, see readiness-fix TODO)
PACE_RIGS="${DISPATCH_PACE_RIGS:-mem}"        # nudge "next in sequence", not drain
PUSH=0
while [[ $# -gt 0 ]]; do case "$1" in
  --push) PUSH=1; shift;; -h|--help) sed -n 's/^# \{0,1\}//p' "$0"|head -26; exit 0;;
  *) echo "unknown arg: $1">&2; exit 2;; esac; done

NOW=$(date +%s)
mapfile -t RIGS < <(gc rig list 2>/dev/null | awk '
  /^  [a-zA-Z][a-zA-Z0-9_-]+/ { s=0; for(i=1;i<=NF;i++) if($i~/suspend/)s=1; if(s)next;
    n=$1; sub(/:$/,"",n); if(n!="ds-research") print n }')

# Per rig: actionable undispatched backlog (open, no assignee, no route, and not a
# structural non-dispatchable). dr-vqlmu: the rollup/epic exclusion was LABEL-only,
# so epic/convoy/rollup-TYPED beads without the matching label leaked in (scix was
# the worst — 5 of 6). Exclude by issue_type too, plus a deferral/decision label set
# (the ZFC-correct 'not dispatchable' marker; keyword-scanning titles would violate ZFC).
backlog_for() {
  gc bd --rig "$1" list --status=open --json --limit=0 2>/dev/null \
    | jq '[ .[] | select(
            ((.assignee // "")=="") and ((.metadata."gc.routed_to" // "")=="")
            and ((.labels//[]) | (index("rollup") or index("epic")) | not)
            and ((.issue_type | IN("epic","convoy","rollup")) | not)
            and (((.labels//[]) - ["needs-decision","needs-human","deferred","icebox","gated","blocked-external"]) == (.labels//[]))
          ) ] | length' 2>/dev/null || echo 0
}

TSV=$(mktemp); trap 'rm -f "$TSV" "$STATE.candidate" "$ESC_MSG"' EXIT
for r in "${RIGS[@]}"; do
  skip=0; for s in $SKIP_RIGS; do [[ "$r" == "$s" ]] && skip=1; done; (( skip )) && continue
  b=$(backlog_for "$r")
  paced=0; for p in $PACE_RIGS; do [[ "$r" == "$p" ]] && paced=1; done
  # PL liveness: is <rig>-pl a live session?
  pl_live=0; gc session list 2>/dev/null | grep -q "${r}-pl" && pl_live=1
  printf '%s\t%s\t%s\t%s\n' "$r" "$b" "$paced" "$pl_live" >> "$TSV"
done

ESC_MSG=$(mktemp)
NOW="$NOW" BACKLOG_MIN="$BACKLOG_MIN" COOLDOWN_H="$NUDGE_COOLDOWN_H" ESC_CYCLES="$ESCALATE_CYCLES" \
  STATE="$STATE" TSV="$TSV" ESC_MSG="$ESC_MSG" python3 - <<'PYEOF'
import json, os
now=int(os.environ["NOW"]); bmin=int(os.environ["BACKLOG_MIN"])
cooldown=int(os.environ["COOLDOWN_H"])*3600; esc_cycles=int(os.environ["ESC_CYCLES"])
state_path=os.environ["STATE"]
rows=[l.split("\t") for l in open(os.environ["TSV"]).read().splitlines() if l.strip()]
try: old=json.load(open(state_path))
except (FileNotFoundError, json.JSONDecodeError): old={}
new={}; nudges=[]; escalations=[]
for rig,b,paced,pl_live in rows:
    b=int(b); paced=paced=="1"; pl_live=pl_live=="1"
    if b < bmin:
        continue  # resolved/under threshold -> drop from state
    prev=old.get(rig,{})
    last_b=prev.get("last_backlog",0); last_nudged=prev.get("last_nudged",0)
    stuck=prev.get("stuck_cycles",0); escalated=prev.get("escalated",False)
    # "unhealthy" = backlog not draining OR no live PL to route it. Both must
    # persist across cycles before escalating, so a transient PL restart or a
    # single slow cycle doesn't spam the channel.
    unhealthy = (not pl_live) or (b >= last_b)
    stuck = stuck+1 if unhealthy else 0
    rec={"last_backlog":b,"last_nudged":last_nudged,"stuck_cycles":stuck,"escalated":escalated}
    # nudge PL (cooldown-gated) only if a live PL exists
    if pl_live and now-last_nudged>=cooldown:
        nudges.append((rig,b,paced)); rec["last_nudged"]=now
    # escalate only after sustained unhealth
    if stuck>=esc_cycles and not escalated:
        reason = "no live PL" if not pl_live else f"backlog not shrinking ({stuck} cycles)"
        escalations.append((rig,b,reason)); rec["escalated"]=True
    if b < last_b*0.5:   # meaningful drain -> reset escalation latch
        rec["escalated"]=False
    new[rig]=rec
json.dump(new, open(state_path+".candidate","w"), indent=2)
with open("/tmp/dp-nudges.json","w") as f: json.dump(nudges,f)
if escalations:
    lines=[":triangular_flag_on_post: *Dispatch backlog needs attention:*"]
    for rig,b,reason in escalations:
        lines.append(f"• `{rig}` — {b} ready beads undispatched — {reason}")
    open(os.environ["ESC_MSG"],"w").write("\n".join(lines)+"\n")
else:
    open(os.environ["ESC_MSG"],"w").close()
PYEOF

ts(){ date '+%Y-%m-%dT%H:%M:%S%z'; }
# Resolve a stable session for slack attribution: prefer $GC_SESSION_ID
# (interactive), else the pinned mayor. Detached order runs have no
# $GC_SESSION_ID, so publish would otherwise fail fast (same bug as flow-patrol).
resolve_publish_sid() {
  if [[ -n "${GC_SESSION_ID:-}" ]]; then
    printf '%s' "$GC_SESSION_ID"; return 0
  fi
  gc session list 2>/dev/null | awk '$2=="mayor" && /pin/{print $1; exit}'
}
PUBLISH_SID="$(resolve_publish_sid)"
mapfile -t NUDGES < <(python3 -c 'import json;[print("\t".join([r[0],str(r[1]),"1" if r[2] else "0"])) for r in json.load(open("/tmp/dp-nudges.json"))]' 2>/dev/null)
rm -f /tmp/dp-nudges.json

if (( ! PUSH )); then
  echo "=== dispatch-patrol DRY-RUN ==="
  echo "-- would nudge PLs --"; printf '%s\n' "${NUDGES[@]:-（none）}"
  echo "-- would escalate to $CHANNEL --"; [[ -s "$ESC_MSG" ]] && cat "$ESC_MSG" || echo "(none)"
  echo "-- state NOT modified --"
  exit 0
fi

for row in "${NUDGES[@]:-}"; do
  [[ -z "$row" ]] && continue
  IFS=$'\t' read -r rig b paced <<<"$row"
  if [[ "$paced" == "1" ]]; then
    msg="DISPATCH (paced): $b ready beads undispatched and your pool has capacity. Dispatch the NEXT in-sequence ready beads to your worker pool with --nudge — don't blind-drain (order matters). Reply with count dispatched."
  else
    msg="DISPATCH: $b ready beads sitting undispatched while your worker pool is idle. Triage and sling your ready/completable beads to your pool with --nudge now (skip blocked/needs-human/design-only). Keep the pool fed. Reply with count dispatched."
  fi
  gc session nudge "${rig}-pl" "$msg" >/dev/null 2>&1 && echo "$(ts) nudged ${rig}-pl (backlog $b)" >> "$AUDIT_LOG"
done

if [[ -s "$ESC_MSG" ]]; then
  if gc slack publish-to-channel --conversation-id "$CHANNEL" --kind room ${PUBLISH_SID:+--session "$PUBLISH_SID"} --body-file "$ESC_MSG" >/dev/null 2>&1; then
    echo "$(ts) escalated $(grep -c '^•' "$ESC_MSG") rig(s) to $CHANNEL" >> "$AUDIT_LOG"
  else
    echo "$(ts) ERROR: escalation publish to $CHANNEL failed" >> "$AUDIT_LOG"
  fi
fi
mv -f "$STATE.candidate" "$STATE"
exit 0
