#!/usr/bin/env bash
# gc-sling: thin wrapper around `gc sling` that auto-injects `--on <formula>`
# when the bead ID matches a rule in .gc/sling-intercept.yaml.
#
# Default-safe: if no rule matches, or the caller has already specified
# --on / --formula / --no-formula, this is a pure pass-through.
#
# Use this instead of raw `gc sling` for any dispatch where a bead prefix
# implies a specific review/evidence formula (e.g. codeprobe-br7).
#
# Adoption is by convention — CLAUDE.md documents which dispatches should
# use gc-sling. The log at .gc/sling-intercept.log records every decision,
# so mayor-pattern-miner can surface how often the intercept fires.
#
# Usage: gc-sling [target] <bead-or-formula-or-text> [flags...]
# Flags: exactly the same as `gc sling`. Run `gc sling --help` for details.

set -euo pipefail

CONFIG="${GC_SLING_INTERCEPT_CONFIG:-/home/ds/gas-city/.gc/sling-intercept.yaml}"
LOG="${GC_SLING_INTERCEPT_LOG:-/home/ds/gas-city/.gc/sling-intercept.log}"
HARNESS_SELECTOR="${GC_HARNESS_SELECTOR:-/home/ds/gas-city/bin/gc-harness-select}"
HARNESS_LOCK="${GC_HARNESS_LOCK:-/home/ds/gas-city/.gc/harness-select.lock}"

log_event() {
  # log_event <event> <bead> <target> <formula> <reason>
  local ts event bead target formula reason
  # UTC Z-form so jq fromdateiso8601 can parse (local offsets silently break it).
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  event=$1; bead=$2; target=$3; formula=$4; reason=$5
  [[ -d "${LOG%/*}" ]] || return 0
  jq -cn --arg ts "$ts" \
         --arg event "$event" \
         --arg bead "$bead" \
         --arg target "$target" \
         --arg formula "$formula" \
         --arg reason "$reason" \
    '{ts:$ts, event:$event, bead:$bead, target:$target, formula:$formula, reason:$reason}' \
    >> "$LOG" 2>/dev/null || true
}

# dr-vn1i: resolve the AUTHORITATIVE base a per-bead worktree must be cut from.
# A worktree created from a MUTABLE local branch inherits whatever that branch
# happens to point at — for gascity-packs, local main is a fork 40 commits behind
# canonical, so identical dispatches silently start from different bases and can
# reintroduce deleted code. If the rig has an entry in .gc/sling-base-refs.conf,
# fetch + resolve the exact remote-tracking SHA and return THAT (immutable across
# local-branch movement). If a base is CONFIGURED but cannot be resolved, return 3
# so the caller fails closed rather than cut a wrong-base worktree. Rigs with NO
# entry return the default branch unchanged (fail-open — behavior preserved).
#
# Single source of truth for base selection: ensure_bead_worktree calls it, and
# bin/gc-sling.test calls it directly (no logic copy => no drift). Intentionally
# pure — only awk + git reads, no log_event, no bead writes — so the fixture can
# exercise it hermetically. Defined here (above the main dispatch logic) so the
# GC_SLING_LIB_ONLY source seam below can expose it before any top-level code runs.
#
#   Args:   <rig_name> <toplevel_git_dir> <default_branch>
#   Stdout: "<committish> <ref> <sha>" on success
#           (default path: "<default_branch> <default_branch> " — empty sha)
#   Return: 0 = resolved (authoritative OR default); 3 = a configured
#           authoritative base could not be resolved (fail-closed)
resolve_authoritative_base() {
  local rig_name=$1 toplevel=$2 default_branch=$3
  local brc="${GC_SLING_BASE_REFS_CONF:-/home/ds/gas-city/.gc/sling-base-refs.conf}"
  local spec=""
  [[ -r "$brc" ]] && spec=$(awk -v r="$rig_name" '$1!~/^#/ && $1==r {print $2; exit}' "$brc" 2>/dev/null)
  if [[ -z "$spec" ]]; then
    # No authoritative entry for this rig — keep the default branch base.
    printf '%s %s %s\n' "$default_branch" "$default_branch" ""
    return 0
  fi
  local remote="${spec%%/*}" ref="${spec#*/}"
  # Fetch fresh so the remote-tracking ref is current, but don't fail on a
  # transient fetch error: the CACHED remote-tracking ref still resolves below,
  # which is a valid (if slightly stale) authoritative base and beats blocking.
  timeout 60 git -C "$toplevel" fetch --quiet "$remote" "$ref" 2>/dev/null || true
  local sha
  sha=$(git -C "$toplevel" rev-parse --verify --quiet "${spec}^{commit}" 2>/dev/null || echo "")
  if [[ -n "$sha" ]]; then
    printf '%s %s %s\n' "$sha" "$spec" "$sha"
    return 0
  fi
  # Configured authoritative base is genuinely unresolvable (no remote + no
  # cached ref). Fail closed — the caller must refuse the worktree AND dispatch.
  return 3
}

# dr-vn1i AC1 test seam: when SOURCED with GC_SLING_LIB_ONLY=1, stop here so the
# fixture can call resolve_authoritative_base directly against the REAL code (no
# logic copy = no drift). Placed BEFORE the main dispatch logic below (the
# `$# -eq 0` guard would otherwise exec `gc sling` first). `return` succeeds only
# when sourced; `|| exit 0` guards the (never-taken, default-0) executed case.
if [[ "${GC_SLING_LIB_ONLY:-0}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

if [[ $# -eq 0 ]]; then
  exec gc sling "$@"
fi

# Pass --help straight through.
case "${1:-}" in
  -h|--help)
    gc sling --help
    echo
    echo "gc-sling: thin intercept wrapper. See $CONFIG for auto-injection rules."
    echo "         Pass-through in all cases except bead matches a rule AND no"
    echo "         formula flag is present."
    echo "         Role routing: gc-sling auto <bead> --harness-role <role>"
    echo "         Optional: --harness-provider <provider> and"
    echo "                   --implementation-family <family>."
    exit 0 ;;
esac

# Parse args to find: target (first positional), bead (second positional),
# and whether any formula-intent or nudge flag is already set.
args=("$@")
has_on=0
has_formula=0
has_no_formula=0
has_nudge=0
has_no_nudge=0   # wrapper-only flag — opt out of default --nudge injection
has_dry_run=0
target=""
bead=""
harness_role=""
harness_provider=""
implementation_family=""
rig_hint=""
city_hint=""
remote_city_hint=0
target_index=-1
prev=""

# Flags that take a value after them (so the following token is NOT positional).
value_taking_flags=("--on" "-t" "--title" "--var" "--scope-kind" "--scope-ref" \
                    "--merge" "--city" "--rig" "--context" "--city-name" \
                    "--city-url" "--harness-role" \
                    "--harness-provider" "--implementation-family")

is_value_for_prev() {
  local p=$1
  for f in "${value_taking_flags[@]}"; do
    [[ "$p" == "$f" ]] && return 0
  done
  return 1
}

for i in "${!args[@]}"; do
  a="${args[$i]}"
  if is_value_for_prev "$prev"; then
    case "$prev" in
      --harness-role)          harness_role="$a" ;;
      --harness-provider)      harness_provider="$a" ;;
      --implementation-family) implementation_family="$a" ;;
      --rig)                   rig_hint="$a" ;;
      --city)                  city_hint="$a" ;;
      --context|--city-name|--city-url) remote_city_hint=1 ;;
    esac
    prev="$a"
    continue
  fi
  case "$a" in
    --on|--on=*)                has_on=1 ;;
    -f|--formula|--formula=*)   has_formula=1 ;;
    --no-formula)               has_no_formula=1 ;;
    --nudge)                    has_nudge=1 ;;
    --no-nudge)                 has_no_nudge=1 ;;
    -n|--dry-run)               has_dry_run=1 ;;
    --harness-role=*)           harness_role="${a#*=}" ;;
    --harness-provider=*)       harness_provider="${a#*=}" ;;
    --implementation-family=*) implementation_family="${a#*=}" ;;
    --rig=*)                    rig_hint="${a#*=}" ;;
    --city=*)                   city_hint="${a#*=}" ;;
    --context=*|--city-name=*|--city-url=*) remote_city_hint=1 ;;
    --)                         break ;;
    -*)                         : ;;
    *)
      if [[ -z "$target" ]]; then
        target="$a"
        target_index=$i
      elif [[ -z "$bead" ]]; then
        bead="$a"
      fi ;;
  esac
  prev="$a"
done

# Role-aware routing is opt-in through the literal target `auto`. An explicit
# target remains authoritative and cannot be silently replaced by a policy
# decision. The selector chooses among Gas City's existing implicit provider
# agents and returns the evidence that must be persisted before dispatch.
auto_selected=0
if [[ "$target" == "auto" || -n "$harness_role$harness_provider$implementation_family" ]]; then
  if [[ "$target" != "auto" ]]; then
    echo "gc-sling: harness flags require target 'auto'; explicit target '$target' remains authoritative" >&2
    exit 2
  fi
  if [[ -z "$harness_role" ]]; then
    echo "gc-sling: target 'auto' requires --harness-role coordination|implementation|verification" >&2
    exit 2
  fi
  if [[ "$harness_role" == "verification" && -z "$implementation_family" ]]; then
    echo "gc-sling: verification routing requires --implementation-family <provider-or-family>" >&2
    exit 2
  fi
  if (( remote_city_hint )) || [[ -n "$city_hint" ]]; then
    echo "gc-sling: role-based auto routing is limited to the current local city" >&2
    exit 2
  fi
  if [[ -z "$bead" || "$bead" != *-* ]]; then
    echo "gc-sling: role-based auto routing requires an existing bead ID" >&2
    exit 2
  fi
  # Serialize selection through dispatch so two simultaneous calls cannot both
  # observe and consume the same final provider/role slot. The descriptor stays
  # open across the final `exec gc sling` and is released when that command exits.
  if (( has_dry_run == 0 )); then
    if ! exec {harness_lock_fd}>"$HARNESS_LOCK"; then
      echo "gc-sling: cannot open harness allocation lock $HARNESS_LOCK" >&2
      exit 2
    fi
    if ! flock -w 30 "$harness_lock_fd"; then
      echo "gc-sling: timed out waiting for harness allocation lock" >&2
      exit 2
    fi
  fi
  selector_args=("$harness_role" "--bead" "$bead")
  [[ -n "$rig_hint" ]] && selector_args+=("--rig" "$rig_hint")
  [[ -n "$harness_provider" ]] && selector_args+=("--provider" "$harness_provider")
  [[ -n "$implementation_family" ]] \
    && selector_args+=("--implementation-family" "$implementation_family")
  selector_args+=("--json")
  if ! selection_json=$(timeout 30 "$HARNESS_SELECTOR" "${selector_args[@]}"); then
    echo "gc-sling: harness selection refused for $bead" >&2
    [[ -n "${selection_json:-}" ]] && echo "$selection_json" >&2
    exit 2
  fi
  if ! jq -e '.ok == true and (.target | type == "string") and (.provider | type == "string")' \
      >/dev/null 2>&1 <<<"$selection_json"; then
    echo "gc-sling: harness selector returned an invalid result: $selection_json" >&2
    exit 2
  fi

  selected_target=$(jq -r '.target' <<<"$selection_json")
  selected_provider=$(jq -r '.provider' <<<"$selection_json")
  selected_family=$(jq -r '.family' <<<"$selection_json")
  selected_rig=$(jq -r '.evidence.rig // ""' <<<"$selection_json")
  selected_at=$(jq -r '.evidence.selected_at // ""' <<<"$selection_json")
  selected_independent=$(jq -r \
    'if .independent_review == null then "unknown" else (.independent_review | tostring) end' \
    <<<"$selection_json")

  # Record the decision before routing. If this write fails, dispatch must not
  # proceed: a harness choice without durable provenance is not a valid choice.
  # Core --dry-run is preview-only, so it deliberately skips all wrapper writes.
  selection_json=$(jq -c '.' <<<"$selection_json")
  metadata_args=(
    --set-metadata "gc.harness_role=$harness_role"
    --set-metadata "gc.harness_provider=$selected_provider"
    --set-metadata "gc.harness_family=$selected_family"
    --set-metadata "gc.harness_independent_review=$selected_independent"
    --set-metadata "gc.harness_selected_at=$selected_at"
    --set-metadata "gc.harness_selection=$selection_json"
  )
  if (( has_dry_run == 0 )); then
    if [[ "$bead" == dr-* ]]; then
      metadata_cmd=(env GC_BEADS=bd timeout 15 gc bd update "$bead")
    else
      metadata_cmd=(timeout 15 gc bd --rig "$selected_rig" update "$bead")
    fi
    if ! "${metadata_cmd[@]}" "${metadata_args[@]}" >/dev/null; then
      echo "gc-sling: refusing to dispatch $bead because harness selection metadata could not be recorded" >&2
      exit 2
    fi
  fi

  # Strip wrapper-only flags and replace the first positional (`auto`) with the
  # selected qualified target before any existing worktree/formula logic runs.
  selected_args=()
  skip_next=0
  for i in "${!args[@]}"; do
    a="${args[$i]}"
    if (( skip_next )); then
      skip_next=0
      continue
    fi
    case "$a" in
      --harness-role|--harness-provider|--implementation-family)
        skip_next=1
        continue ;;
      --harness-role=*|--harness-provider=*|--implementation-family=*)
        continue ;;
    esac
    if (( i == target_index )); then
      selected_args+=("$selected_target")
    else
      selected_args+=("$a")
    fi
  done
  set -- "${selected_args[@]}"
  args=("$@")
  target="$selected_target"
  auto_selected=1
  (( has_dry_run )) \
    || log_event "harness-selected" "$bead" "$target" "" "provider=$selected_provider role=$harness_role"
  echo "gc-sling: selected $target for $harness_role ($selected_provider)" >&2
fi

# Pre-flight dead-target guard. Routing to a target whose pool has zero live
# sessions (a mistyped target, or a min=0 pool with no worker that won't spawn
# — e.g. `gascity/codex`, which has no workers) silently strands the bead:
# `gc sling` exits 0, the bead is stamped gc.routed_to, and nothing ever claims
# it. This turns that silent strand into a loud warning at dispatch time.
# gascity-rig code work belongs on target `polecat`, not `gascity/codex`.
if [[ -n "$target" && "$auto_selected" -eq 0 ]]; then
  # The sling target is an alias (e.g. `polecat`); sessions are stored under the
  # resolved template path (e.g. `/home/ds/gascity/polecat`), so an exact
  # --template match on the alias misses live sessions. Match on the target's
  # basename (slot suffix stripped) against each session's template/work_dir
  # basename in a single list call.
  tbase="${target##*/}"; tbase="${tbase%-[0-9]*}"
  # Timeout-guarded like every other gc call here. Unguarded, this probe blocks
  # dispatch indefinitely whenever gc is slow: a memory-throttled caller cgroup
  # stalled it past a 5m deadline and killed the sling mid-flight (2026-07-16).
  # An unreachable probe means UNKNOWN, not dead — stay quiet rather than cry
  # wolf, since the warning claims work will strand.
  sess_json=$(timeout 10 gc session list --json 2>/dev/null) || sess_json=""
  if [[ -z "$sess_json" ]]; then
    log_event "dead-target-unknown" "${bead:-}" "$target" "" "session probe failed or timed out"
  else
    live=$(printf '%s' "$sess_json" | jq -r --arg t "$target" --arg tb "$tbase" '
      [ ((.sessions // .) // [])[]
        | select(((.state // .State // "") | ascii_downcase) != "closed")
        | select(
            ((.template // .Template // "") == $t)
            or (((.template // .Template // "") | split("/") | last | sub("-[0-9]+$";"")) == $tb)
            or (((.work_dir // .WorkDir // "") | split("/") | last | sub("-[0-9]+$";"")) == $tb)
          )
      ] | length' 2>/dev/null || echo "")
    if [[ "$live" =~ ^[0-9]+$ && "$live" -eq 0 ]]; then
      echo "gc-sling: WARN target '$target' has 0 live sessions — slung work may strand unclaimed (no worker to claim it)." >&2
      echo "gc-sling: WARN verify the bead reaches in_progress; gascity-rig code work uses target 'polecat'." >&2
      log_event "dead-target-warn" "${bead:-}" "$target" "" "0 live sessions for target"
    fi
  fi
fi

# --- Per-bead worktree guard -------------------------------------------------
# Beads dispatched to a rig pool whose default formula has no worktree step
# (e.g. mol-focus-review) otherwise run in the SHARED rig main tree and pile WIP
# onto whatever branch the last bead left checked out (the scix o835 pile-up,
# 2026-06-14). This ensures a per-bead `git worktree add <rig-repo>-<beadshort>`
# exists and records it on work_dir (legacy key read by worktree-aware formulas
# and the mol-focus-review load-context `cd`) + gc.work_dir (canonical).
# Best-effort AND timeout-guarded: any failure or slow dolt call logs and falls
# through to a normal sling — it never blocks dispatch. Kill-switch:
# GC_SLING_NO_WORKTREE=1 (zero-edit). Dry-run: GC_SLING_DRYRUN=1.
WORKTREE_BASE_BRANCH="${GC_SLING_BASE_BRANCH:-main}"
ensure_bead_worktree() {
  local bead=$1 target=$2
  [[ "${GC_SLING_NO_WORKTREE:-0}" == "1" ]] && return 0
  [[ -z "$bead" || -z "$target" ]] && return 0
  [[ "$bead" == *-* ]] || return 0

  # dr-h6ze: dr- beads are city HQ tracking beads worked IN-PLACE in the (non-git)
  # city root — never per-rig code work, so they must not get a rig worktree. Skip
  # the guard outright. Otherwise the rig lookup below resolves "dr" (not a real
  # rig, per this fix's own note), the `gc bd --rig dr` metadata writes silently
  # no-op under the ambient file provider WHILE logging worktree-recorded success,
  # and — if the target session happens to sit inside an unrelated rig checkout —
  # a stray per-bead worktree gets cut under THAT repo for an HQ bead. No worktree
  # is the correct outcome for dr- beads (code-reviewer, 2026-07-18; same
  # dr-isn't-a-rig root cause as the sling-exec fix below).
  [[ "$bead" == dr-* ]] && { log_event "worktree-skip" "$bead" "$target" "" "dr- HQ tracking bead — no per-rig worktree"; return 0; }

  local beadshort="${bead#*-}"
  [[ -n "$beadshort" ]] || return 0

  # Resolve the rig NAME from the bead prefix. `gc bd --rig` takes the rig NAME,
  # but the prefix is NOT the name for most rigs (gc->gascity, co->codescalebench,
  # gpk->gascity-packs, EnterpriseBench->enterprisebench, ...). Deriving --rig from
  # ${bead%%-*} made every `gc bd` call below fail silently for such rigs — the
  # existing-check never short-circuited (orphan worktrees) and the metadata writes
  # no-op'd while "worktree-recorded" logged success (gc-na2o). Fail-safe: fall back
  # to the raw prefix if the lookup is unavailable, so this is never worse than before.
  local rig_name rig_json
  rig_json=$(timeout 10 gc rig list --json 2>/dev/null || echo "")
  rig_name=$(printf '%s' "$rig_json" \
    | jq -r --arg p "${bead%%-*}" '(.rigs // [])[] | select(.prefix==$p) | .name' 2>/dev/null | head -1)
  [[ -n "$rig_name" ]] || rig_name="${bead%%-*}"

  local tb repo
  if (( auto_selected )); then
    # Implicit provider agents are valid on-demand sling targets and commonly
    # have no live session yet. Always resolve their repository from the bead's
    # rig: the legacy basename matcher strips numeric suffixes, so codex-2 can
    # otherwise collide with an unrelated codex session in another repository.
    repo=$(printf '%s' "$rig_json" \
      | jq -r --arg r "$rig_name" '(.rigs // [])[] | select(.name==$r) | (.path // "")' 2>/dev/null | head -1)
  else
    tb="${target##*/}"; tb="${tb%-[0-9]*}"
    repo=$(timeout 10 gc session list --json 2>/dev/null | jq -r --arg t "$target" --arg tb "$tb" '
      [ ((.sessions // .) // [])[]
        | select(((.state // .State // "") | ascii_downcase) != "closed")
        | select(
            ((.template // .Template // "") == $t)
            or (((.template // .Template // "") | split("/") | last | sub("-[0-9]+$";"")) == $tb)
            or (((.work_dir // .WorkDir // "") | split("/") | last | sub("-[0-9]+$";"")) == $tb)
          )
        | (.work_dir // .WorkDir // "")
      ] | map(select(. != "")) | first // ""' 2>/dev/null || echo "")
  fi
  if [[ -z "$repo" ]]; then
    log_event "worktree-skip" "$bead" "$target" "" "no live work_dir or rig path for target"
    (( auto_selected )) && return 4
    return 0
  fi

  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { log_event "worktree-skip" "$bead" "$target" "" "$repo not a git repo"; (( auto_selected )) && return 4; return 0; }
  local toplevel
  if ! toplevel=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null); then
    log_event "worktree-skip" "$bead" "$target" "" "cannot resolve git toplevel for $repo"
    (( auto_selected )) && return 4
    return 0
  fi
  local wt_path="${toplevel}-${beadshort}"

  # dr-vn1i: authoritative per-rig base ref. Delegate base selection to the pure
  # resolve_authoritative_base helper (single source of truth, fixture-tested).
  # A configured-but-unresolvable base returns 3 -> we refuse the worktree AND the
  # dispatch (fail-closed). Every other outcome (authoritative-resolved OR the
  # default branch for unconfigured rigs) returns 0 and stays fail-open, so a
  # transient issue never blocks dispatch.
  local base_committish base_ref base_sha _rab_rc=0 _rab_out
  _rab_out=$(resolve_authoritative_base "$rig_name" "$toplevel" "$WORKTREE_BASE_BRANCH") || _rab_rc=$?
  if [[ "$_rab_rc" == "3" ]]; then
    log_event "worktree-baseref-fail" "$bead" "$target" "" "authoritative base for rig $rig_name unresolvable — refusing worktree AND dispatch (fail-closed, dr-vn1i)"
    return 3   # dr-vn1i: only this path is fail-closed; the caller (line ~275) aborts the sling.
  fi
  read -r base_committish base_ref base_sha <<<"$_rab_out"

  local existing
  existing=$(timeout 10 gc bd --rig "$rig_name" show "$bead" --json 2>/dev/null \
    | jq -r 'if type=="array" then .[0] else . end | (.metadata."work_dir" // .metadata."gc.work_dir" // "")' 2>/dev/null || echo "")
  if [[ -n "$existing" ]]; then
    if (( auto_selected )); then
      if [[ "$existing" == "$toplevel" ]] \
        || ! git -C "$toplevel" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $existing" \
        || [[ "$existing" != *"$bead"* && "$existing" != *"-$beadshort" ]]; then
        log_event "worktree-fail" "$bead" "$target" "" "recorded work_dir is not a dedicated worktree for $bead: $existing"
        return 4
      fi
    fi
    log_event "worktree-exists" "$bead" "$target" "" "work_dir already set: $existing"
    return 0
  fi

  if [[ "${GC_SLING_DRYRUN:-0}" == "1" ]]; then
    echo "gc-sling: DRYRUN would: git worktree add $wt_path $base_committish (repo $toplevel); set work_dir=$wt_path on $bead" >&2
    log_event "worktree-dryrun" "$bead" "$target" "" "$wt_path"
    return 0
  fi

  if ! git -C "$toplevel" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $wt_path"; then
    if [[ -e "$wt_path" ]]; then
      log_event "worktree-skip" "$bead" "$target" "" "path exists, not a worktree: $wt_path"
      (( auto_selected )) && return 4
    else
      if timeout 30 git -C "$toplevel" worktree add --detach "$wt_path" "$base_committish" >/dev/null 2>&1; then
        echo "gc-sling: created per-bead worktree $wt_path (base $base_ref${base_sha:+ @ $base_sha})" >&2
        log_event "worktree-created" "$bead" "$target" "" "$wt_path base=$base_ref sha=$base_sha"
      else
        log_event "worktree-fail" "$bead" "$target" "" "git worktree add failed for $wt_path"
        (( auto_selected )) && return 4
        return 0
      fi
    fi
  fi

  if [[ -d "$wt_path" ]]; then
    metadata_ok=1
    timeout 10 gc bd --rig "$rig_name" update "$bead" --set-metadata "work_dir=$wt_path" >/dev/null 2>&1 || metadata_ok=0
    timeout 10 gc bd --rig "$rig_name" update "$bead" --set-metadata "gc.work_dir=$wt_path" >/dev/null 2>&1 || metadata_ok=0
    # dr-vn1i: record the authoritative base the worktree was cut from, so a
    # divergent base is auditable (and future finalize/land can verify against it).
    timeout 10 gc bd --rig "$rig_name" update "$bead" --set-metadata "gc.base_ref=$base_ref" >/dev/null 2>&1 || metadata_ok=0
    if [[ -n "$base_sha" ]]; then
      timeout 10 gc bd --rig "$rig_name" update "$bead" --set-metadata "gc.base_sha=$base_sha" >/dev/null 2>&1 || metadata_ok=0
    fi
    if (( auto_selected && metadata_ok == 0 )); then
      log_event "worktree-fail" "$bead" "$target" "" "failed to persist worktree metadata for $wt_path"
      return 4
    fi
    log_event "worktree-recorded" "$bead" "$target" "" "$wt_path base=$base_ref sha=$base_sha"
  elif (( auto_selected )); then
    log_event "worktree-fail" "$bead" "$target" "" "worktree path missing after creation: $wt_path"
    return 4
  fi
}

_ebw_rc=0
if (( has_dry_run == 0 )); then
  ensure_bead_worktree "$bead" "$target" || _ebw_rc=$?
fi
if [[ "$_ebw_rc" == "3" ]]; then
  # dr-vn1i FAIL-CLOSED: an authoritative-base rig whose base couldn't be resolved
  # would otherwise dispatch onto a wrong/stale base and silently corrupt work
  # (gascity-packs local main is a 40-behind fork). Refuse to dispatch. This is
  # SCOPED to that one case — every other worktree outcome is best-effort/fail-open,
  # so a transient issue never blocks the fleet.
  echo "gc-sling: FAIL-CLOSED — refusing to dispatch $bead: its rig's authoritative base ref could not be resolved (fetch/access?), and a wrong-base per-bead worktree silently corrupts work (dr-vn1i)." >&2
  echo "gc-sling: fix the base-ref config (.gc/sling-base-refs.conf) or the remote fetch access, then re-sling." >&2
  log_event "sling-fail-closed" "$bead" "$target" "" "authoritative base unresolvable; dispatch aborted (dr-vn1i)"
  exit 1
fi
if [[ "$_ebw_rc" == "4" ]]; then
  echo "gc-sling: FAIL-CLOSED — refusing auto dispatch for $bead because its isolated worktree could not be verified and recorded." >&2
  log_event "sling-fail-closed" "$bead" "$target" "" "auto-selected target lacks verified per-bead worktree"
  exit 1
fi

# Strip --no-nudge from "$@" before any exec — it's a wrapper-only flag
# that `gc sling` doesn't recognize and would error on. Then build the
# nudge_args array we append to every exec.
#
# Why default-on: `gc sling` alone leaves warm pool workers idle
# (gascity#1129) so beads sit unclaimed against warm-idle workers until
# something else wakes them. Auto-injecting --nudge avoids the stall.
# Pass --no-nudge to opt out (e.g. cold-pool dispatches where you
# explicitly don't want a wake signal).
filtered_args=()
for a in "$@"; do
  [[ "$a" == "--no-nudge" ]] && continue
  filtered_args+=("$a")
done
set -- "${filtered_args[@]}"

nudge_args=()
if (( has_nudge == 0 && has_no_nudge == 0 )); then
  nudge_args=("--nudge")
fi

# Pass through if caller has specified formula intent or no bead.
if (( has_on )); then
  log_event "passthrough" "$bead" "$target" "" "--on already set"
  exec gc sling "$@" "${nudge_args[@]}"
fi
if (( has_formula )); then
  log_event "passthrough" "$bead" "$target" "" "--formula already set"
  exec gc sling "$@" "${nudge_args[@]}"
fi
if (( has_no_formula )); then
  log_event "passthrough" "$bead" "$target" "" "--no-formula set"
  exec gc sling "$@" "${nudge_args[@]}"
fi
if [[ -z "$bead" ]]; then
  # Inline text or formula-instantiation with --formula already handled above.
  exec gc sling "$@" "${nudge_args[@]}"
fi

# Heuristic: bead IDs look like <prefix>-<suffix>. Anything without a dash
# is almost certainly inline text — pass through without logging (too noisy).
if [[ "$bead" != *-* ]]; then
  exec gc sling "$@" "${nudge_args[@]}"
fi

# Load config and resolve formula for this bead. Rules may match on
# id_pattern and/or title_pattern; title lookup requires a `bd show` call
# against the correct rig, so we derive the rig from the bead prefix.
if [[ ! -r "$CONFIG" ]]; then
  exec gc sling "$@" "${nudge_args[@]}"
fi

# Quick id-only match first (cheap, avoids bd show for rules that only use id).
formula_and_rule=$(python3 - "$CONFIG" "$bead" <<'PYEOF' 2>/dev/null || true
import re, sys, yaml
cfg_path, bead = sys.argv[1], sys.argv[2]
try:
    with open(cfg_path, "rb") as f:
        cfg = yaml.safe_load(f) or {}
except Exception:
    sys.exit(0)
for rule in (cfg.get("rules") or []):
    pat = rule.get("id_pattern") or ""
    if not pat:
        continue
    try:
        if re.match(pat, bead):
            print(f"{rule.get('id','')}\t{rule.get('formula','')}")
            break
    except re.error:
        continue
PYEOF
)

# Title-pattern fallback for rules that declare title_pattern + scope.
if [[ -z "$formula_and_rule" ]]; then
  # Bead prefix = everything before the first '-'.
  bead_prefix="${bead%%-*}"
  title=""
  if [[ "$bead" == dr-* ]]; then
    # dr-h6ze: dr- beads live in the city HQ Dolt store, not a rig. `gc bd --rig
    # dr` would fail (dr is not a registered rig) and silently drop any dr- title
    # rule — the same silent-store-miss this bead exists to kill. Reach the HQ
    # store via the bd provider directly (no --rig; dr IS the default gc bd store
    # when GC_BEADS=bd), scoped to this one lookup like the sling exec above.
    if title_json=$(GC_BEADS=bd timeout 10 gc bd show "$bead" --json 2>/dev/null); then
      title=$(jq -r 'if type=="array" then .[0] else . end | .title // ""' <<<"$title_json" 2>/dev/null)
    fi
  else
    # Map prefix to rig NAME (prefix != name for most rigs; gc->gascity etc. —
    # same gc-na2o bug class as the worktree guard above). Fail-safe to the raw
    # prefix so this is never worse than the old direct-prefix lookup.
    bead_rig=$(timeout 10 gc rig list --json 2>/dev/null \
      | jq -r --arg p "$bead_prefix" '(.rigs // [])[] | select(.prefix==$p) | .name' 2>/dev/null | head -1)
    [[ -n "$bead_rig" ]] || bead_rig="$bead_prefix"
    # Try rig lookup first (resolved rig name).
    if title_json=$(gc bd --rig "$bead_rig" show "$bead" --json 2>/dev/null); then
      title=$(jq -r 'if type=="array" then .[0] else . end | .title // ""' <<<"$title_json" 2>/dev/null)
    fi
  fi
  if [[ -n "$title" ]]; then
    formula_and_rule=$(python3 - "$CONFIG" "$bead" "$bead_prefix" "$title" <<'PYEOF' 2>/dev/null || true
import re, sys, yaml
cfg_path, bead, prefix, title = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    with open(cfg_path, "rb") as f:
        cfg = yaml.safe_load(f) or {}
except Exception:
    sys.exit(0)
for rule in (cfg.get("rules") or []):
    tpat = rule.get("title_pattern") or ""
    scope = rule.get("scope") or ""
    if not tpat:
        continue
    # If scope is set, bead's prefix (rig) must match.
    if scope and scope != prefix:
        continue
    try:
        if re.match(tpat, title):
            print(f"{rule.get('id','')}\t{rule.get('formula','')}")
            break
    except re.error:
        continue
PYEOF
)
  fi
fi

if [[ -z "$formula_and_rule" ]]; then
  # No rule matches — pass through silently (don't log routine dispatches).
  exec gc sling "$@" "${nudge_args[@]}"
fi

rule_id="${formula_and_rule%%$'\t'*}"
formula="${formula_and_rule##*$'\t'}"

if [[ -z "$formula" ]]; then
  exec gc sling "$@" "${nudge_args[@]}"
fi

echo "gc-sling: bead $bead matches rule '$rule_id' — injecting --on $formula" >&2
log_event "formula_injected" "$bead" "$target" "$formula" "rule=$rule_id"

exec gc sling "$@" --on "$formula" "${nudge_args[@]}"
