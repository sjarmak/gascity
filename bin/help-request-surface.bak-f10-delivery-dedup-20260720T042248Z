#!/usr/bin/env bash
# help-request-surface — when a worker raises a help request (sets a bead to
# status=blocked with metadata.help_request, per the "When stuck" protocol in
# agents/polecat/prompt.template.md + prompts/{worker,scoped-worker,pool-worker}.md),
# actively nudge the mayor so the ask is processed promptly instead of waiting
# for the next mail scan. Idempotent: each bead is surfaced at most once
# (stamps gc.help_surfaced_at). Trigger: event on bead.updated.
set -euo pipefail

CITY="${GC_STORE_ROOT:-/home/ds/gas-city}"
SINCE="${HELP_SURFACE_SINCE:-2m}"

# prefix -> rig map (resolve a bead ID to its rig for `gc bd --rig`).
declare -A PREFIX_TO_RIG
while IFS=$'\t' read -r rig prefix; do
    [[ -n "$prefix" ]] && PREFIX_TO_RIG["$prefix"]="$rig"
done < <(gc rig list 2>/dev/null | awk '
    /^  [a-zA-Z][a-zA-Z0-9_-]+:/ { name=$1; sub(/:$/,"",name); current_rig=name }
    /^    Prefix:/ { gsub(/^    Prefix:[ \t]+/,""); print current_rig "\t" $0 }')

rig_for_bead() {
    local bead_id="$1" prefix
    for prefix in "${!PREFIX_TO_RIG[@]}"; do
        [[ "$bead_id" == "$prefix-"* ]] && echo "${PREFIX_TO_RIG[$prefix]}" && return
    done
    return 1
}

bead_ids=$(gc events --type bead.updated --since "$SINCE" 2>/dev/null \
    | jq -r '.subject // empty' | awk 'NF' | sort -u)
[[ -z "$bead_ids" ]] && exit 0

while IFS= read -r bead_id; do
    [[ -z "$bead_id" ]] && continue
    rig=$(rig_for_bead "$bead_id") || continue
    bj=$(gc bd --rig "$rig" show "$bead_id" --json 2>/dev/null || echo "[]")
    [[ "$(jq -r '.[0].status // empty' <<<"$bj" 2>/dev/null)" == "blocked" ]] || continue
    hr=$(jq -r '.[0].metadata.help_request // empty' <<<"$bj" 2>/dev/null || echo "")
    [[ -n "$hr" ]] || continue
    # idempotent: skip if already surfaced
    [[ -z "$(jq -r '.[0].metadata."gc.help_surfaced_at" // empty' <<<"$bj" 2>/dev/null)" ]] || continue

    gc session nudge mayor "[help] ${bead_id} (${rig}) blocked awaiting help: ${hr:0:160}" >/dev/null 2>&1 || true
    gc bd --rig "$rig" update "$bead_id" \
        --set-metadata "gc.help_surfaced_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >/dev/null 2>&1 || true
done <<<"$bead_ids"
