#!/usr/bin/env bash
# stale-attention-reaper: surface-only staleness scanner for open
# Stephanie-attention beads, running TWO rules against the decisions rig:
#
#   Rule A (AGE): open `needs/stephanie` beads with no movement in N days.
#     Stephanie 2026-06-30 — "there were some back from may 12 showing up as
#     'need me' but I'm sure that work is stale; need an automated way to
#     handle that." The existing janitors only PRUNE CLOSED beads — nothing
#     ages stale-but-OPEN attention. This is that missing attention-aging path.
#
#   Rule B (RESOLVED SUBJECT): open `needs/stephanie` decs whose referenced
#     PR is merged/closed or whose referenced source bead is closed.
#     Stephanie 2026-06-13 — "handle stale decision beads where I've closed it
#     out already from working directly with a rig agent."
#
# Merged 2026-07-21 (order-layer consolidation, city audit sec 2.1 + epic
# gc-28w2): Rule B was bin/decision-staleness-reaper, a separate hourly order
# scanning the same rig, same label, same mail target, same surface-only
# contract. One reaper, two rules. Each rule keeps its ORIGINAL state and
# audit-log files so change-dedup carries across the merge (no re-mail storm).
# Undo: restore bin/decision-staleness-reaper + its order from this commit's
# parent in git.
#
# Discipline (both rules):
#   - Surface-only (ZFC): the close/keep judgment stays with the mayor (a
#     model). A stale item may still be genuinely pending — only a read
#     decides. Rule B deliberately does NOT auto-close: "open PR for bead X"
#     stays live even after bead X closes at branch-ready.
#   - Change-dedup'd: an unchanged candidate set is not re-mailed every run.
#
# Tunables (env):
#   STALE_ATTENTION_TTL_DAYS  Rule A age threshold in days (default 21)
#   STALE_ATTENTION_RIG       rig to scan (default decisions)
#   STALE_ATTENTION_LABEL     required label (default needs/stephanie)
#   STALE_ATTENTION_MAYOR     mail target (default mayor)
#   STALE_DEC_MAYOR           Rule B mail target (default: STALE_ATTENTION_MAYOR)
#   STALE_REAPER_DRY_RUN      1 = log candidates, send no mail, touch no state
#                             (verification runs; default 0)

set -uo pipefail

CITY=/home/ds/gas-city
TTL_DAYS="${STALE_ATTENTION_TTL_DAYS:-21}"
RIG="${STALE_ATTENTION_RIG:-decisions}"
LABEL="${STALE_ATTENTION_LABEL:-needs/stephanie}"
MAYOR="${STALE_ATTENTION_MAYOR:-mayor}"
DEC_MAYOR="${STALE_DEC_MAYOR:-$MAYOR}"
DRY_RUN="${STALE_REAPER_DRY_RUN:-0}"

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }

# ---------------------------------------------------------------------------
# Rule A: AGE — no movement past TTL. State/log unchanged from the pre-merge
# single-rule script.
# ---------------------------------------------------------------------------
run_age_rule() {
  local audit_log="$CITY/.gc/stale-attention-reaper.log"
  local state="$CITY/.gc/stale-attention-reaper.state"
  log() { echo "$(ts) [age] $*" >> "$audit_log"; }

  local now cutoff raw rc beads
  now=$(date +%s)
  cutoff=$(( TTL_DAYS * 86400 ))

  # Pull open beads carrying the attention label, oldest-touched first. Use
  # updated_at when present (the real signal — last movement), else created_at.
  # A store we cannot read is NOT an all-clear (cf. bin/needs-recovery-reaper's
  # scan_failed handling): clearing state on a transient failure would re-alert
  # every candidate on the next successful run. Fail loud, leave state alone.
  raw=$(gc bd --rig "$RIG" list --status open --json --limit=0 2>/dev/null)
  rc=$?
  if (( rc != 0 )); then
    log "scan_failed: gc bd list rc=$rc — scan did NOT run, state untouched"
    echo "stale-attention-reaper[age]: gc bd list failed (rc=$rc) — scan did NOT run" >&2
    return 1
  fi
  if ! beads=$(jq -c --arg lbl "$LABEL" '
    [ .[] | select((.labels // []) | index($lbl)) ]
    | sort_by(.updated_at // .created_at)
    | .[] | {id, title, touched: (.updated_at // .created_at)}' <<<"$raw" 2>/dev/null); then
    log "scan_failed: gc bd list output unparseable — scan did NOT run, state untouched"
    echo "stale-attention-reaper[age]: gc bd list output unparseable — scan did NOT run" >&2
    return 1
  fi

  if [[ -z "$beads" ]]; then
    # Confirmed-successful empty scan (gc bd rc=0, parseable output): the
    # candidate set is genuinely empty, so the change-dedup state may clear.
    log "skip: no open $LABEL beads on rig $RIG"
    [[ "$DRY_RUN" == "1" ]] || rm -f "$state"
    return 0
  fi

  local candidates="" count=0 b id title touched t_epoch age days
  while IFS= read -r b; do
    [[ -z "$b" ]] && continue
    id=$(echo "$b" | jq -r '.id')
    title=$(echo "$b" | jq -r '.title')
    touched=$(echo "$b" | jq -r '.touched')
    [[ -z "$touched" || "$touched" == "null" ]] && continue
    t_epoch=$(date -d "$touched" +%s 2>/dev/null) || continue
    age=$(( now - t_epoch ))
    (( age < cutoff )) && continue
    days=$(( age / 86400 ))
    candidates+="- \`${id}\` — ${title} _(stale ${days}d, last touched ${touched:0:10})_\n"
    count=$(( count + 1 ))
  done <<< "$beads"

  if (( count == 0 )); then
    log "no stale candidates (none older than ${TTL_DAYS}d)"
    [[ "$DRY_RUN" == "1" ]] || rm -f "$state"
    return 0
  fi

  # Change-dedup: key on the candidate ID set, not the rendered text (the day
  # counters tick every run and would defeat dedup otherwise).
  local content_hash last_hash
  content_hash=$(printf '%b' "$candidates" | grep -oE '`[^`]+`' | sort | sha256sum | cut -d' ' -f1)
  last_hash=""; [[ -f "$state" ]] && last_hash=$(cat "$state" 2>/dev/null)
  if [[ "$content_hash" == "$last_hash" ]]; then
    log "skip: candidate set unchanged ($count stale)"
    return 0
  fi

  if [[ "$DRY_RUN" == "1" ]]; then
    log "DRY-RUN: would flag $count stale candidate(s) to $MAYOR (ttl=${TTL_DAYS}d)"
    printf '[age] DRY-RUN candidates:\n%b' "$candidates"
    return 0
  fi

  local body
  body=$(printf 'Stale-attention candidates — these `%s` items on the `%s` rig have had no movement in over %s days, so they are likely the "need me" backlog Stephanie sees as stale. Re-confirm each still needs her, or `gc bd --rig %s close <id>` the ones that are done.\n\n%b\n_Detected mechanically on AGE only (no movement past the %sd threshold). A stale item may still be genuinely pending — the close/keep judgment is yours._' \
    "$LABEL" "$RIG" "$TTL_DAYS" "$RIG" "$candidates" "$TTL_DAYS")

  if gc mail send "$MAYOR" -s "stale-attention candidates: $count $LABEL item(s) idle >${TTL_DAYS}d" -m "$body" --notify >/dev/null 2>&1; then
    echo "$content_hash" > "$state"
    log "flagged $count stale candidate(s) to $MAYOR (ttl=${TTL_DAYS}d)"
  else
    log "ERROR: mail to $MAYOR failed"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Rule B: RESOLVED SUBJECT — referenced PR merged/closed or referenced source
# bead closed. Ported verbatim from bin/decision-staleness-reaper 2026-07-21;
# state/log paths kept so dedup carries over. gh calls gained a 30s timeout
# (audit sec 4.5: gh without timeouts).
# ---------------------------------------------------------------------------
run_resolved_subject_rule() {
  local audit_log="$CITY/.gc/decision-staleness-reaper.log"
  local state="$CITY/.gc/decision-staleness-reaper.state"
  log() { echo "$(ts) [dec] $*" >> "$audit_log"; }

  command -v gh >/dev/null 2>&1 || { log "skip: gh not available"; return 0; }

  # Same fail-loud contract as Rule A: a failed or unparseable gc bd list is
  # NOT an empty candidate set — leave the dedup state untouched and fail.
  local raw rc decs
  raw=$(gc bd --rig "$RIG" list --status open --json --limit=0 2>/dev/null)
  rc=$?
  if (( rc != 0 )); then
    log "scan_failed: gc bd list rc=$rc — scan did NOT run, state untouched"
    echo "stale-attention-reaper[dec]: gc bd list failed (rc=$rc) — scan did NOT run" >&2
    return 1
  fi
  if ! decs=$(jq -c --arg lbl "$LABEL" '
    [ .[] | select((.labels // []) | index($lbl)) ]
    | sort_by(.created_at) | .[] | {id, title, description}' <<<"$raw" 2>/dev/null); then
    log "scan_failed: gc bd list output unparseable — scan did NOT run, state untouched"
    echo "stale-attention-reaper[dec]: gc bd list output unparseable — scan did NOT run" >&2
    return 1
  fi

  [[ -z "$decs" ]] && { log "skip: no open $LABEL decs"; [[ "$DRY_RUN" == "1" ]] || rm -f "$state"; return 0; }

  # dec_repo <text>: route a dec to a SINGLE repo. Low PR numbers (#120)
  # collide across gascity and the dashboard, so we must not probe both.
  # Mechanical tiebreaker (ZFC-permitted): dashboard-flavored decs ->
  # dashboard, else the main repo. (Going forward, mayor can embed the repo in
  # the dec to remove the heuristic entirely.)
  dec_repo() {
    if echo "$1" | grep -qiE 'dashboard|operator-view|convoy|runs[ -]?view|caag|phase (map|vocab)'; then
      echo "gastownhall/gascity-dashboard"
    else
      echo "gastownhall/gascity"
    fi
  }

  # pr_state <num> <repo>: echo "<repo> <STATE>" if the PR is MERGED/CLOSED in
  # that repo; empty if open or not a PR (issue numbers resolve to nothing).
  pr_state() {
    local num="$1" repo="$2" st merged j
    j=$(timeout 30 gh pr view "$num" --repo "$repo" --json state,mergedAt 2>/dev/null) || return
    st=$(echo "$j" | jq -r '.state // ""')
    merged=$(echo "$j" | jq -r '.mergedAt // ""')
    if [[ "$st" == "MERGED" || -n "$merged" ]]; then echo "$repo MERGED"; return; fi
    if [[ "$st" == "CLOSED" ]]; then echo "$repo CLOSED"; fi
  }

  # bead_closed <id>: echo "CLOSED" if the bead resolves and is closed.
  bead_closed() {
    local id="$1" st
    st=$(gc bd show "$id" --json 2>/dev/null | jq -r '.status // ""' 2>/dev/null)
    [[ "$st" == "closed" ]] && echo "CLOSED"
  }

  local candidates="" dec id title repo evidence num bid res
  while IFS= read -r dec; do
    [[ -z "$dec" ]] && continue
    id=$(echo "$dec" | jq -r '.id')
    title=$(echo "$dec" | jq -r '.title')
    # Match refs from the TITLE only — the decision's SUBJECT lives there; the
    # description carries context numbers (sibling PRs, the ledger queue) that
    # are not what the dec is gating, and scanning them produces false
    # positives.
    repo=$(dec_repo "$title")

    evidence=""

    # GitHub PR refs (subject only), checked against the dec's single routed repo
    for num in $(echo "$title" | grep -oE '#[0-9]{2,}' | tr -d '#' | sort -u); do
      res=$(pr_state "$num" "$repo")
      [[ -n "$res" ]] && evidence+="    • #${num} ${res}\n"
    done

    # bead refs in the title; exclude this dec and any other dec- mirror
    for bid in $(echo "$title" | grep -oiE '\b[a-z][a-z0-9_]*-[a-z0-9]{4,}\b' | sort -u); do
      [[ "$bid" == dec-* ]] && continue
      [[ "$bid" == "$id" ]] && continue
      [[ -n "$(bead_closed "$bid")" ]] && evidence+="    • bead ${bid} CLOSED\n"
    done

    if [[ -n "$evidence" ]]; then
      candidates+="- \`${id}\` — ${title}\n${evidence}"
    fi
  done <<< "$decs"

  if [[ -z "$candidates" ]]; then
    log "no stale candidates among open decs"
    [[ "$DRY_RUN" == "1" ]] || rm -f "$state"
    return 0
  fi

  # Change-dedup: don't re-mail an unchanged candidate set every run.
  local content_hash last_hash
  content_hash=$(printf '%b' "$candidates" | grep -oE 'dec-[a-z0-9]+|#[0-9]+|bead [a-z0-9_-]+' | sort | sha256sum | cut -d' ' -f1)
  last_hash=""; [[ -f "$state" ]] && last_hash=$(cat "$state" 2>/dev/null)
  if [[ "$content_hash" == "$last_hash" ]]; then
    log "skip: candidate set unchanged"
    return 0
  fi

  if [[ "$DRY_RUN" == "1" ]]; then
    log "DRY-RUN: would flag $(printf '%b' "$candidates" | grep -c '^- ') candidate(s) to $DEC_MAYOR"
    printf '[dec] DRY-RUN candidates:\n%b' "$candidates"
    return 0
  fi

  local body
  body=$(printf 'Stale-decision candidates — the referenced PR/bead is already resolved, so these `%s` decs are likely moot. Verify each and `gc bd --rig %s close <id>` the ones that are done; leave any still genuinely pending.\n\n%b\n_Detected mechanically (referenced PR merged/closed or source bead closed). Close judgment is yours._' "$LABEL" "$RIG" "$candidates")

  if gc mail send "$DEC_MAYOR" -s "stale-decision candidates: $(printf '%b' "$candidates" | grep -c '^- ') dec(s) look resolved" -m "$body" --notify >/dev/null 2>&1; then
    echo "$content_hash" > "$state"
    log "flagged $(printf '%b' "$candidates" | grep -c '^- ') candidate(s) to $DEC_MAYOR"
  else
    log "ERROR: mail to $DEC_MAYOR failed"
    return 1
  fi
}

# Run both rules; a failure in one must not mask the other, and any failure
# fails the run (no silent swallow).
rc=0
run_age_rule || rc=1
run_resolved_subject_rule || rc=1
exit "$rc"
