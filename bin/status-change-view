#!/usr/bin/env python3
"""status-change-view: READ-ONLY status-transition view over a bead store's
`events` audit table (gc-avqc0). Emits the tuple
    (issue_id, from_status, to_status, actor, session, ts)
one row per actual status change, as a shared prerequisite for the Shepherd
meta-agent, eval golden sets, and `bd` trace.

WHY A SCRIPT, NOT A DOLT VIEW: dolt's JSON functions reject the `longtext`
old_value/new_value columns (JSON_VALID=0, JSON_EXTRACT errors) even on valid
JSON, and several rows are non-JSON (closed comments, empty created payloads).
A SQL VIEW with JSON_EXTRACT therefore errors on the store; a script parses each
row defensively instead. Read-only — never mutates the store.

TRANSITION MODEL (confirmed empirically against the live gascity store, which
carries 7 event_types incl. `reopened` that a naive 4-type UNION misses):
a status change is detected by the actual status delta, NOT an event_type
allowlist (so a future status-affecting event_type is covered automatically):
  - event_type 'created'  -> to_status = 'open'   (payload empty; bd default)
  - event_type 'closed'   -> to_status = 'closed' (payload is a free-text comment)
  - any other event_type  -> to_status = new_value JSON '$.status' when present
                             (claimed/status_changed/reopened/updated/…); rows
                             whose diff has no $.status (notes/labels/assignee-
                             only) are NOT transitions and are excluded.
  from_status = the prior emitted to_status for that issue (the per-issue
  transition chain), which is correct even for 'closed' (empty old_value) where
  reading old_value.$.status would fail. The first transition has from=NULL.
  No-op restatements (from == to) are dropped — this is a *change* view.

SESSION vs ACTOR: there is no session column; `actor` IS the agent/session
alias for agent-driven changes (e.g. 'city-infra-pl', 'polecat-gc-426645') and a
system label otherwise ('controller', 'cache-reconcile', 'order:…', 'convoy').
We emit session := actor verbatim and DO NOT heuristically classify which actors
are sessions — that semantic call is left to the consumer (ZFC: expose the raw
signal, don't bake a classifier into plumbing).

Usage: status-change-view [--db NAME] [--issue ID] [--json] [--limit N]
  --db     bead-store database (default: gascity; e.g. gc, mem, …)
  --issue  restrict to one issue_id (the `bd` trace path)
  --json   machine-readable JSON array (default: aligned text table)
  --limit  cap emitted rows (newest first); 0 = all (default)
Env: STATUS_VIEW_DOLT_INFO (default .beads/dolt/.dolt/sql-server.info)
"""
import sys, os, csv, io, json, subprocess

CITY = "/home/ds/gas-city"
DOLT_INFO = os.environ.get("STATUS_VIEW_DOLT_INFO",
                           os.path.join(CITY, ".beads/dolt/.dolt/sql-server.info"))


def dolt_port():
    """Port from the gc-managed sql-server.info (PID:PORT:UUID)."""
    with open(DOLT_INFO) as f:
        return f.read().strip().split(":")[1]


def fetch_events(db, port):
    """Lean, ordered event rows for one store. Pulls new_value ONLY when it
    carries a status field (a mechanical payload trim — not an event_type
    allowlist), so heavy notes/comment payloads aren't transferred. Ordered by
    (issue_id, created_at, id) so the per-issue chain is deterministic."""
    q = (
        "SELECT issue_id, event_type, actor, created_at, "
        "CASE WHEN new_value LIKE '%\"status\"%' THEN new_value ELSE NULL END AS nv "
        f"FROM {db}.events ORDER BY issue_id, created_at, id;"
    )
    out = subprocess.run(
        ["dolt", "--host", "127.0.0.1", "--port", port, "--user", "root",
         "--no-tls", "--password", "", "sql", "-r", "csv", "-q", q],
        capture_output=True, text=True, timeout=110)
    if out.returncode != 0:
        raise RuntimeError(f"dolt query failed: {out.stderr.strip()[:300]}")
    return list(csv.DictReader(io.StringIO(out.stdout)))


def to_status_of(event_type, nv):
    """The status this event moves the bead TO, or None if it is not a status
    change. Constants for created/closed (their payload carries no status diff);
    otherwise the new_value JSON '$.status' if present."""
    if event_type == "created":
        return "open"
    if event_type == "closed":
        return "closed"
    if not nv:
        return None
    try:
        diff = json.loads(nv)
    except (ValueError, TypeError):
        return None
    return diff.get("status") if isinstance(diff, dict) else None


def transitions(rows):
    """Walk the per-issue ordered events into status-change tuples. from_status
    is the prior emitted to_status for that issue; no-op restatements dropped."""
    last_to = {}
    out = []
    for r in rows:
        iid = r["issue_id"]
        to = to_status_of(r["event_type"], r.get("nv"))
        if to is None:
            continue
        frm = last_to.get(iid)  # None on first transition
        last_to[iid] = to
        if frm == to:
            continue  # not a change
        out.append({
            "issue_id": iid,
            "from_status": frm,
            "to_status": to,
            "actor": r["actor"],
            "session": r["actor"],  # actor IS the session alias; see header
            "ts": r["created_at"],
        })
    return out


def main():
    argv = sys.argv[1:]
    db = "gascity"
    issue = None
    limit = 0
    json_out = "--json" in argv
    if "--db" in argv:
        db = argv[argv.index("--db") + 1]
    if "--issue" in argv:
        issue = argv[argv.index("--issue") + 1]
    if "--limit" in argv:
        limit = int(argv[argv.index("--limit") + 1])

    try:
        port = dolt_port()
        rows = fetch_events(db, port)
    except (OSError, ValueError, IndexError, RuntimeError,
            subprocess.SubprocessError) as e:
        print(f"status-change-view: {e}", file=sys.stderr)
        return 1

    out = transitions(rows)
    if issue:
        out = [t for t in out if t["issue_id"] == issue]
    if limit and limit > 0:
        out = sorted(out, key=lambda t: t["ts"], reverse=True)[:limit]

    if json_out:
        print(json.dumps(out, indent=2))
        return 0

    print(f"status-change-view  db={db}  transitions={len(out)}"
          + (f"  issue={issue}" if issue else ""))
    print(f"{'ISSUE_ID':<14} {'FROM':<12} {'TO':<12} {'ACTOR':<26} TS")
    for t in out:
        print(f"{t['issue_id']:<14} {str(t['from_status'] or '∅'):<12} "
              f"{t['to_status']:<12} {t['actor'][:26]:<26} {t['ts']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
