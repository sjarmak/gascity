#!/usr/bin/env bash
# decision-staleness-reaper: detect open Stephanie-decisions whose underlying
# work is already resolved, and flag them to the mayor for a one-step close.
#
# Why: Stephanie often resolves a decision out-of-band — she tells a rig agent
# to do the thing, or merges/closes the PR herself — but the `dec-` mirror on
# the decisions rig stays OPEN and keeps getting pushed by decision-ledger-push.
# Stephanie 2026-06-13: "handle stale decision beads where I've closed it out
# already from working directly with a rig agent."
#
# What it does (mechanical detection only — ZFC: the CLOSE judgment stays with
# the mayor, a model, not a hardcoded heuristic):
#   For each open `needs/stephanie` dec, it extracts referenced artifacts from
#   the title+description — GitHub PR/issue numbers (`#NNNN`) and bead IDs —
#   and looks up their current state. A dec is a STALENESS CANDIDATE when:
#     - a referenced PR is MERGED or CLOSED, or
#     - a referenced source bead (not another dec-) is CLOSED.
#   Candidates are mailed to the mayor (change-dedup'd) with the evidence; the
#   mayor verifies semantics and closes or keeps. This deliberately does NOT
#   auto-close: "open PR for bead X" stays live even after bead X closes at
#   branch-ready, so closed-source != decision-resolved without a model's read.
#
# Pairs with decision-ledger-push (SSOT = decisions rig). Surface-only v1;
# promote to auto-close on the unambiguous PR-merged signal once trusted.

set -uo pipefail

CITY=/home/ds/gas-city
AUDIT_LOG="$CITY/.gc/decision-staleness-reaper.log"
STATE="$CITY/.gc/decision-staleness-reaper.state"
MAYOR="${STALE_DEC_MAYOR:-mayor}"

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { echo "$(ts) $*" >> "$AUDIT_LOG"; }

command -v gh >/dev/null 2>&1 || { log "skip: gh not available"; exit 0; }

decs=$(gc bd --rig decisions list --status open --json --limit=0 2>/dev/null | jq -c '
  [ .[] | select((.labels // []) | index("needs/stephanie")) ]
  | sort_by(.created_at) | .[] | {id, title, description}' 2>/dev/null)

[[ -z "$decs" ]] && { log "skip: no open needs/stephanie decs"; rm -f "$STATE"; exit 0; }

# dec_repo <text>: route a dec to a SINGLE repo. Low PR numbers (#120) collide
# across gascity and the dashboard, so we must not probe both. Mechanical
# tiebreaker (ZFC-permitted): dashboard-flavored decs -> dashboard, else the
# main repo. (Going forward, mayor can embed the repo in the dec to remove the
# heuristic entirely.)
dec_repo() {
  if echo "$1" | grep -qiE 'dashboard|operator-view|convoy|runs[ -]?view|caag|phase (map|vocab)'; then
    echo "gastownhall/gascity-dashboard"
  else
    echo "gastownhall/gascity"
  fi
}

# pr_state <num> <repo>: echo "<repo> <STATE>" if the PR is MERGED/CLOSED in
# that repo; empty if open or not a PR (issue numbers resolve to nothing here).
pr_state() {
  local num="$1" repo="$2" st merged j
  j=$(gh pr view "$num" --repo "$repo" --json state,mergedAt 2>/dev/null) || return
  st=$(echo "$j" | jq -r '.state // ""')
  merged=$(echo "$j" | jq -r '.mergedAt // ""')
  if [[ "$st" == "MERGED" || -n "$merged" ]]; then echo "$repo MERGED"; return; fi
  if [[ "$st" == "CLOSED" ]]; then echo "$repo CLOSED"; fi
}

# bead_closed <id>: echo "CLOSED" if the bead resolves and is closed.
bead_closed() {
  local id="$1" st
  st=$(gc bd show "$id" --json 2>/dev/null | jq -r '.status // ""' 2>/dev/null)
  [[ "$st" == "closed" ]] && echo "CLOSED"
}

candidates=""
while IFS= read -r dec; do
  [[ -z "$dec" ]] && continue
  id=$(echo "$dec" | jq -r '.id')
  title=$(echo "$dec" | jq -r '.title')
  # Match refs from the TITLE only — the decision's SUBJECT lives there; the
  # description carries context numbers (sibling PRs, the ledger queue) that
  # are not what the dec is gating, and scanning them produces false positives.
  repo=$(dec_repo "$title")

  evidence=""

  # GitHub PR refs (subject only), checked against the dec's single routed repo
  for num in $(echo "$title" | grep -oE '#[0-9]{2,}' | tr -d '#' | sort -u); do
    res=$(pr_state "$num" "$repo")
    [[ -n "$res" ]] && evidence+="    • #${num} ${res}\n"
  done

  # bead refs in the title; exclude this dec and any other dec- mirror
  for bid in $(echo "$title" | grep -oiE '\b[a-z][a-z0-9_]*-[a-z0-9]{4,}\b' | sort -u); do
    [[ "$bid" == dec-* ]] && continue
    [[ "$bid" == "$id" ]] && continue
    [[ -n "$(bead_closed "$bid")" ]] && evidence+="    • bead ${bid} CLOSED\n"
  done

  if [[ -n "$evidence" ]]; then
    candidates+="- \`${id}\` — ${title}\n${evidence}"
  fi
done <<< "$decs"

if [[ -z "$candidates" ]]; then
  log "no stale candidates among open decs"
  rm -f "$STATE"
  exit 0
fi

# Change-dedup: don't re-mail an unchanged candidate set every run.
content_hash=$(printf '%b' "$candidates" | grep -oE 'dec-[a-z0-9]+|#[0-9]+|bead [a-z0-9_-]+' | sort | sha256sum | cut -d' ' -f1)
last_hash=""; [[ -f "$STATE" ]] && last_hash=$(cat "$STATE" 2>/dev/null)
if [[ "$content_hash" == "$last_hash" ]]; then
  log "skip: candidate set unchanged"
  exit 0
fi

body=$(printf 'Stale-decision candidates — the referenced PR/bead is already resolved, so these `needs/stephanie` decs are likely moot. Verify each and `gc bd --rig decisions close <id>` the ones that are done; leave any still genuinely pending.\n\n%b\n_Detected mechanically (referenced PR merged/closed or source bead closed). Close judgment is yours._' "$candidates")

if gc mail send "$MAYOR" -s "stale-decision candidates: $(printf '%b' "$candidates" | grep -c '^- ') dec(s) look resolved" -m "$body" --notify >/dev/null 2>&1; then
  echo "$content_hash" > "$STATE"
  log "flagged $(printf '%b' "$candidates" | grep -c '^- ') candidate(s) to $MAYOR"
else
  log "ERROR: mail to $MAYOR failed"
  exit 1
fi
