#!/usr/bin/env python3
"""vault-issues-log-sync: keep a bead-state summary current in each rig's
Obsidian `<Project> Issues Log.md` so the log never goes fully stale even when
a PL misses its VAULT_NOTES morning check.

Split of duties (ZFC): the PL writes the NARRATIVE issue log (the dated
`### YYYY-MM-DD` entries with learnings and fixes) under the standing
VAULT_NOTES directive; that is model work and this script never touches it.
This script does the MECHANICAL part only: it reads the rig's live bead state
(`gc bd --rig <slug> list`) and regenerates a single fenced summary block at the
top of the note. Deterministic counting + formatting, no semantic judgment.

Safety model (mirrors bin/vault-status-mirror):
  * SECTION-SCOPED: only ever rewrites the content BETWEEN the two fence
    markers. If the fence is absent it is inserted right after the first `# `
    H1 line. Manual dated entries below the fence are never read or written, so
    the script cannot clobber a PL's or a human's edits.
  * IDEMPOTENT: a per-note sha256 sentinel under
    ~/.gc/vault-issues-sync-sentinels/. The vault only gets a write when the
    rendered block actually changes, so this does not churn Syncthing.
  * READ-ONLY on beads (`gc bd ... list`); read-mostly on the vault.
  * Codepoint-safe throughout (Python str), never `head -c` byte splits.
  * DRY_RUN=1 prints what it would write and touches nothing.

Generalizable: it walks every `*Issues Log.md` under VAULT_PROJECTS_DIR, maps
the note to a rig via the `project:` frontmatter key, and silently skips any
note whose project does not resolve to a live rig (suspended rigs, or notes
with no rig at all, are left completely untouched).
"""
import os
import re
import sys
import time
import hashlib
import subprocess

VAULT = os.environ.get("VAULT_PROJECTS_DIR", "/home/ds/brain/Projects")
SENTINEL_DIR = os.environ.get(
    "VAULT_ISSUES_SENTINELS",
    os.path.expanduser("~/.gc/vault-issues-sync-sentinels"),
)
AUDIT_LOG = os.environ.get(
    "VAULT_ISSUES_LOG", os.path.expanduser("~/.gc/vault-issues-log-sync.log")
)
DRY_RUN = os.environ.get("DRY_RUN", "") not in ("", "0", "false", "no")

BEGIN = "<!-- gc:issues-log-sync BEGIN (auto; regenerated by the vault-issues-log-sync order — edits inside this fence are overwritten) -->"
END = "<!-- gc:issues-log-sync END -->"
FENCE_RE = re.compile(
    re.escape(BEGIN) + r".*?" + re.escape(END), re.S
)
H1_RE = re.compile(r"^#\s+.+$", re.M)
PROJECT_RE = re.compile(r"^project:\s*(.+?)\s*$", re.M)
TAGS_RE = re.compile(r"project-issues")
# List row, e.g. "  ○ aoa-211 ● P1 [arch-review] Remove dead ..."
#   glyph  id      ●  Pn  title
ROW_RE = re.compile(r"^[│├└─\s]*([○◐●✓❄])\s+(\S+)\s+●\s+(P\d)\s+(.*\S)\s*$")
# Footer, e.g. "Total: 39 issues (34 open, 5 in progress)"
TOTAL_RE = re.compile(r"Total:\s*(\d+)\s+issues(?:\s*\(([^)]*)\))?")


def log(msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}\n"
    try:
        with open(AUDIT_LOG, "a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass
    sys.stderr.write(line)


def gc_bd_list(rig, closed=False):
    """Return (stdout, ok). ok=False on any failure (rig unknown/suspended)."""
    cmd = ["gc", "bd", "--rig", rig, "list"]
    if closed:
        cmd += ["--status", "closed"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    except (subprocess.SubprocessError, OSError):
        return "", False
    if r.returncode != 0:
        return r.stdout, False
    return r.stdout, True


def parse_open(stdout):
    """Return (breakdown_str, [(id, prio, title), ...] for P0/P1)."""
    breakdown = ""
    m = TOTAL_RE.search(stdout)
    if m:
        breakdown = (m.group(2) or f"{m.group(1)} total").strip()
    hi = []
    for line in stdout.splitlines():
        rm = ROW_RE.match(line)
        if rm and rm.group(1) != "✓" and rm.group(3) in ("P0", "P1"):
            hi.append((rm.group(2), rm.group(3), rm.group(4)))
    return breakdown, hi


def parse_closed_count(stdout):
    m = TOTAL_RE.search(stdout)
    return m.group(1) if m else "?"


def render_block(rig, breakdown, hi, closed_n, today):
    lines = [
        BEGIN,
        f"## Bead state (auto-synced {today})",
        "",
        f"- **Open:** {breakdown or 'n/a'} · **Closed:** {closed_n}",
    ]
    if hi:
        lines.append("- **Open P0/P1:**")
        for bid, prio, title in hi:
            # collapse whitespace; strip em dashes from titles (VAULT_NOTES rule)
            t = re.sub(r"\s+", " ", title).replace("—", "-").strip()
            lines.append(f"    - {bid} ({prio}) {t}")
    else:
        lines.append("- **Open P0/P1:** none")
    lines += [
        "",
        f"_Source: `gc bd --rig {rig}`. This block is regenerated by the "
        "`vault-issues-log-sync` order; the dated narrative log below is "
        "human-written and never touched._",
        END,
    ]
    return "\n".join(lines)


def upsert(text, block):
    """Return new note text with the fenced block inserted/replaced. None if unchanged."""
    if FENCE_RE.search(text):
        new = FENCE_RE.sub(lambda _m: block, text, count=1)
    else:
        m = H1_RE.search(text)
        if not m:
            return None  # no H1 anchor; refuse to guess
        insert_at = m.end()
        new = text[:insert_at] + "\n\n" + block + text[insert_at:]
    return new if new != text else None


def note_project(text):
    fm = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not fm:
        return None
    front = fm.group(1)
    if not TAGS_RE.search(front):
        return None
    pm = PROJECT_RE.search(front)
    return pm.group(1).strip() if pm else None


def main():
    if not os.path.isdir(VAULT):
        log(f"ERROR: vault dir absent: {VAULT}")
        return 1
    os.makedirs(SENTINEL_DIR, exist_ok=True)
    today = time.strftime("%Y-%m-%d")

    updated = skipped = norig = failed = 0
    for root, _dirs, files in os.walk(VAULT):
        for name in files:
            if not name.endswith("Issues Log.md"):
                continue
            path = os.path.join(root, name)
            try:
                text = open(path, encoding="utf-8").read()
            except OSError:
                continue
            rig = note_project(text)
            if not rig:
                continue
            out, ok = gc_bd_list(rig)
            if not ok:
                norig += 1  # suspended / unknown rig: leave note untouched
                continue
            cout, _cok = gc_bd_list(rig, closed=True)
            breakdown, hi = parse_open(out)
            closed_n = parse_closed_count(cout)
            block = render_block(rig, breakdown, hi, closed_n, today)

            slug = re.sub(r"[^A-Za-z0-9]+", "-", rig).strip("-").lower()
            sha = hashlib.sha256(block.encode("utf-8")).hexdigest()
            sfile = os.path.join(SENTINEL_DIR, f"{slug}.sha")
            prev = ""
            if os.path.exists(sfile):
                try:
                    prev = open(sfile, encoding="utf-8").read().strip()
                except OSError:
                    prev = ""
            if sha == prev and FENCE_RE.search(text):
                skipped += 1
                continue
            new = upsert(text, block)
            if new is None:
                skipped += 1
                # keep sentinel current even when the block text is unchanged
                if not DRY_RUN:
                    with open(sfile, "w", encoding="utf-8") as fh:
                        fh.write(sha)
                continue
            if DRY_RUN:
                log(f"DRY_RUN would update {path} (rig={rig})")
                sys.stderr.write(block + "\n")
                updated += 1
                continue
            try:
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(new)
                with open(sfile, "w", encoding="utf-8") as fh:
                    fh.write(sha)
                updated += 1
                log(f"synced {path} (rig={rig})")
            except OSError as e:
                failed += 1
                log(f"ERROR: write {path} failed: {e}")

    log(f"tick: updated {updated}, skipped {skipped}, no-rig {norig}, failed {failed}"
        + (" [DRY_RUN]" if DRY_RUN else ""))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
