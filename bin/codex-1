#!/usr/bin/env bash
# codex-1 — launch the primary Codex account with unattended permissions.

set -euo pipefail

unset CODEX_HOME
CODEX_BIN="${CODEX_CLI_BIN:-$HOME/.nvm/versions/node/v22.22.2/bin/codex}"
[[ -x "$CODEX_BIN" ]] \
  || {
    printf 'codex-1: Codex executable is missing: %s\n' "$CODEX_BIN" >&2
    exit 1
  }
exec "$CODEX_BIN" --yolo "$@"
