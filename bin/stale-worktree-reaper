#!/usr/bin/env bash
# stale-worktree-reaper: remove abandoned git worktrees while retaining branches.
#
# Selection criteria (ALL must hold):
#   - Worktree is registered with git (`git worktree list`)
#   - Worktree is locked, OR --include-unlocked was explicitly selected
#   - No live process holds an open file in the worktree
#   - No open/in-progress/blocked bead records that worktree as gc.work_dir
#   - Working tree is clean (no uncommitted changes)
#   - HEAD's last commit is older than $STALE_THRESHOLD (default 24h)
#   - Branch tip IS reachable from the rig's default branch (i.e. work merged)
#
# Action: `git worktree unlock` + non-forced `git worktree remove`. Branch refs
# are retained as a cheap recovery/audit trail.
#
# Default mode is DRY-RUN. Pass --apply to actually clean up.
#
# Companion to stale-claim-reaper. The bead-side reaper unclaims abandoned
# in_progress beads; this one removes the worktree+branch scaffolding the
# same dead workers left behind.
#
# Usage:
#   stale-worktree-reaper                # dry-run report
#   stale-worktree-reaper --apply        # actually clean up
#   stale-worktree-reaper --include-unlocked # include safely merged unlocked trees
#   stale-worktree-reaper --rig codeprobe # scope to one rig
#   stale-worktree-reaper --threshold 7d # custom threshold
#
# Local fallback for the upstream proposal at gascity gc-1b2 (which
# explicitly punts on worktree cleanup).

set -uo pipefail

CITY="${GC_STORE_ROOT:-/home/ds/gas-city}"
AUDIT_LOG="${STALE_WORKTREE_AUDIT_LOG:-${CITY}/.gc/stale-worktree-reaper.log}"
MANIFEST_DIR="${STALE_WORKTREE_MANIFEST_DIR:-${CITY}/.gc/stale-worktree-manifests}"
RUN_LOCK="${STALE_WORKTREE_RUN_LOCK:-${CITY}/.gc/stale-worktree-reaper.lock}"
PROC_ROOT="${STALE_WORKTREE_PROC_ROOT:-/proc}"
OPAQUE_CGROUP_ALLOW_RE="${STALE_WORKTREE_OPAQUE_CGROUP_ALLOW_RE:-}"
OPAQUE_COMMAND_ALLOW_RE="${STALE_WORKTREE_OPAQUE_COMMAND_ALLOW_RE:-}"
STALE_THRESHOLD="${STALE_WORKTREE_THRESHOLD:-24h}"
# Shorter threshold for adopt-pr-*/ship-* worktrees (mayor gc-431319): their PR is
# merged/closed (still gated by the merge-into-default check below), so they are
# safe to reap sooner. Base pool members (polecat-N) never match this pattern AND
# are on detached origin/main (skipped as detached-head), so they are untouched.
SHORT_STALE_THRESHOLD="${STALE_WORKTREE_SHORT_THRESHOLD:-6h}"

APPLY=0
NUDGE_MAYOR=0
ONLY_RIG=""
INCLUDE_UNLOCKED=0
MAX_REMOVE=25
RUN_MANIFEST=""
PROCESS_UNREADABLE_CWD=0
PROCESS_ALLOWED_OPAQUE=0
PROCESS_VISIBILITY_UNVERIFIED=0
PROCESS_UNVERIFIED_DETAILS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)         APPLY=1; shift ;;
    --nudge-mayor)   NUDGE_MAYOR=1; shift ;;
    --include-unlocked) INCLUDE_UNLOCKED=1; shift ;;
    --max-remove)    MAX_REMOVE="$2"; shift 2 ;;
    --threshold)     STALE_THRESHOLD="$2"; shift 2 ;;
    --rig)           ONLY_RIG="$2"; shift 2 ;;
    -h|--help)
      sed -n 's/^# \{0,1\}//p' "$0" | head -25
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$(dirname "$AUDIT_LOG")"

acquire_apply_lock() {
  mkdir -p "$(dirname "$RUN_LOCK")"
  exec {RUN_LOCK_FD}>"$RUN_LOCK"
  flock -n "$RUN_LOCK_FD"
}

threshold_to_seconds() {
  local t="$1" num unit
  num="${t%[a-z]}"
  unit="${t##*[0-9]}"
  case "$unit" in
    s) echo "$num" ;;
    m) echo $((num * 60)) ;;
    h) echo $((num * 3600)) ;;
    d) echo $((num * 86400)) ;;
    *) echo "stale-worktree-reaper: bad threshold '$t'" >&2; exit 2 ;;
  esac
}

# Decide whether a worktree's working-copy state counts as empty/clean and thus
# eligible for reaping. Echoes one of: clean | dirty | unknown.
#
#   - clean   : no uncommitted work; safe to reap (subject to other gates)
#   - dirty   : uncommitted work present; NOT reapable
#   - unknown : the emptiness probe errored or was ambiguous; FAIL CLOSED,
#               i.e. the caller MUST treat this as live (NOT reapable)
#
# Git path (no jj): byte-for-byte the original check — `git status --porcelain`
# line count, where 0 lines == clean.
#
# jj path (only when `jj` is on PATH AND a .jj dir exists in the worktree):
# jj auto-snapshots uncommitted edits into the working-copy commit, so a plain
# `git status` reads clean even with live work. Probe the jj working-copy commit
# instead: reapable only if it is empty AND there are no unpushed changes. Any
# probe error (e.g. `jj log` racing the auto-import) yields "unknown" so the
# caller fails closed. A short retry-with-backoff dodges the transient race.
worktree_emptiness() {
  local wt=$1

  if command -v jj >/dev/null 2>&1 && [[ -d "$wt/.jj" ]]; then
    local attempt out rc
    for attempt in 1 2 3; do
      out=$(jj --repository "$wt" --no-pager --color never log \
              --no-graph -r '@ & empty() & ~description(exact:"")' \
              -T '"x"' 2>/dev/null)
      rc=$?
      if (( rc == 0 )); then
        # The working-copy commit (@) is the empty marker only if it is empty.
        # Separately confirm there are no unpushed (not-on-any-remote) changes.
        local unpushed urc
        unpushed=$(jj --repository "$wt" --no-pager --color never log \
                     --no-graph -r '@ | (remote_bookmarks()..@)' \
                     -T '"x"' 2>/dev/null)
        urc=$?
        if (( urc != 0 )); then
          sleep "0.$((attempt * 2))"
          continue
        fi
        # @ empty (only "x" present from the first probe) AND nothing beyond
        # what is already on a remote (unpushed reduces to just @, i.e. "x").
        if [[ "$out" == "x" && "$unpushed" == "x" ]]; then
          echo clean
        else
          echo dirty
        fi
        return 0
      fi
      sleep "0.$((attempt * 2))"
    done
    # Every attempt errored — fail closed.
    echo unknown
    return 0
  fi

  # Git-only path: identical to the original inline check.
  local status
  if ! status=$(git -C "$wt" status --porcelain 2>/dev/null); then
    echo unknown
  elif [[ -n "$status" ]]; then
    echo dirty
  else
    echo clean
  fi
  return 0
}

THRESHOLD_SECONDS=$(threshold_to_seconds "$STALE_THRESHOLD")
SHORT_THRESHOLD_SECONDS=$(threshold_to_seconds "$SHORT_STALE_THRESHOLD")
NOW_EPOCH=$(date +%s)
CUTOFF_EPOCH=$((NOW_EPOCH - THRESHOLD_SECONDS))
SHORT_CUTOFF_EPOCH=$((NOW_EPOCH - SHORT_THRESHOLD_SECONDS))

# Per-worktree cutoff: adopt-pr-*/ship-* leaf names reap at the shorter threshold
# (merge-check below still gates), everything else at the default.
wt_cutoff_for() {
  local leaf
  leaf=$(basename "$1")
  if [[ "$leaf" == ship-* || "$leaf" == *adopt-pr* ]]; then
    echo "$SHORT_CUTOFF_EPOCH"
  else
    echo "$CUTOFF_EPOCH"
  fi
}

log_event() {
  local event=$1 rig=$2 wt=$3 extra=${4:-'{}'}
  local ts
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  jq -cn --arg ts "$ts" --arg event "$event" --arg rig "$rig" --arg wt "$wt" \
         --argjson extra "$extra" \
    '{ts:$ts, event:$event, rig:$rig, worktree:$wt} + $extra' \
    >> "$AUDIT_LOG"
}

declare -A RIG_PATHS ACTIVE_WORKDIRS ACTIVE_WORKDIRS_OK
LIVE_PROCESS_PATHS=""
LIVE_PROCESS_ARGS=""
ACTIVE_REF_STATE="unknown"

load_rig_paths() {
  local data
  data=$(gc rig list --json 2>/dev/null) || {
    echo "stale-worktree-reaper: gc rig list --json failed; refusing scan" >&2
    return 1
  }
  while IFS=$'\t' read -r rig path; do
    [[ -n "$rig" && -n "$path" ]] && RIG_PATHS["$rig"]="$path"
  done < <(jq -r '.rigs[] | select(.hq != true) | [.name, .path] | @tsv' <<<"$data")
}

load_live_process_paths() {
  local proc fd fd_name fd_names path proc_uid state arg arg0 cmdline cgroup opaque pid
  local own_uid
  LIVE_PROCESS_PATHS=""
  LIVE_PROCESS_ARGS=""
  PROCESS_UNREADABLE_CWD=0
  PROCESS_ALLOWED_OPAQUE=0
  PROCESS_VISIBILITY_UNVERIFIED=0
  PROCESS_UNVERIFIED_DETAILS=""
  own_uid=$(id -u)

  for proc in "$PROC_ROOT"/[0-9]*; do
    [[ -d "$proc" ]] || continue
    proc_uid=$(stat -c '%u' "$proc" 2>/dev/null) || continue
    [[ "$proc_uid" == "$own_uid" ]] || continue
    state=$(awk '/^State:/{print $2; exit}' "$proc/status" 2>/dev/null) || state=""
    [[ "$state" == "Z" ]] && continue

    arg0=""
    cmdline=""
    if [[ -r "$proc/cmdline" ]]; then
      while IFS= read -r -d '' arg; do
        [[ -n "$arg" ]] || continue
        LIVE_PROCESS_ARGS+="$arg"$'\n'
        [[ -n "$arg0" ]] || arg0=$arg
        cmdline+="${cmdline:+ }$arg"
      done < "$proc/cmdline"
    fi

    opaque=0
    path=$(readlink "$proc/cwd" 2>/dev/null) || path=""
    if [[ -n "$path" ]]; then
      LIVE_PROCESS_PATHS+="$path"$'\n'
    elif [[ -d "$proc" ]]; then
      PROCESS_UNREADABLE_CWD=$((PROCESS_UNREADABLE_CWD + 1))
      opaque=1
    fi

    path=$(readlink "$proc/exe" 2>/dev/null) || path=""
    if [[ -n "$path" ]]; then
      LIVE_PROCESS_PATHS+="$path"$'\n'
    elif [[ -d "$proc" ]]; then
      opaque=1
    fi
    # Enumerate through a checked operation. A bare glob cannot distinguish an
    # empty directory from an unreadable directory whose pattern stayed literal.
    if ! fd_names=$(find "$proc/fd" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null); then
      opaque=1
    else
      while IFS= read -r fd_name; do
        [[ -n "$fd_name" ]] || continue
        fd="$proc/fd/$fd_name"
        if ! path=$(readlink "$fd" 2>/dev/null); then
          [[ -e "$fd" || -L "$fd" ]] && opaque=1
          continue
        fi
        if [[ -n "$path" ]]; then
          LIVE_PROCESS_PATHS+="$path"$'\n'
        elif [[ -d "$proc" ]]; then
          opaque=1
        fi
      done <<<"$fd_names"
    fi

    if (( opaque )) && [[ -d "$proc" ]]; then
      state=$(awk '/^State:/{print $2; exit}' "$proc/status" 2>/dev/null) || state=""
      if [[ -z "$state" ]]; then
        if [[ -d "$proc" ]]; then
          pid=${proc##*/}
          PROCESS_VISIBILITY_UNVERIFIED=$((PROCESS_VISIBILITY_UNVERIFIED + 1))
          PROCESS_UNVERIFIED_DETAILS+="pid=$pid arg0=${arg0:-unknown} status=unreadable"$'\n'
        fi
        continue
      fi
      [[ "$state" != "Z" ]] || continue
      cgroup=$(cat "$proc/cgroup" 2>/dev/null) || cgroup=""
      if [[ -n "$OPAQUE_CGROUP_ALLOW_RE" && -n "$OPAQUE_COMMAND_ALLOW_RE" &&
            "$cgroup" =~ $OPAQUE_CGROUP_ALLOW_RE && "$cmdline" =~ $OPAQUE_COMMAND_ALLOW_RE ]]; then
        PROCESS_ALLOWED_OPAQUE=$((PROCESS_ALLOWED_OPAQUE + 1))
      else
        PROCESS_VISIBILITY_UNVERIFIED=$((PROCESS_VISIBILITY_UNVERIFIED + 1))
        pid=${proc##*/}
        PROCESS_UNVERIFIED_DETAILS+="pid=$pid arg0=${arg0:-unknown} cgroup=${cgroup:-unknown}"$'\n'
      fi
    fi
  done
}

path_has_live_process() {
  local wt=$1 path arg
  while IFS= read -r path; do
    [[ "$path" == "$wt" || "$path" == "$wt/"* ]] && return 0
  done <<<"$LIVE_PROCESS_PATHS"
  # A non-dumpable same-user process may hide its cwd from /proc readlink.
  # Command arguments still expose common --cwd/path launch contracts.
  while IFS= read -r arg; do
    [[ -n "$arg" && "$arg" == *"$wt"* ]] && return 0
  done <<<"$LIVE_PROCESS_ARGS"
  return 1
}

process_snapshot_complete() {
  (( PROCESS_VISIBILITY_UNVERIFIED == 0 ))
}

candidate_fields_safe() {
  local field
  for field in "$@"; do
    [[ "$field" != *'|'* && "$field" != *$'\n'* ]] || return 1
  done
}

load_active_workdirs() {
  local rig=$1 rig_path=$2 data paths_json
  ACTIVE_WORKDIRS_OK["$rig"]=0
  data=$(timeout 30 env BD_DISABLE_METRICS=1 BD_DISABLE_EVENT_FLUSH=1 \
    bd -C "$rig_path" list --status open,in_progress,blocked --limit 0 --json 2>/dev/null) || return 1
  # Both transport and schema must validate. Malformed JSON or a non-string
  # work_dir is an unknown store state, never an empty active set.
  paths_json=$(jq -ce '
    if type != "array" then error("expected array")
    else [.[] | (.metadata["gc.work_dir"] // .metadata["work_dir"] // null)
                  | select(. != null)
                  | if type == "string" then . else error("work_dir must be string") end]
    end' <<<"$data") || return 1
  ACTIVE_WORKDIRS["$rig"]=$(jq -r '.[]' <<<"$paths_json")$'\n' || return 1
  ACTIVE_WORKDIRS_OK["$rig"]=1
}

active_workdir_state() {
  local rig=$1 rig_path=$2 wt=$3 path
  ACTIVE_REF_STATE="unknown"
  if [[ -z "${ACTIVE_WORKDIRS_OK[$rig]+set}" ]]; then
    load_active_workdirs "$rig" "$rig_path" || true
  fi
  [[ "${ACTIVE_WORKDIRS_OK[$rig]:-0}" == "1" ]] || return
  while IFS= read -r path; do
    [[ "$path" == "$wt" ]] && { ACTIVE_REF_STATE="active"; return; }
  done <<<"${ACTIVE_WORKDIRS[$rig]:-}"
  ACTIVE_REF_STATE="clear"
}

# Resolve a rig's default branch. Falls back to "main" if not detectable.
default_branch() {
  local rig_path=$1
  # Prefer the symbolic ref of origin/HEAD if set.
  local sym
  sym=$(git -C "$rig_path" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || true
  if [[ -n "$sym" ]]; then
    echo "${sym##*/}"
    return
  fi
  # Fallback: prefer main, then master.
  if git -C "$rig_path" show-ref --verify --quiet refs/heads/main; then echo "main"; return; fi
  if git -C "$rig_path" show-ref --verify --quiet refs/heads/master; then echo "master"; return; fi
  echo "main"
}

start_manifest() {
  mkdir -p "$MANIFEST_DIR" || return 1
  local stamp
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  RUN_MANIFEST="$MANIFEST_DIR/${stamp}-$$.jsonl"
  : > "$RUN_MANIFEST" || return 1
  chmod 600 "$RUN_MANIFEST" || return 1
  sync -f "$RUN_MANIFEST"
}

# Return a bounded summary of ignored artifacts without enumerating every file
# in large build caches. `git status --ignored=matching` collapses fully ignored
# directories (for example target/) into a single entry.
ignored_artifact_summary() {
  local wt=$1 entry rel size_kib
  local -a summaries=()
  while IFS= read -r -d '' entry; do
    [[ "$entry" == "!! "* ]] || continue
    rel=${entry:3}
    size_kib=$(du -sk -- "$wt/$rel" 2>/dev/null | awk '{print $1}' | head -1)
    [[ "$size_kib" =~ ^[0-9]+$ ]] || size_kib=0
    summaries+=("$rel:${size_kib}KiB")
    (( ${#summaries[@]} >= 20 )) && break
  done < <(git -C "$wt" status --porcelain=v1 -z --ignored=matching \
            --untracked-files=normal 2>/dev/null)

  local IFS=';'
  printf '%s' "${summaries[*]:-none}"
}

manifest_eligibility() {
  local rig=$1 wt=$2 branch=$3 tip=$4 default_br=$5 default_sha=$6 size_kib=$7
  local ignored_summary
  ignored_summary=$(ignored_artifact_summary "$wt")
  jq -cn \
    --arg event "eligible" \
    --arg ts "$(date -Iseconds)" \
    --arg rig "$rig" \
    --arg path "$wt" \
    --arg branch "$branch" \
    --arg tip_sha "$tip" \
    --arg default_branch "$default_br" \
    --arg default_sha "$default_sha" \
    --arg ignored_summary "$ignored_summary" \
    --arg unverified_process_details "$PROCESS_UNVERIFIED_DETAILS" \
    --argjson size_kib "$size_kib" \
    --argjson unreadable_process_cwds "$PROCESS_UNREADABLE_CWD" \
    --argjson allowed_opaque_processes "$PROCESS_ALLOWED_OPAQUE" \
    --argjson unverified_processes "$PROCESS_VISIBILITY_UNVERIFIED" \
    '{event:$event,eligibility_ts:$ts,rig:$rig,path:$path,branch:$branch,tip_sha:$tip_sha,
      default_branch:$default_branch,default_sha:$default_sha,size_kib:$size_kib,
      ignored_artifacts:$ignored_summary,unreadable_process_cwds:$unreadable_process_cwds,
      allowed_opaque_processes:$allowed_opaque_processes,unverified_processes:$unverified_processes,
      unverified_process_details:$unverified_process_details}' \
    >> "$RUN_MANIFEST" || return 1
  sync -f "$RUN_MANIFEST"
}

manifest_result() {
  local rig=$1 wt=$2 branch=$3 tip=$4 result=$5 detail=${6:-}
  jq -cn \
    --arg event "result" \
    --arg ts "$(date -Iseconds)" \
    --arg rig "$rig" \
    --arg path "$wt" \
    --arg branch "$branch" \
    --arg tip_sha "$tip" \
    --arg removal_result "$result" \
    --arg detail "$detail" \
    '{event:$event,ts:$ts,rig:$rig,path:$path,branch:$branch,tip_sha:$tip_sha,
      removal_result:$removal_result,detail:$detail}' \
    >> "$RUN_MANIFEST" || return 1
  sync -f "$RUN_MANIFEST"
}

CANDIDATE_MISMATCH=""

worktree_is_registered() {
  local rig_path=$1 wt=$2
  # Consume the full porcelain stream. `grep -q` can close the pipe after an
  # early match, making git exit on SIGPIPE and turning a true match into a
  # false negative under `set -o pipefail`.
  git -C "$rig_path" worktree list --porcelain 2>/dev/null \
    | awk -v wanted="worktree $wt" '$0 == wanted { found=1 } END { exit !found }'
}

# Re-check immutable candidate identity and reachability immediately before
# deletion. Any drift from the scan snapshot is a skip, not a best-effort reap.
candidate_identity_matches() {
  local rig_path=$1 wt=$2 branch=$3 scanned_tip=$4 default_br=$5 scanned_default_sha=$6
  local actual_branch actual_tip branch_tip actual_default emptiness
  CANDIDATE_MISMATCH=""

  if ! worktree_is_registered "$rig_path" "$wt"; then
    CANDIDATE_MISMATCH="worktree is no longer registered"
    return 1
  fi
  actual_branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null) || actual_branch=""
  if [[ "$actual_branch" != "$branch" ]]; then
    CANDIDATE_MISMATCH="branch changed from $branch to ${actual_branch:-detached}"
    return 1
  fi
  actual_tip=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || actual_tip=""
  branch_tip=$(git -C "$rig_path" rev-parse "refs/heads/$branch" 2>/dev/null) || branch_tip=""
  if [[ "$actual_tip" != "$scanned_tip" || "$branch_tip" != "$scanned_tip" ]]; then
    CANDIDATE_MISMATCH="tip changed from $scanned_tip"
    return 1
  fi
  actual_default=$(git -C "$rig_path" rev-parse "refs/heads/$default_br" 2>/dev/null) || actual_default=""
  if [[ "$actual_default" != "$scanned_default_sha" ]]; then
    CANDIDATE_MISMATCH="default branch changed from $scanned_default_sha"
    return 1
  fi
  if ! git -C "$rig_path" merge-base --is-ancestor "$scanned_tip" "$scanned_default_sha" 2>/dev/null; then
    CANDIDATE_MISMATCH="tip is no longer reachable from scanned default"
    return 1
  fi
  emptiness=$(worktree_emptiness "$wt")
  if [[ "$emptiness" != "clean" ]]; then
    CANDIDATE_MISMATCH="worktree is no longer clean ($emptiness)"
    return 1
  fi
}

final_revalidate() {
  local rig=$1 rig_path=$2 wt=$3 branch=$4 tip=$5 default_br=$6 default_sha=$7
  # Query the potentially slow external bead store first, then close its race
  # window with process and exact Git identity checks.
  unset 'ACTIVE_WORKDIRS_OK[$rig]' 'ACTIVE_WORKDIRS[$rig]'
  active_workdir_state "$rig" "$rig_path" "$wt"
  if [[ "$ACTIVE_REF_STATE" != "clear" ]]; then
    CANDIDATE_MISMATCH="active bead reference state is $ACTIVE_REF_STATE"
    return 1
  fi

  load_live_process_paths
  if ! process_snapshot_complete; then
    CANDIDATE_MISMATCH="process visibility incomplete for $PROCESS_VISIBILITY_UNVERIFIED live process(es)"
    return 1
  fi
  if path_has_live_process "$wt"; then
    CANDIDATE_MISMATCH="live process references worktree"
    return 1
  fi

  if ! candidate_identity_matches "$rig_path" "$wt" "$branch" "$tip" "$default_br" "$default_sha"; then
    return 1
  fi
}

reaped=()        # rig|worktree|branch|tip|default-branch|default-sha|size-kib
skipped=()       # rig|worktree|reason
candidates=0

scan_rig() {
  local rig=$1
  local rig_path=${RIG_PATHS[$rig]:-}
  [[ -n "$rig_path" ]] || return 0
  [[ -d "$rig_path/.git" || -f "$rig_path/.git" ]] || return 0

  local default_br default_sha
  default_br=$(default_branch "$rig_path")
  default_sha=$(git -C "$rig_path" rev-parse "refs/heads/$default_br" 2>/dev/null) || {
    log_event "skipped_rig_default_unresolved" "$rig" "$rig_path" \
      "$(jq -cn --arg b "$default_br" '{default_branch:$b}')"
    return 0
  }

  # Walk all worktrees registered in this rig (excluding the primary one).
  while IFS= read -r wt_path; do
    [[ -z "$wt_path" ]] && continue
    # Skip the primary checkout (always the rig path itself).
    [[ "$wt_path" == "$rig_path" ]] && continue
    candidates=$((candidates + 1))

    # Get porcelain-format details.
    local porcelain branch is_locked
    porcelain=$(git -C "$rig_path" worktree list --porcelain 2>/dev/null \
                | awk -v p="$wt_path" 'BEGIN{found=0} /^worktree / {found=(substr($0,10)==p)} found {print}')
    branch=$(awk '/^branch /{sub("refs/heads/",""); print $2; exit}' <<<"$porcelain")
    is_locked=0
    grep -q '^locked' <<<"$porcelain" && is_locked=1

    if (( !is_locked && !INCLUDE_UNLOCKED )); then
      log_event "skipped_not_locked" "$rig" "$wt_path" \
        "$(jq -cn --arg b "$branch" '{branch:$b}')"
      skipped+=("$rig|$wt_path|not-locked")
      continue
    fi

    # Live process check, using one bounded /proc snapshot rather than lsof +D
    # (which traverses every file and wedged on 19G result-heavy worktrees).
    if path_has_live_process "$wt_path"; then
      log_event "skipped_live_process" "$rig" "$wt_path" '{}'
      skipped+=("$rig|$wt_path|live-process")
      continue
    fi

    # A routed/parked bead may own a worktree even while no process currently
    # has it open. Query once per rig and fail closed on any store/query error.
    local ref_state
    active_workdir_state "$rig" "$rig_path" "$wt_path"
    ref_state=$ACTIVE_REF_STATE
    if [[ "$ref_state" != "clear" ]]; then
      log_event "skipped_active_reference" "$rig" "$wt_path" \
        "$(jq -cn --arg state "$ref_state" '{state:$state}')"
      skipped+=("$rig|$wt_path|active-reference-$ref_state")
      continue
    fi

    # Uncommitted / live work? (git-aware by default, jj-aware when applicable)
    local emptiness
    emptiness=$(worktree_emptiness "$wt_path")
    if [[ "$emptiness" == "dirty" ]]; then
      # Preserve the original git-path diagnostic: count of porcelain lines.
      local dirty
      dirty=$(git -C "$wt_path" status --porcelain 2>/dev/null | wc -l)
      log_event "skipped_dirty" "$rig" "$wt_path" \
        "$(jq -cn --arg d "$dirty" '{dirty_files:$d}')"
      skipped+=("$rig|$wt_path|dirty")
      continue
    fi
    if [[ "$emptiness" != "clean" ]]; then
      # FAIL CLOSED: an errored/ambiguous jj probe is treated as live work.
      log_event "skipped_emptiness_unknown" "$rig" "$wt_path" \
        "$(jq -cn --arg p "$emptiness" '{probe:$p}')"
      skipped+=("$rig|$wt_path|emptiness-unknown")
      continue
    fi

    # Last-commit staleness (per-worktree cutoff: adopt-pr-*/ship-* use the shorter one).
    local last_epoch wt_cutoff
    last_epoch=$(git -C "$wt_path" log -1 --format=%ct HEAD 2>/dev/null) || continue
    wt_cutoff=$(wt_cutoff_for "$wt_path")
    if (( last_epoch >= wt_cutoff )); then
      log_event "skipped_recent" "$rig" "$wt_path" \
        "$(jq -cn --arg t "$last_epoch" --arg c "$wt_cutoff" '{last_commit_epoch:$t, cutoff:$c}')"
      skipped+=("$rig|$wt_path|recent-commit")
      continue
    fi

    # Reachability from default branch (only delete if merged).
    if [[ -z "$branch" ]]; then
      log_event "skipped_detached" "$rig" "$wt_path" '{}'
      skipped+=("$rig|$wt_path|detached-head")
      continue
    fi
    local tip head_tip
    tip=$(git -C "$rig_path" rev-parse "refs/heads/$branch" 2>/dev/null) || continue
    head_tip=$(git -C "$wt_path" rev-parse HEAD 2>/dev/null) || continue
    if [[ "$tip" != "$head_tip" ]]; then
      log_event "skipped_tip_mismatch" "$rig" "$wt_path" \
        "$(jq -cn --arg b "$branch" --arg bt "$tip" --arg ht "$head_tip" \
              '{branch:$b, branch_tip:$bt, head_tip:$ht}')"
      skipped+=("$rig|$wt_path|tip-mismatch")
      continue
    fi
    if ! git -C "$rig_path" merge-base --is-ancestor "$tip" "$default_sha" 2>/dev/null; then
      log_event "skipped_unmerged" "$rig" "$wt_path" \
        "$(jq -cn --arg b "$branch" --arg db "$default_br" \
              '{branch:$b, default_branch:$db}')"
      skipped+=("$rig|$wt_path|unmerged-into-$default_br")
      continue
    fi
    if ! candidate_fields_safe "$rig" "$rig_path" "$wt_path" "$branch" "$default_br"; then
      log_event "skipped_unsafe_record_field" "$rig" "$wt_path" \
        "$(jq -cn --arg b "$branch" --arg db "$default_br" \
              '{branch:$b, default_branch:$db, reason:"pipe-or-newline"}')"
      skipped+=("$rig|$wt_path|unsafe-record-field")
      continue
    fi

    local size_kib
    size_kib=$(timeout 30 du -sk "$wt_path" 2>/dev/null | awk '{print $1}')
    [[ "$size_kib" =~ ^[0-9]+$ ]] || size_kib=0
    reaped+=("$rig|$wt_path|$branch|$tip|$default_br|$default_sha|$size_kib")
    log_event "stale_worktree_detected" "$rig" "$wt_path" \
      "$(jq -cn --arg b "$branch" --arg tip "$tip" --arg db "$default_br" \
                  --arg ds "$default_sha" --arg t "$STALE_THRESHOLD" \
                  --argjson kib "$size_kib" \
            '{branch:$b, tip_sha:$tip, default_branch:$db, default_sha:$ds,
              threshold:$t, size_kib:$kib}')"
  done < <(git -C "$rig_path" worktree list --porcelain 2>/dev/null \
           | sed -n 's/^worktree //p')
}

# Allow tests to source this script and exercise the decision functions
# without triggering a full scan. (No effect when executed directly.)
if [[ "${STALE_WORKTREE_REAPER_LIB:-0}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

[[ "$MAX_REMOVE" =~ ^[0-9]+$ ]] && (( MAX_REMOVE > 0 )) || {
  echo "stale-worktree-reaper: --max-remove must be a positive integer" >&2
  exit 2
}
if (( APPLY )) && ! acquire_apply_lock; then
  echo "stale-worktree-reaper: another apply run is active; exiting safely" >&2
  log_event "apply_already_running" "city" "$RUN_LOCK" '{}'
  exit 0
fi
load_rig_paths || exit 1
load_live_process_paths
if (( APPLY )) && ! process_snapshot_complete; then
  echo "stale-worktree-reaper: process visibility incomplete for $PROCESS_VISIBILITY_UNVERIFIED live process(es); refusing apply" >&2
  log_event "apply_process_visibility_incomplete" "city" "$PROC_ROOT" \
    "$(jq -cn --arg details "$PROCESS_UNVERIFIED_DETAILS" \
          --argjson n "$PROCESS_VISIBILITY_UNVERIFIED" \
          '{unverified_processes:$n, details:$details}')"
  exit 1
fi

if [[ -n "$ONLY_RIG" ]]; then
  scan_rig "$ONLY_RIG"
else
  for rig in "${!RIG_PATHS[@]}"; do
    scan_rig "$rig"
  done
fi

# Apply the removal cap to the largest proven-safe trees first. Records are
# newline-delimited and worktree paths containing newlines are unsupported by
# git's own porcelain parser above; spaces remain intact.
if (( ${#reaped[@]} > 1 )); then
  mapfile -t reaped < <(printf '%s\n' "${reaped[@]}" | sort -t'|' -k7,7nr)
fi

count=${#reaped[@]}

out=$(mktemp)
trap 'rm -f "$out"' EXIT
{
  echo "stale-worktree-reaper: ${count} stale worktree(s) detected (threshold: $STALE_THRESHOLD, candidates: $candidates, skipped: ${#skipped[@]})"
  if (( count > 0 )); then
    echo
    printf '%-22s %-60s %-28s %10s\n' RIG WORKTREE BRANCH GiB
    printf '%-22s %-60s %-28s %10s\n' --- -------- ------ ---
    for row in "${reaped[@]}"; do
      IFS='|' read -r rig wt branch tip default_br default_sha size_kib <<<"$row"
      size_gib=$(awk -v kib="$size_kib" 'BEGIN {printf "%.1f", kib/1048576}')
      printf '%-22s %-60s %-28s %10s\n' "$rig" "$wt" "$branch" "$size_gib"
    done
    echo
    if (( APPLY )); then
      echo "Mode: APPLY (removing up to $MAX_REMOVE worktrees; branch refs retained)"
    else
      echo "Mode: DRY-RUN (re-run with --apply to clean up)"
    fi
  fi
} > "$out"

cat "$out"

reaped_ok=0
if (( APPLY )) && (( count > 0 )); then
  if ! start_manifest; then
    echo "stale-worktree-reaper: cannot create durable pre-removal manifest; refusing apply" >&2
    log_event "apply_manifest_unavailable" "city" "$MANIFEST_DIR" '{}'
    exit 1
  fi
  for row in "${reaped[@]}"; do
    (( reaped_ok >= MAX_REMOVE )) && break
    IFS='|' read -r rig wt branch tip default_br default_sha size_kib <<<"$row"
    rig_path=${RIG_PATHS[$rig]}

    # Eligibility may be minutes old after a fleet scan. Revalidate the exact
    # registered worktree, tip, default SHA, clean state, processes and beads.
    if ! final_revalidate "$rig" "$rig_path" "$wt" "$branch" "$tip" "$default_br" "$default_sha"; then
      log_event "reap_skipped_final_revalidation" "$rig" "$wt" \
        "$(jq -cn --arg reason "$CANDIDATE_MISMATCH" --arg tip "$tip" \
              '{reason:$reason, tip_sha:$tip}')"
      manifest_eligibility "$rig" "$wt" "$branch" "$tip" "$default_br" "$default_sha" "$size_kib" \
        && manifest_result "$rig" "$wt" "$branch" "$tip" "skipped" "$CANDIDATE_MISMATCH" || {
          echo "stale-worktree-reaper: manifest write failed; aborting apply" >&2
          exit 1
        }
      continue
    fi

    # Persist the complete recovery record before the destructive operation.
    if ! manifest_eligibility "$rig" "$wt" "$branch" "$tip" "$default_br" "$default_sha" "$size_kib"; then
      echo "stale-worktree-reaper: pre-removal manifest write failed; refusing deletion" >&2
      log_event "reap_manifest_write_failed" "$rig" "$wt" \
        "$(jq -cn --arg tip "$tip" '{tip_sha:$tip}')"
      exit 1
    fi

    # Manifest collection can touch a large ignored cache. Close that window
    # with one final exact revalidation immediately before removal.
    if ! final_revalidate "$rig" "$rig_path" "$wt" "$branch" "$tip" "$default_br" "$default_sha"; then
      log_event "reap_skipped_post_manifest_revalidation" "$rig" "$wt" \
        "$(jq -cn --arg reason "$CANDIDATE_MISMATCH" --arg tip "$tip" \
              '{reason:$reason, tip_sha:$tip}')"
      if ! manifest_result "$rig" "$wt" "$branch" "$tip" "skipped" "$CANDIDATE_MISMATCH"; then
        echo "stale-worktree-reaper: manifest result write failed; aborting apply" >&2
        exit 1
      fi
      continue
    fi

    local_porcelain=$(git -C "$rig_path" worktree list --porcelain 2>/dev/null \
      | awk -v p="$wt" 'BEGIN{found=0} /^worktree / {found=(substr($0,10)==p)} found {print}')
    was_locked=0
    grep -q '^locked' <<<"$local_porcelain" && was_locked=1
    git -C "$rig_path" worktree unlock "$wt" 2>/dev/null || true
    # No --force: git performs a final clean-state check at deletion time.
    # Keep the branch ref as a cheap audit/recovery trail.
    if git -C "$rig_path" worktree remove "$wt" 2>/dev/null; then
      reaped_ok=$((reaped_ok + 1))
      retained_tip=$(git -C "$rig_path" rev-parse "refs/heads/$branch" 2>/dev/null || true)
      branch_retained_exact=false
      [[ "$retained_tip" == "$tip" ]] && branch_retained_exact=true
      log_event "stale_worktree_reaped" "$rig" "$wt" \
        "$(jq -cn --arg b "$branch" --arg tip "$tip" --arg retained "$retained_tip" \
                    --argjson kib "$size_kib" --argjson exact "$branch_retained_exact" \
              '{branch:$b, tip_sha:$tip, retained_tip_sha:$retained, size_kib:$kib,
                branch_retained_exact:$exact}')"
      if ! manifest_result "$rig" "$wt" "$branch" "$tip" "removed" \
           "branch_retained_exact=$branch_retained_exact retained_tip=$retained_tip"; then
        echo "stale-worktree-reaper: removal succeeded but manifest result write failed; stopping" >&2
        log_event "reap_manifest_result_failed" "$rig" "$wt" \
          "$(jq -cn --arg tip "$tip" '{tip_sha:$tip, removal_succeeded:true}')"
        exit 1
      fi
    else
      if (( was_locked )) && worktree_is_registered "$rig_path" "$wt"; then
        git -C "$rig_path" worktree lock --reason "stale-worktree-reaper removal failed" "$wt" 2>/dev/null || true
      fi
      log_event "reap_failed" "$rig" "$wt" \
        "$(jq -cn --arg b "$branch" --arg tip "$tip" '{branch:$b, tip_sha:$tip}')"
      if ! manifest_result "$rig" "$wt" "$branch" "$tip" "failed" "git worktree remove refused"; then
        echo "stale-worktree-reaper: manifest result write failed; stopping" >&2
        exit 1
      fi
    fi
  done
  echo
  echo "Reaped $reaped_ok of $count worktree(s); branch refs retained."
  echo "Manifest: $RUN_MANIFEST"
fi

if (( NUDGE_MAYOR )) && (( count > 0 )); then
  if (( APPLY )); then
    action="Autonomous bounded pruning reaped $reaped_ok worktree(s). Manifest: $RUN_MANIFEST"
  else
    action="Dry-run only; use --apply after the autonomous safety audit."
  fi
  msg="stale-worktree-reaper: $count stale worktree(s) detected
$(cat "$out")

Likely cause: orchestrator process died before reaching its worktree-teardown phase.
$action
Tracking upstream as gascity gc-1b2 (worktree side currently out of scope)."
  gc session nudge mayor "$msg" 2>/dev/null \
    || echo "warn: gc session nudge mayor failed; report still in audit log" >&2
fi

exit 0
