#!/usr/bin/env bash
# routed-bead-nudger: periodic backstop for the warm-pool-idle stall.
#
# The problem: `gc sling` stamps gc.routed_to on a bead but does NOT wake
# a warm/asleep pool (gastownhall/gascity#1129, by-design). The event-
# triggered bin/nudge-on-route only nudges sessions ALREADY in 'active'
# state and is idempotent-once — so a bead routed to an asleep pool, or
# whose single nudge failed, sits unclaimed indefinitely. Seen on zelda,
# codeprobe, geo, and the gascity polecats.
#
# This script is the periodic sweep. Every tick it:
#   1. Scans every rig for OPEN beads that have gc.routed_to set, no
#      assignee, and were last updated more than $THRESHOLD ago (the
#      delay gives nudge-on-route's fast path first crack).
#   2. Groups those beads by target pool. For each pool with a stale
#      unclaimed queue it WAKES one session (if none is active) and
#      nudges it once — the pool then claims its own queue. One nudge
#      per pool per tick, never one-per-bead.
#   3. Honors a per-pool cooldown ($COOLDOWN) so a still-stalled pool is
#      retried on later ticks without thrashing every tick.
#   4. Refreshes the csu usage cache (~/.claude-usage/usage_cache.json)
#      so gc-capacity stays current regardless of auto-pick cadence.
#
# Default mode is DRY-RUN. Pass --apply to actually wake/nudge.
#
# Usage:
#   routed-bead-nudger                 # dry-run report
#   routed-bead-nudger --apply         # wake + nudge for real
#   routed-bead-nudger --apply --nudge-mayor   # mail mayor if it acted
#   routed-bead-nudger --threshold 5m  # custom staleness threshold
#   routed-bead-nudger --no-csu        # skip the csu cache refresh
set -uo pipefail

CITY="${GC_STORE_ROOT:-/home/ds/gas-city}"
AUDIT_LOG="${ROUTED_NUDGER_AUDIT_LOG:-${CITY}/.gc/routed-bead-nudger.log}"
STATE_FILE="${ROUTED_NUDGER_STATE:-${CITY}/.gc/routed-bead-nudger-state.json}"
THRESHOLD="${ROUTED_NUDGER_THRESHOLD:-10m}"
COOLDOWN="${ROUTED_NUDGER_COOLDOWN:-20m}"
CSU_BIN="${ROUTED_NUDGER_CSU:-csu}"

APPLY=0
NUDGE_MAYOR=0
DO_CSU=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)        APPLY=1; shift ;;
    --nudge-mayor)  NUDGE_MAYOR=1; shift ;;
    --threshold)    THRESHOLD="$2"; shift 2 ;;
    --cooldown)     COOLDOWN="$2"; shift 2 ;;
    --no-csu)       DO_CSU=0; shift ;;
    -h|--help)      sed -n 's/^# \{0,1\}//p' "$0" | head -30; exit 0 ;;
    *) echo "routed-bead-nudger: unknown arg: $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$(dirname "$AUDIT_LOG")"
[[ -f "$STATE_FILE" ]] || echo '{}' > "$STATE_FILE"

dur_to_seconds() {
  local t="$1" num unit
  num="${t%[smhd]}"
  unit="${t##*[0-9]}"
  case "$unit" in
    s) echo "$num" ;;
    m) echo $((num * 60)) ;;
    h) echo $((num * 3600)) ;;
    d) echo $((num * 86400)) ;;
    *) echo "routed-bead-nudger: bad duration '$t' (use e.g. 10m, 1h)" >&2; exit 2 ;;
  esac
}

THRESHOLD_SECONDS=$(dur_to_seconds "$THRESHOLD")
COOLDOWN_SECONDS=$(dur_to_seconds "$COOLDOWN")
# Dead-pool escalation cooldown: a pool with routed-but-unclaimed beads and
# ZERO live sessions is surfaced to mayor at most once per this window (nudging
# cannot wake a pool that has no sessions, so we escalate instead of silently
# retrying every tick). Long window so mayor isn't spammed every 15m.
ESCALATE_COOLDOWN_SECONDS="${GC_NUDGER_ESCALATE_COOLDOWN_SECONDS:-3600}"
NOW_EPOCH=$(date +%s)
CUTOFF_EPOCH=$((NOW_EPOCH - THRESHOLD_SECONDS))

log_event() {
  # log_event <event> <pool> <extra-json>
  local event=$1 pool=$2 extra=${3:-'{}'}
  jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         --arg event "$event" --arg pool "$pool" \
         --argjson extra "$extra" \
    '{ts:$ts, event:$event, pool:$pool} + $extra' >> "$AUDIT_LOG"
}

state=$(cat "$STATE_FILE")

# pool -> count of stale unclaimed beads; pool -> sample bead id;
# pool -> rig the beads live in (needed for the just-in-time recheck).
declare -A POOL_COUNT
declare -A POOL_SAMPLE
declare -A POOL_RIG
# Molecule roots parked at a human-review gate (dr-azyap). Populated per-rig in
# scan_rig from any OPEN bead whose gc.step_ref ends in '.human-gate' — the
# checkpoint a HUMAN closes, never the polecat (see mol-adopt-pr.human-gate).
# Such a root sits open+routed+unclaimed while it waits, so without this guard
# the sweep re-wakes a fresh polecat every tick; the polecat re-reads
# `bd mol current`, sees the gate, and idles again — the PL re-route loop.
# Skipping it here is self-healing: once the human closes the gate the parent
# leaves this set and nudging resumes (finalize is picked up "when nudged").
declare -A GATED_ROOT

# All rig names from `gc rig list`.
rigs=()
while IFS= read -r rig; do
  [[ -n "$rig" ]] && rigs+=("$rig")
done < <(gc rig list 2>/dev/null | awk '
  /^  [a-zA-Z][a-zA-Z0-9_-]+:/ { name=$1; sub(/:$/,"",name); print name }')

# Beads a pool may be nudged toward. graph.v2 marks a molecule CONTAINER with
# gc.kind=workflow. A container is never claimable: the controller advances it
# implicitly as its leaves close. But it inherits the pool in gc.routed_to, so
# without this filter it matches (routed_to == pool && no assignee) forever and
# the pool is nudged toward it every tick — even once all its real leaves are
# closed and there is nothing left for a worker to do.
#
# Nudging a worker toward a container is not merely noise: the container's
# description IS the formula body, whose finalize step says "close the bead".
# A worker that obeys the nudge hand-executes that step and closes the target
# with no review gate — routing AROUND a disarm applied only to the leaf
# (EnterpriseBench-8brs5, re-introducing EnterpriseBench-coada).
#
# Deliberately NOT filtered here: gc.kind=workflow-finalize. Those carry
# gc.routed_to=core.control-dispatcher (the worker pool is in the separate
# gc.execution_routed_to), so they only ever nudge the CONTROLLER about its own
# finalize backlog — never a worker. Excluding them would suppress a nudge that
# is plausibly what unwedges a stalled dispatcher, and would do nothing for the
# bug above. Same for kind=retry / scope-check.
#
# The authority on what a worker may claim is `gc hook --claim`; this predicate
# exists to keep the nudger from contradicting it. Anything else (a plain step
# bead with no gc.kind) stays claimable, so non-graph rigs are unaffected.
is_nudgeable_kind() {
  [[ "${1:-}" != "workflow" ]]
}

scan_rig() {
  local rig=$1 open_json ready_json rid
  open_json=$(gc bd --rig "$rig" list --status=open --json --limit=0 2>/dev/null || echo '[]')
  [[ -z "$open_json" || "$open_json" == "[]" ]] && return 0

  # Readiness gate (gc-xk1hg): 'open' is not 'claimable'. A step bead with
  # unmet dependencies is open but blocked; offering it produces a no-op
  # polecat that idles or force-runs a step outside its molecule order.
  # Build the ready set once per rig alongside the open list.
  local -A READY_SET=()
  ready_json=$(gc bd --rig "$rig" ready --json --limit=0 2>/dev/null || echo '[]')
  while IFS= read -r rid; do READY_SET["$rid"]=1; done < <(jq -r '.[].id' <<<"$ready_json" 2>/dev/null)

  # Record the parent molecule root of every OPEN human-gate step in this rig.
  # gc.step_ref ending in '.human-gate' marks the human-review checkpoint; its
  # .parent is the molecule root that is parked waiting for a human (dr-azyap).
  local gated_parent
  while IFS= read -r gated_parent; do
    [[ -n "$gated_parent" ]] && GATED_ROOT["$gated_parent"]=1
  done < <(jq -r '[.[]
      | select(((.metadata // {})["gc.step_ref"] // "") | endswith(".human-gate"))
      | .parent // empty] | .[]' <<<"$open_json" 2>/dev/null)

  while IFS= read -r bead_json; do
    [[ -z "$bead_json" ]] && continue
    local bead_id assignee updated_at routed_to nudge_hold step_ref kind upd_epoch
    bead_id=$(jq -r '.id // ""' <<<"$bead_json")
    assignee=$(jq -r '.assignee // ""' <<<"$bead_json")
    updated_at=$(jq -r '.updated_at // ""' <<<"$bead_json")
    routed_to=$(jq -r '(.metadata // {}) | (."gc.routed_to" // "")' <<<"$bead_json")
    nudge_hold=$(jq -r '(.metadata // {}) | (."gc.nudge_hold" // "")' <<<"$bead_json")
    step_ref=$(jq -r '(.metadata // {}) | (."gc.step_ref" // "")' <<<"$bead_json")
    kind=$(jq -r '(.metadata // {}) | (."gc.kind" // "")' <<<"$bead_json")

    [[ -z "$bead_id" ]] && continue
    [[ -z "$routed_to" ]] && continue          # not routed
    [[ -n "$assignee" ]] && continue           # already claimed
    [[ -n "$nudge_hold" ]] && continue         # operator-held: routed+unclaimed on purpose, do not nudge
    [[ "$step_ref" == *.human-gate ]] && continue   # a human-gate step itself — closed by a human, never nudge
    is_nudgeable_kind "$kind" || continue      # molecule container — never claimable, see is_nudgeable_kind
    [[ -n "${READY_SET[$bead_id]:-}" ]] || continue  # readiness gate (gc-xk1hg): open != claimable
    if [[ -n "${GATED_ROOT[$bead_id]:-}" ]]; then    # molecule parked at a human gate — skip the re-route loop
      log_event "human-gate-parked-skip" "$routed_to" "$(jq -cn --arg b "$bead_id" '{bead:$b}')"
      continue
    fi
    [[ -z "$updated_at" ]] && continue
    upd_epoch=$(date -d "$updated_at" +%s 2>/dev/null) || continue
    (( upd_epoch >= CUTOFF_EPOCH )) && continue # too fresh — let nudge-on-route try first

    POOL_COUNT["$routed_to"]=$(( ${POOL_COUNT["$routed_to"]:-0} + 1 ))
    POOL_SAMPLE["$routed_to"]="$bead_id"
    POOL_RIG["$routed_to"]="$rig"
  done < <(jq -c '.[]' <<<"$open_json" 2>/dev/null)
}

for rig in "${rigs[@]}"; do
  scan_rig "$rig"
done

# recheck_pool_unclaimed <routed_to> <rig> -> echoes "<count>:<sample_bead>"
# Just-in-time assignee recheck. The POOL_COUNT/POOL_SAMPLE snapshot was taken
# at the start of the tick; between then and now a warm slot's self-poll (or a
# prior nudge) may have claimed some or all of the queue. Re-query the rig's
# open beads RIGHT BEFORE nudging and keep only the beads still routed to this
# pool AND still unassigned. Returns "0:" when nothing is still-unclaimed, so
# the caller can skip the pool and never nudge a slot toward an already-claimed
# bead. This narrows (does not eliminate) the claim/work race; the bd claim CAS
# remains the authority for at-most-one assignee.
recheck_pool_unclaimed() {
  local routed_to="$1" rig="$2" open_json ready_json
  open_json=$(gc bd --rig "$rig" list --status=open --json --limit=0 2>/dev/null || echo '[]')
  [[ -z "$open_json" || "$open_json" == "[]" ]] && { echo "0:"; return; }
  # Readiness gate (gc-xk1hg): mirror scan_rig's gate so the recheck cannot
  # re-admit a blocked bead the scan already dropped.
  ready_json=$(gc bd --rig "$rig" ready --json --limit=0 2>/dev/null || echo '[]')
  jq -r --arg p "$routed_to" --argjson ready "$(jq -c '[.[].id]' <<<"$ready_json" 2>/dev/null || echo '[]')" '
    ([ .[]
       | select(((.metadata // {})["gc.step_ref"] // "") | endswith(".human-gate"))
       | .parent // empty ] | unique) as $gated
    | [ .[]
        | select((.assignee // "") == "")
        | select(((.metadata // {})["gc.routed_to"] // "") == $p)
        | select((((.metadata // {})["gc.step_ref"] // "") | endswith(".human-gate")) | not)
        | select(((.metadata // {})["gc.kind"] // "") != "workflow")
        | .id as $i | select(($gated | index($i)) | not)
        | select($ready | index($i))
        | $i ]
    | "\(length):\(.[0] // "")"
  ' <<<"$open_json" 2>/dev/null || echo "0:"
}

# wake_and_nudge_pool <routed_to> <count> <sample_bead> -> echoes "action:target" or ""
wake_and_nudge_pool() {
  local routed_to="$1" count="$2" sample="$3"
  local sessions active_ids sleeping_ids target action
  sessions=$(gc session list --template "$routed_to" --json 2>/dev/null || echo '{}')
  # `gc session list --json` returns {schema_version,..., sessions:[...]}.
  # 2026-05-20 fix: normalize to the inner array; the prior `.[]` on the
  # outer object iterated the four wrapper keys and silently returned
  # zero IDs, which made every tick log no-session-for-pool even when
  # the pool had live sessions. The JSON field is `.id` lowercase, not
  # `.ID` — same fix.
  sessions=$(jq -c '.sessions // .' <<<"$sessions" 2>/dev/null || echo '[]')
  # 2026-05-24 fix: slot-suffixed routed_to (e.g. /home/ds/gascity/polecat-1)
  # doesn't exact-match session beads stored under the base template
  # (e.g. /home/ds/gascity/polecat). On 0-hit, strip trailing -<digits>
  # and retry against the base template, then filter sessions to the
  # slot whose work_dir basename matches routed_to's basename.
  local slot_label=""
  local base="${routed_to%-[0-9]*}"
  if [[ -z "$sessions" || "$sessions" == "[]" ]]; then
    if [[ "$base" != "$routed_to" ]]; then
      sessions=$(gc session list --template "$base" --json 2>/dev/null || echo '{}')
      sessions=$(jq -c '.sessions // .' <<<"$sessions" 2>/dev/null || echo '[]')
      slot_label="${routed_to##*/}"  # e.g. polecat-1
    fi
  fi
  [[ -z "$sessions" || "$sessions" == "[]" ]] && { echo ""; return; }

  # 2026-05-24 fix v2: when routed_to was slot-suffixed, filter the session
  # set to the slot whose work_dir basename matches the slot label. Without
  # this, v1 would return ALL pool sessions and head -1 picks the same
  # active session for every slot's nudge — polecat-4 ate all queue notices
  # while polecat-1/2/3 heard nothing.
  if [[ -n "$slot_label" ]]; then
    local filtered
    filtered=$(jq -c --arg slot "$slot_label" '[.[] | select((.work_dir // "") | split("/") | last == $slot)]' <<<"$sessions" 2>/dev/null)
    if [[ -n "$filtered" && "$filtered" != "[]" ]]; then
      sessions="$filtered"
    fi
  fi

  active_ids=$(jq -r '.[] | select((.state // "") == "active") | .id' <<<"$sessions" 2>/dev/null | awk 'NF')
  sleeping_ids=$(jq -r '.[] | select((.state // "") != "active") | .id' <<<"$sessions" 2>/dev/null | awk 'NF')

  if [[ -n "$active_ids" ]]; then
    target=$(head -1 <<<"$active_ids"); action="nudge-active"
  elif [[ -n "$sleeping_ids" ]]; then
    target=$(head -1 <<<"$sleeping_ids"); action="wake-and-nudge"
  else
    echo ""; return
  fi

  local msg="You have ${count} routed bead(s) unclaimed in your pool (e.g. ${sample}). Claim and work your queue now — for each: bd update <id> --claim, then proceed."

  if [[ $APPLY -eq 1 ]]; then
    [[ "$action" == "wake-and-nudge" ]] && gc session wake "$target" >/dev/null 2>&1
    gc session nudge "$target" "$msg" --delivery immediate >/dev/null 2>&1 || { echo ""; return; }
  fi
  echo "${action}:${target}"
}

acted=()        # pool|count|action|target
dead_pools=()   # pool|count|sample|rig — routed beads with no live worker
candidates=0
# Counted in-loop rather than via ${#POOL_COUNT[@]}: a `for ... in` over an
# empty associative array is set -u-safe, but ${#assoc[@]} on an empty one is
# not (it errors "unbound variable") — and POOL_COUNT is empty on any tick with
# no routed-but-unclaimed beads (now more common with the human-gate skip).
pool_total=0
for pool in "${!POOL_COUNT[@]}"; do
  pool_total=$((pool_total + 1))
  count=${POOL_COUNT["$pool"]}
  candidates=$((candidates + count))

  # Per-pool cooldown.
  last_nudge=$(jq -r --arg p "$pool" '.[$p].nudged_epoch // 0' <<<"$state")
  if (( NOW_EPOCH - last_nudge < COOLDOWN_SECONDS )); then
    log_event "cooldown-skip" "$pool" "$(jq -cn --argjson c "$count" '{queued:$c}')"
    continue
  fi

  # Just-in-time assignee recheck: re-query right before nudging so we never
  # point a slot at a bead that was claimed since the start-of-tick scan.
  recheck=$(recheck_pool_unclaimed "$pool" "${POOL_RIG[$pool]}")
  live_count="${recheck%%:*}"
  live_sample="${recheck#*:}"
  if [[ -z "$live_count" || "$live_count" -eq 0 ]]; then
    log_event "all-claimed-skip" "$pool" "$(jq -cn --argjson c "$count" '{queued_at_scan:$c, still_unclaimed:0}')"
    continue
  fi
  count="$live_count"
  POOL_SAMPLE[$pool]="$live_sample"

  result=$(wake_and_nudge_pool "$pool" "$count" "${POOL_SAMPLE[$pool]}")
  if [[ -n "$result" ]]; then
    action="${result%%:*}"; target="${result#*:}"
    acted+=("${pool}|${count}|${action}|${target}")
    log_event "$( [[ $APPLY -eq 1 ]] && echo "$action" || echo "dry-run-${action}" )" \
      "$pool" "$(jq -cn --argjson c "$count" --arg t "$target" '{queued:$c, target:$t}')"
    if [[ $APPLY -eq 1 ]]; then
      state=$(jq --arg p "$pool" --argjson e "$NOW_EPOCH" '.[$p] = {nudged_epoch:$e}' <<<"$state")
    fi
  else
    log_event "no-session-for-pool" "$pool" "$(jq -cn --argjson c "$count" '{queued:$c}')"
    # Dead pool: routed-but-unclaimed beads whose target has ZERO live sessions.
    # Nudging cannot help (nothing to wake) — this is a misroute or a dead/min-0
    # pool. Escalate to mayor instead of silently retrying every tick. Rate-limited
    # to one surface per pool per ESCALATE_COOLDOWN_SECONDS so mayor isn't spammed.
    last_esc=$(jq -r --arg p "$pool" '.[$p].escalated_epoch // 0' <<<"$state")
    if (( NOW_EPOCH - last_esc >= ESCALATE_COOLDOWN_SECONDS )); then
      dead_pools+=("${pool}|${count}|${POOL_SAMPLE[$pool]}|${POOL_RIG[$pool]}")
      log_event "dead-pool" "$pool" "$(jq -cn --argjson c "$count" '{queued:$c, reason:"no live session for target"}')"
      if [[ $APPLY -eq 1 ]]; then
        state=$(jq --arg p "$pool" --argjson e "$NOW_EPOCH" '.[$p] = ((.[$p] // {}) + {escalated_epoch:$e})' <<<"$state")
      fi
    else
      log_event "dead-pool-cooldown" "$pool" "$(jq -cn --argjson c "$count" '{queued:$c}')"
    fi
  fi
done

[[ $APPLY -eq 1 ]] && echo "$state" > "$STATE_FILE"

# Fold-in: refresh the csu usage cache so gc-capacity stays current
# regardless of how often `claude-account auto` runs.
if [[ $DO_CSU -eq 1 ]] && command -v "$CSU_BIN" >/dev/null 2>&1; then
  "$CSU_BIN" >/dev/null 2>&1 && log_event "csu-refresh" "-" '{}' || true
fi

# Report.
mode=$( [[ $APPLY -eq 1 ]] && echo "APPLY" || echo "DRY-RUN" )
echo "routed-bead-nudger [$mode]: ${candidates} routed-but-unclaimed bead(s) across ${pool_total} pool(s); ${#acted[@]} pool(s) nudged, ${#dead_pools[@]} dead pool(s) this tick."
for entry in "${acted[@]}"; do
  IFS='|' read -r p c act tgt <<<"$entry"
  echo "  $p  (${c} queued) -> [$act] $tgt"
done
for entry in "${dead_pools[@]}"; do
  IFS='|' read -r p c smp rg <<<"$entry"
  echo "  DEAD POOL: $p  (${c} queued, e.g. ${smp}) -> no live worker"
done

if [[ ${#acted[@]} -gt 0 && $NUDGE_MAYOR -eq 1 && $APPLY -eq 1 ]]; then
  summary=$(printf '%s\n' "${acted[@]}" | sed 's/|/  /g')
  gc mail send --to mayor \
    -s "routed-bead-nudger woke ${#acted[@]} stalled pool(s)" \
    -m "Periodic sweep found routed-but-unclaimed beads and nudged their pools:

pool  queued  action  target
$summary

If the same pool recurs across ticks with a non-shrinking queue, it may be wedged — check the target session." >/dev/null 2>&1 || true
fi

# Dead-pool escalation: routed beads with NO live worker. Always surfaced
# (not gated on --nudge-mayor) because nudging can't fix it — re-route or fix
# the pool. Rate-limited per pool via escalated_epoch above.
if [[ ${#dead_pools[@]} -gt 0 && $APPLY -eq 1 ]]; then
  dsummary=$(printf '%s\n' "${dead_pools[@]}" | sed 's/|/  /g')
  gc mail send --to mayor \
    -s "routed-bead-nudger: ${#dead_pools[@]} dead pool(s) — routed work cannot be claimed" \
    -m "These pools have routed-but-unclaimed beads but ZERO live sessions, so nudging cannot help. Likely a misroute (wrong target) or a dead/min-0 pool that will not spawn. Re-route the bead to a live target or fix the pool.

pool  queued  sample-bead  rig
$dsummary

For gascity-rig code work the live target is 'polecat'." >/dev/null 2>&1 || true
  log_event "dead-pool-escalated" "-" "$(jq -cn --argjson n "${#dead_pools[@]}" '{dead_pools:$n}')"
fi

exit 0
