#!/usr/bin/env bash
# freshwake-measure: per-wake prompt-token + latency stats for a rig's
# project-lead, from Claude Code transcripts across all account homes.
#
# Purpose: honest before/after for the wake_mode resume->fresh pilot
# (Stephanie 2026-06-08). resume re-feeds growing history each wake (high
# cache_read); fresh re-primes a smaller fixed context. The metric that
# captures this is prompt_tokens/turn = input + cache_read + cache_creation.
# Run identically before the flip (baseline) and ~24-48h after.
#
# Usage:
#   freshwake-measure [--rig zeldascension] [--since-hours 48] [--class pl|worker]
#
# Classifier: worker transcripts contain "Execute the work"; PL transcripts
# contain "oversight-rig"/"project-lead" and not the worker marker.

set -uo pipefail
RIG="zeldascension"; SINCE_HOURS=48; CLASS="pl"
while [[ $# -gt 0 ]]; do case "$1" in
  --rig) RIG="$2"; shift 2;; --since-hours) SINCE_HOURS="$2"; shift 2;;
  --class) CLASS="$2"; shift 2;; -h|--help) sed -n 's/^# \{0,1\}//p' "$0"|head -16; exit 0;;
  *) echo "unknown arg: $1">&2; exit 2;; esac; done

PROJ="-home-ds-projects-${RIG}"
mapfile -t FILES < <(for n in 1 2 3 4 5; do
  d="$HOME/.claude-homes/account$n/.claude/projects/$PROJ"
  [ -d "$d" ] && find "$d" -name '*.jsonl' -mtime -3 2>/dev/null
done)

RIG="$RIG" CLASS="$CLASS" SINCE_HOURS="$SINCE_HOURS" python3 - "${FILES[@]}" <<'PYEOF'
import sys, json, os, statistics, datetime
files = sys.argv[1:]
klass = os.environ["CLASS"]
since_h = int(os.environ["SINCE_HOURS"])
# window cutoff (transcript timestamps are ISO-Z); compute without Date.now in-script-safe ways: use file mtime epoch via os
import time
cutoff = time.time() - since_h * 3600

def classify(path):
    try:
        with open(path, errors="ignore") as f:
            head = f.read(200000)
    except OSError:
        return "other"
    if "Execute the work" in head:
        return "worker"
    if "oversight-rig" in head or "project-lead" in head or "you are the project" in head.lower():
        return "pl"
    return "other"

prompt_toks, out_toks, ts_list = [], [], []
n_files = 0
for path in files:
    if classify(path) != klass:
        continue
    n_files += 1
    try:
        fh = open(path, errors="ignore")
    except OSError:
        continue
    with fh:
        for line in fh:
            try:
                o = json.loads(line)
            except json.JSONDecodeError:
                continue
            msg = o.get("message") or {}
            u = msg.get("usage") if isinstance(msg, dict) else None
            if not u:
                continue
            tstr = o.get("timestamp")
            if tstr:
                try:
                    ep = datetime.datetime.fromisoformat(tstr.replace("Z", "+00:00")).timestamp()
                except ValueError:
                    ep = None
                if ep is not None:
                    if ep < cutoff:
                        continue
                    ts_list.append(ep)
            p = (u.get("input_tokens", 0) or 0) + (u.get("cache_read_input_tokens", 0) or 0) \
                + (u.get("cache_creation_input_tokens", 0) or 0)
            prompt_toks.append(p)
            out_toks.append(u.get("output_tokens", 0) or 0)

def stats(xs):
    if not xs:
        return "n=0"
    xs2 = sorted(xs)
    p90 = xs2[min(len(xs2)-1, int(len(xs2)*0.9))]
    return (f"n={len(xs)} median={int(statistics.median(xs)):,} "
            f"p90={int(p90):,} mean={int(statistics.mean(xs)):,} sum={sum(xs):,}")

span = ""
if ts_list:
    span = f"  window: {datetime.datetime.fromtimestamp(min(ts_list)):%Y-%m-%d %H:%M} -> {datetime.datetime.fromtimestamp(max(ts_list)):%Y-%m-%d %H:%M}"
print(f"=== freshwake-measure: rig={os.environ['RIG']} class={klass} since={since_h}h ===")
print(f"transcripts matched: {n_files}{span}")
print(f"PROMPT tokens/turn (input+cache_read+cache_creation): {stats(prompt_toks)}")
print(f"OUTPUT tokens/turn:                                    {stats(out_toks)}")
PYEOF
