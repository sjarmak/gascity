dir = "/home/ds/gascity-packs"
work_dir = "/home/ds/gascity-packs-worktrees/{{.AgentBase}}"
# 2026-07-14 mayor: codex pilot — offload account1 (71% 7d, climbing) to Codex Pro.
# PILOT: does codex `exec` run our mol-focus-review convoys? Verify before expanding
# to heavier pools (gascity polecat/6). Revert to claude-1 if convoys don't execute.
provider = "codex"
min_active_sessions = 2
max_active_sessions = 2
wake_mode = "fresh"
# 2026-05-29: bumped 2h→6h. Multi-step mol-focus-review convoys (design memos,
# investigations) run long single Claude turns that emit no bead activity, so
# the reconciler's idle detector reaped them mid-run at 2h; wake_mode=fresh then
# replaced the worker fresh and orphaned the convoy (routed_to=NONE, 0 progress).
# 6h gives long convoys runway to finish before any idle reap. Deeper idle-detect
# gap (active Claude work counted as idle) tracked at gpk-me1h.
idle_timeout = "6h"

[env]
GC_CITY = "/home/ds/gas-city"
GC_BEADS = "bd"
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS = "1"
