# DEPRECATED 2026-05-29: wrong model — cwd /home/ds/gas-city resolves the
# file-backed CITY store, so its `gc hook` can't see gascity-rig (dolt) beads
# routed to it (the drain-rate stall). City-infra work now routes to the
# gascity polecat pool (/home/ds/gascity/polecat), which is store-matched and
# has host access to edit /home/ds/gas-city files per the bead. Suspended +
# min=0 so it idles out and doesn't hold a warm slot.
suspended = true
dir = "/home/ds/gas-city"
work_dir = "/home/ds/gas-city"
provider = "claude-4"
min_active_sessions = 0
max_active_sessions = 1
wake_mode = "fresh"
idle_timeout = "2h"
default_sling_formula = "mol-do-work"

[env]
GC_CITY = "/home/ds/gas-city"
GC_BEADS = "bd"
