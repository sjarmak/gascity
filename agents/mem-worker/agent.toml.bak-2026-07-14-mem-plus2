dir = "/home/ds/projects/mem"
provider = "claude-3"
# Unpinned 2026-07-05 (Stephanie: accounts are fungible, handled by quota).
# fork_flag is now uniform across all claude providers in city.toml, so the old
# claude-3-only premise is gone. ONE residual coupling: while a warm-vs-cold
# fork experiment is LIVE, mem-arm must be on the SAME provider as this pool
# (fork resumes the parent SID's transcript from that account's home) — co-move
# or temporarily re-pin both for the run's duration.
min_active_sessions = 4
max_active_sessions = 6
wake_mode = "fresh"

[env]
CLAUDE_BINARY = "claude-auto"
