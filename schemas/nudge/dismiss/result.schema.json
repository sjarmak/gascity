{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc://schemas/nudge/dismiss/result.schema.json",
  "title": "gc nudge dismiss result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "command",
    "nudge_id",
    "disposition",
    "reason",
    "actor",
    "operator_at",
    "terminal_bead_id"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "ok": { "const": true },
    "command": { "const": "nudge dismiss" },
    "nudge_id": { "type": "string", "minLength": 1 },
    "disposition": { "const": "dismissed" },
    "reason": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "operator_at": { "type": "string", "format": "date-time" },
    "terminal_bead_id": { "type": "string", "minLength": 1 }
  }
}
