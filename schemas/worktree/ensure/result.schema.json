{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc worktree ensure --json result",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "action",
    "path",
    "branch",
    "created",
    "branch_created",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "ok": { "const": true },
    "command": { "const": "worktree ensure" },
    "action": { "const": "ensure" },
    "path": { "type": "string" },
    "branch": { "type": "string" },
    "head": { "type": "string" },
    "created": { "type": "boolean" },
    "branch_created": { "type": "boolean" },
    "provenance": {
      "description": "Workspace identity supplied by the caller and echoed back, so the caller can confirm what this command was told. base_sha is the commit the base ref actually resolved to when this call created the branch, and is empty when the branch already existed.",
      "type": "object",
      "additionalProperties": true
    },
    "planned": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
