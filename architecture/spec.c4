// Element kinds, tags, and custom colors for the `gascity` architecture model.
//
// Tags encode delivery state so planned / research work is visually distinct
// from what is already built:
//   #built     — code path exists and is exercised (tests + wired into a runtime path)
//   #evolving  — built but the contract/shape is still moving
//   #planned   — designed; defined but not yet wired into the runtime path (or a stub)
//   #research  — speculative / experimental track
//   #risk      — cross-cutting: a known risk or open question for the design review

specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color slate
    }
  }

  element system

  element container {
    style {
      shape rectangle
    }
  }

  element component

  element datastore {
    style {
      shape cylinder
    }
  }

  // Deployment model — where each piece runs at review time.
  deploymentNode host {
    style {
      shape rectangle
      color slate
    }
  }
  deploymentNode proc

  tag built {
    color #16a34a
  }
  tag evolving {
    color #d97706
  }
  tag planned {
    color #64748b
  }
  tag research {
    color #6366f1
  }

  // Cross-cutting: carried by any element that is a known risk / open question
  // for the design review (in addition to its delivery-state tag).
  tag risk {
    color #dc2626
  }
}
