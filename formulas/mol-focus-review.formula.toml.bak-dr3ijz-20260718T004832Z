description = """
Focus + in-session review formula — one Claude worker implements via /focus,
then reviews its own work with /simplify and /code-review before closing.

Single-agent workflow:
1. Load context and understand the bead (including prior rejection_reason).
2. /focus on bead (plan → execute → verify).
3. Run tests.
4. /simplify the diff.
5. /code-review the diff and verify the work matches the bead's acceptance
   criteria. If review finds blockers, set `metadata.rejection_reason` and
   drain — a fresh pool worker picks up the bead and retries, reading the
   rejection reason in step 1.
6. If review passes, commit final state, land the branch on main, close the
   bead, drain. Close is conditional on the commits being reachable from main
   (EnterpriseBench-p5wrm: never close while work is stranded on work/{{issue}}).

Review in step 5 is a hard verification gate: it must check that the
implementation actually fulfills what the bead asked for, not just that
the code is stylistically clean. Missing acceptance criteria → reject.

## Variables

| Variable | Source | Description |
|----------|--------|-------------|
| issue    | caller | The work bead ID to focus on |
| base_branch | caller | Base branch for diff comparison (default: main) |
| test_command | rig config | Test command to verify work. Empty = skip. |
"""
formula = "mol-focus-review"
phase = "vapor"
# pour=true forces eager materialization of all graph.v2 step beads. Without it,
# a vapor+graph.v2 formula compiles RootOnly and drops every step → pool strands
# (gascity#TBD, compile.go:325). Verified 2026-06-30: all 7 steps materialize.
pour = true
version = 2

[requires]
formula_compiler = ">=2.0.0"

[vars]
[vars.issue]
description = "The work bead ID to focus on"
required = true

[vars.base_branch]
description = "Base branch for diff comparison"
default = "main"

[vars.test_command]
description = "Test command to verify work. Empty = skip."
default = ""

[[steps]]
id = "load-context"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Load context and understand assignment"
description = """
Initialize your session and understand the work.

```bash
gc prime
bd prime
bd show {{issue}}
gc mail inbox

# PRECHECK: never execute a bead the graph has no business executing.
# The pool will happily route a /focus at a BLOCKED bead, and the finalize step
# will then close it (EnterpriseBench-coada D1, near-miss on jn73.1 which was
# BLOCKED behind a Stephanie sign-off gate). Refuse rather than proceed.
STATUS=$(bd show {{issue}} --json | jq -r '.[0].status // "unknown"')
if [ "$STATUS" = "blocked" ] || [ "$STATUS" = "closed" ]; then
  echo "FATAL: {{issue}} is $STATUS — refusing to run /focus on it." >&2
  echo "A blocked bead is blocked for a reason; a closed one is done. Escalate, do not execute." >&2
  exit 1
fi

# Enter the per-bead worktree if one already exists from a prior attempt
# (work_dir metadata, set by the workspace-setup step below). No-op on a
# fresh first attempt — workspace-setup provisions the worktree next.
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty'); [[ -n "$WT" && -d "$WT" ]] && cd "$WT" && echo "entered per-bead worktree: $WT"
```

If the precheck fires, do NOT work around it. Hard-fail this bead
(`gc.outcome=fail`, `gc.failure_class=hard`) with the target's status as the
reason, and drain. A human decides whether the target should be unblocked.

If the bead's acceptance criteria contain a HALT or human sign-off gate
("HALT-branch-ready", "→ Stephanie sign-off", or similar), that gate binds
this workflow too: implement up to the gate, then stop. Do not let a later
step close the bead through it.

On a reject→retry cycle, a per-bead worktree from the prior attempt already
exists (`metadata.work_dir`) and the `cd` above moves you into it. On a
fresh first attempt nothing exists yet — the workspace-setup step (next)
provisions it. Either way, do ALL work in the per-bead worktree, never in
the shared rig main tree (cf. the scix o835 pile-up 2026-06-14, and the
2026-07-04/05 mem/gascity/EB overnight worktree races — mem-cvn3).

Read the bead's title, description, acceptance criteria, design notes,
and any linked context. Understand what "done" looks like before starting.

If the bead has `metadata.rejection_reason`, a prior attempt was rejected
by the review step. Read the rejection reason carefully and focus on
fixing the specific issue it calls out.

**Exit criteria:** You understand the work and the acceptance criteria."""

[[steps]]
id = "workspace-setup"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Set up a per-bead worktree"
needs = ["load-context"]
description = """
Ensure there is an isolated worktree for this work item, so later steps
never run in the shared rig main tree (mem-cvn3 worktree-pin fix).

```bash
git fetch --prune origin
WORKTREE=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WORKTREE" ]; then
  WORKTREE_PATH=$(pwd)/worktrees/{{issue}}
  BRANCH="work/{{issue}}"
  # Create the worktree on a REAL branch, never --detach: a worker's commits
  # must survive worktree teardown even if no main-merge reconciliation ever
  # runs (EnterpriseBench-1fb2 — detached HEAD leaves commits unreachable, and
  # the assumed "controller reconciles to main" does not exist). The show-ref
  # guard reuses an existing branch from a prior incomplete attempt rather than
  # clobbering its unmerged work (retry case).
  if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git worktree add "$WORKTREE_PATH" "$BRANCH"
  else
    # Cut from LOCAL {{base_branch}}, not origin/{{base_branch}}. finalize lands
    # onto local {{base_branch}} and workers never push, so the two refs diverge
    # permanently (origin/main was 3 commits behind local main when this was
    # found). Branching from the remote ref starts every bead on a stale base,
    # forcing the rebase path on every single land and growing the conflict
    # surface with each bead that lands ahead of it.
    #
    # Fall back to the remote ref only if the base does not exist locally (a
    # caller can pass a base_branch that has only ever existed on origin — the
    # fetch above is what makes that fallback reachable).
    if git show-ref --verify --quiet "refs/heads/{{base_branch}}"; then
      BASE_REF="{{base_branch}}"
    elif git show-ref --verify --quiet "refs/remotes/origin/{{base_branch}}"; then
      echo "WARN: {{base_branch}} does not exist locally; cutting from origin/{{base_branch}}." >&2
      BASE_REF="origin/{{base_branch}}"
    else
      echo "FATAL: {{base_branch}} exists neither locally nor on origin — cannot create work/{{issue}}." >&2
      exit 1
    fi
    git worktree add "$WORKTREE_PATH" -b "$BRANCH" "$BASE_REF"
  fi
  bd update {{issue}} --set-metadata work_dir="$WORKTREE_PATH"
  WORKTREE="$WORKTREE_PATH"
fi
cd "$WORKTREE"
```

**Exit criteria:** A per-bead worktree exists on branch `work/{{issue}}` and `metadata.work_dir` is set."""

[[steps]]
id = "focus"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Execute /focus on the bead"
needs = ["workspace-setup"]
description = """
**FIRST — re-enter the pinned per-bead worktree.** /focus edits AND commits, so
running it from a scaffold cwd or the shared rig tree writes to the WRONG
checkout — a silent corruption that flows into review/finalize (dr-f4sl:
gc-484933 ran /focus in enterprisebench-dukaf while the target worktree was
o4bfs). This is the SAME self-contained guard run-tests already uses; focus was
the only executable step missing it. Do NOT skip it.

```bash
# Resolve the canonical pinned worktree (gc.work_dir is canonical; work_dir is
# the legacy mirror). Reject a missing/conflicting pin rather than guess.
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata."gc.work_dir" // .[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then
  echo "FATAL: no pinned per-bead worktree for {{issue}} — refusing to /focus in an arbitrary cwd (dr-f4sl)." >&2
  exit 1
fi
if ! git -C "$WT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "FATAL: pinned work_dir $WT is not a git worktree — refusing to /focus." >&2
  exit 1
fi
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to /focus in the wrong tree (dr-f4sl)." >&2
  exit 1
fi
cd "$WT"
echo "focus: entered pinned worktree $WT on work/{{issue}}"
```

Invoke the /focus skill with the assigned bead, FROM the worktree you just entered:

/focus {{issue}} --no-close

The /focus skill will:
1. Read the bead and plan the implementation
2. Execute the plan step by step
3. Verify the work against acceptance criteria

**`--no-close` is load-bearing — never drop it.** /focus's Phase 5 IS a bead
close, and this formula is exactly the "wrapper context" that flag exists for.
Without it a *compliant* worker closes {{issue}} here, at the end of the focus
step — upstream of run-tests, simplify, review, and finalize. Every gate this
formula owns (the review_verdict==pass check, the land-on-main block, the
merge-base invariant) lives in `finalize`, so closing here makes all of them
dead code. That is how EnterpriseBench-vdeyx and EnterpriseBench-s1o2n closed
on 2026-07-14 with their review step never run and their commits stranded on
work/* — the day AFTER the land step was deployed (EnterpriseBench-p5wrm).

**You must NOT close {{issue}} in this step.** Do not run `bd close {{issue}}`,
with or without a reason, no matter what the skill's Phase 5 says — the flag
disables that phase and `finalize` owns the close. Closing here does not mean
the work shipped; it means the work is stranded and the bead is lying.

Follow the skill's instructions for Phases 0-4. If the skill asks for
decisions, make them based on the bead context.

**If context filling up:** Save progress, commit work, then:
```bash
gc runtime request-restart
```

**Exit criteria:** /focus has completed its execution cycle."""

[[steps]]
id = "run-tests"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Run tests to verify implementation"
needs = ["focus"]
description = """
**Config: test_command = {{test_command}}**

**0. BACKSTOP — the focus step must not have closed {{issue}}.** Prose in the
focus step is not enforcement: the workers that stranded vdeyx and s1o2n ran a
bare `bd close` that no skill or step ever told them to run (close_reason was
empty — /focus's own Phase 5 emits `bd close -r`). A premature close upstream of
`finalize` bypasses the review gate AND the land block, so catch it here, at the
first step that runs after focus, while the molecule is still alive to repair it:

```bash
# Re-enter the per-bead worktree FIRST. This step can be dispatched to a fresh
# session, and {{test_command}} run from the shared rig tree tests the WRONG code
# — a false green that flows straight into review and finalize (EnterpriseBench-73pw).
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then echo "FATAL: no per-bead worktree for {{issue}}; refusing to test the wrong tree" >&2; exit 1; fi
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: work_dir $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to test the wrong tree" >&2
  exit 1
fi
cd "$WT"

# Was {{issue}} closed out of turn during focus? Decide from git, not from prose:
# a close is legitimate ONLY if the work actually landed. If the commits are
# reachable from {{base_branch}}, some sibling's finalize did its job — leave it
# alone. If they are NOT, the bead is asserting work that did not ship, which is
# the whole p5wrm defect, and the molecule is still alive to repair it.
STATUS=$(bd show {{issue}} --json | jq -r '.[0].status // "unknown"')
if [ "$STATUS" = "closed" ]; then
  if git merge-base --is-ancestor HEAD "{{base_branch}}"; then
    echo "{{issue}} is closed and its commits ARE on {{base_branch}} — a real finalize landed it. Nothing to repair."
  else
    echo "WARN: {{issue}} was closed during the focus step with its commits NOT on {{base_branch}}." >&2
    echo "  That close was not sanctioned: finalize owns the close, gated on review_verdict==pass" >&2
    echo "  and on the commits being reachable from {{base_branch}} (EnterpriseBench-p5wrm)." >&2
    echo "  Reopening so the gates can actually run. Do NOT close it again here." >&2
    bd update {{issue}} --status open
    bd update {{issue}} --notes "Reopened by mol-focus-review.run-tests: the focus step closed this bead before the review gate and the land-on-main step could run, and its commits are not reachable from {{base_branch}} (EnterpriseBench-p5wrm). The close was premature, not a completion."
  fi
fi
```

Reopen, do not hard-fail: the work exists on `work/{{issue}}` and the molecule
can still review it and land it. Failing here would leave the bead closed and
the commits stranded — the exact violation.

Run the project test suite to verify your implementation, from the worktree you
just entered. **Verification is enforced mechanically — an empty command or a
command that exercised ZERO packages/tests is a FALSE GREEN and is rejected
(dr-5lub: gc-io0w ran `go build ./...` in a scaffold cwd, matched no packages,
exited 0, and flowed straight into review/finalize).** Run exactly this:

```bash
# Code-bearing? (commits on work/{{issue}} beyond base, or a go.mod present)
CODE_BEARING=0
[ -n "$(git rev-list "{{base_branch}}..HEAD" 2>/dev/null | head -1)" ] && CODE_BEARING=1
[ -f go.mod ] && CODE_BEARING=1

TC='{{test_command}}'
case "$TC" in
  SKIP:*)
    # Non-code / no-test work must declare skip EXPLICITLY — never an empty string.
    echo "run-tests: explicit validated skip — ${TC#SKIP:}"
    ;;
  "")
    if [ "$CODE_BEARING" = "1" ]; then
      echo "FATAL: test_command is EMPTY but this is code-bearing work (commits or go.mod)." >&2
      echo "  Implicit empty verification is a false green (dr-5lub). Set a real test command in" >&2
      echo "  the rig config, or declare test_command='SKIP:<reason>' if there genuinely are no tests." >&2
      exit 1
    fi
    echo "run-tests: no test_command and no code detected — nothing to verify."
    ;;
  *)
    [ -f go.mod ] || { git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "FATAL: not in a repo/worktree to verify" >&2; exit 1; }; }
    OUT=$(eval "$TC" 2>&1); RC=$?
    printf '%s\n' "$OUT"
    if printf '%s' "$OUT" | grep -qiE 'matched no packages|no packages to test|no test files|no tests to run'; then
      echo "FATAL: '$TC' exited $RC but selected ZERO packages/tests — that verified nothing (dr-5lub)." >&2
      exit 1
    fi
    [ "$RC" -ne 0 ] && { echo "Tests FAILED (exit $RC). Fix, commit, re-run until green. Do NOT proceed." >&2; exit "$RC"; }
    echo "run-tests: verification passed ($TC)"
    ;;
esac
```

If tests fail: read the output, fix the implementation, commit, re-run until green.
Do NOT proceed until the guard above reports passed/validated-skip.

**Exit criteria:** the guard printed 'verification passed' or 'explicit validated
skip' — NOT an implicit empty/zero-package exit (those hard-fail by design)."""

[[steps]]
id = "simplify"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Simplify the diff"
needs = ["run-tests"]
description = """
Re-enter the per-bead worktree before simplifying — this step can be dispatched
to a fresh session, and /simplify run from the shared rig tree would rewrite the
WRONG code (EnterpriseBench-73pw):

```bash
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then echo "FATAL: no per-bead worktree for {{issue}}; refusing to simplify the wrong tree" >&2; exit 1; fi
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: work_dir $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to simplify the wrong tree" >&2
  exit 1
fi
cd "$WT"
```

Run the /simplify skill on your implementation diff to remove
unnecessary complexity, dead paths, and over-engineering.

```
/simplify
```

Follow the skill's suggestions. Commit any simplifications as a separate
commit so they're visible in the diff.

**Exit criteria:** /simplify has run and any proposed simplifications
are either applied + committed or explicitly rejected with reason."""

[[steps]]
id = "review"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Review the diff and verify acceptance criteria"
needs = ["simplify"]
description = """
Review your own work as a hard verification gate.

**1. Run /code-review on the diff:**
```
/code-review
```

**2. Verify the work matches the bead:**

Re-read the bead's description and acceptance criteria:
```bash
bd show {{issue}}
```

Then compare against what actually changed:
```bash
# Re-enter the per-bead worktree before any git inspection. This step may be
# dispatched to a fresh session/worker (session_affinity is not guaranteed);
# running git in the shared rig main tree or another bead's worktree silently
# compares the WRONG diff (EnterpriseBench-73pw). Fail loud rather than verify
# the wrong tree.
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then echo "FATAL: no per-bead worktree for {{issue}}; refusing to verify against the wrong tree" >&2; exit 1; fi
# "is a directory" is not "is the right tree". Two provisioners write work_dir
# (the sling intercept and workspace-setup), and beads carry a conflicting
# gc.work_dir on branch main. A work_dir sitting on main diffs clean against
# {{base_branch}} and would pass this gate having reviewed NOTHING.
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: work_dir $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to review the wrong tree" >&2
  exit 1
fi
cd "$WT"
git diff --stat {{base_branch}}...HEAD
git diff {{base_branch}}...HEAD
```

For every acceptance criterion in the bead, confirm it's satisfied by
the diff. Do NOT rely on what you *remember* implementing — check the
diff. A test that was added but is skipped or xfail'd does not count.
A function that was stubbed but not wired into the public API does not
count. A doc that was written but doesn't match the code does not count.

**3. Decide: pass or reject.**

**Reject criteria (any ONE triggers reject):**
- An acceptance criterion from the bead is not actually implemented in the diff
- /code-review flagged a blocking issue (correctness, security, data-loss risk)
- Tests that should exist are missing
- Implementation diverges from what the bead asked for without justification

**If rejecting — record the verdict, re-arm the molecule, and drain.**

Reopening `{{issue}}` is NOT what makes a retry happen, and believing it does is
the EnterpriseBench-o4bfs defect. This molecule's steps are ordered ONLY by dep
edges between its own step beads. Reopening the target touches none of them, so
this review step stays open + assigned + dep-satisfied, `gc hook --claim` hands
it straight back to the next session at the SAME SHA, and it re-rejects forever.

**Re-arm every step, not a hand-picked subset.** Any step left closed is a gate
that silently will not run on the retry, and each omission is its own defect:
leave `load-context` closed and the worker never reads the rejection_reason (the
remedy is never applied, which is the whole point of the retry); leave
`workspace-setup` closed and its `cd "$WORKTREE"` never runs, so `focus` (the
one step with no worktree guard of its own) executes in whatever tree the pool
worker started in, i.e. the shared rig main tree. The dep edges re-sequence
everything: `load-context` has `needs=[]` so it alone goes READY, and the rest
re-block behind it in order.

Run this as ONE block:

```bash
set -euo pipefail

# SELF-CONTAINED ON PURPOSE: this is a separate fenced block, and the harness
# resets cwd and shell variables between tool calls. Re-derive the worktree here
# rather than trusting the $WT set in the block above (which is a different
# process), exactly as run-tests, simplify and finalize each do.
TGT=$(bd show {{issue}} --json)
WT=$(echo "$TGT" | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then
  echo "FATAL: no per-bead worktree for {{issue}}; refusing to record a reject SHA from an unknown tree" >&2
  exit 1
fi
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: work_dir $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to record a SHA from the wrong tree" >&2
  exit 1
fi
CUR_SHA=$(git -C "$WT" rev-parse HEAD)
LAST_SHA=$(echo "$TGT" | jq -r '.[0].metadata.last_reject_sha // empty')
COUNT=$(echo "$TGT" | jq -r '.[0].metadata.reject_count // "0"')

# VALIDATE BEFORE ANY ARITHMETIC. reject_count comes out of the bead store, which
# every pool participant can write, and bash evaluates an array subscript inside
# $(( )) as a command substitution: a reject_count of 'X[$(rm -rf ~)]' would
# execute SILENTLY and still exit 0 — set -euo pipefail does not stop it. This
# check sits above every mutation, so refusing here changes no state. LAST_SHA
# needs no such guard: it is only ever compared as a quoted string, never
# arithmetic, so a corrupt value just fails to match and the retry proceeds.
case "$COUNT" in
  ''|*[!0-9]*)
    echo "FATAL: reject_count on {{issue}} is not a plain integer: '$COUNT'" >&2
    echo "Refusing to evaluate it: bash arithmetic would execute an embedded subscript." >&2
    exit 1
    ;;
esac
COUNT=$((COUNT + 1))

# DISCOVER AND VALIDATE EVERYTHING BEFORE MUTATING ANYTHING: an abort partway
# through would leave a half-re-armed molecule.
#
# Scope root discovery to the OPEN root. Re-slinging a bead is routine, so a
# target commonly carries several roots from earlier molecules and matching on
# gc.var.issue alone matches all of them (EnterpriseBench-0nru has 3). Only the
# live molecule's root is open. --metadata-field is repeatable and ANDs.
ROOTS=$(bd list -n 0 --json -s open,in_progress \
  --metadata-field 'gc.kind=workflow' \
  --metadata-field 'gc.formula_name=mol-focus-review' \
  --metadata-field "gc.var.issue={{issue}}" | jq -c '[.[].id] | unique')
N_ROOTS=$(echo "$ROOTS" | jq 'length')

# Every non-convergent condition escalates rather than spinning or aborting.
ESCALATE=""
if [ -n "$LAST_SHA" ] && [ "$LAST_SHA" = "$CUR_SHA" ]; then
  ESCALATE="body re-ran but HEAD is still $CUR_SHA: the remedy was not applied, or was applied without committing"
elif [ "$COUNT" -ge 3 ]; then
  ESCALATE="rejected $COUNT times; the reject->retry loop is not converging"
elif [ "$N_ROOTS" != "1" ]; then
  ESCALATE="molecule-root discovery matched $N_ROOTS open roots (need exactly 1): $ROOTS. Cannot re-arm without risking a foreign molecule."
fi

if [ -n "$ESCALATE" ]; then
  PRIOR=$(echo "$TGT" | jq -r '.[0].metadata.rejection_reason // "<unset>"')
  bd update {{issue}} --set-metadata review_verdict=escalate
  bd note {{issue}} "escalation: $ESCALATE. A human must decide: fix by hand, re-scope the bead, or close it — and clear reject_count/last_reject_sha before re-slinging, or the next molecule escalates on its first reject. Last rejection_reason: $PRIOR"
  bd update {{issue}} --status=blocked --assignee=""
  echo "ESCALATED: $ESCALATE" >&2
  # Hard-fail this review step. finalize refuses on verdict!=pass AND on a
  # blocked target, so both of its gates catch this.
  exit 1
fi
ROOT=$(echo "$ROOTS" | jq -r '.[0]')

# `bd list` hides closed issues and caps at 50 rows. Steps are closed at reject
# time, so BOTH --all and -n 0 are load-bearing: without them the lookups below
# match nothing and the exactly-1 assertion fires.
ALL=$(bd list --all -n 0 --json --metadata-field "gc.root_bead_id=$ROOT")

# STEPS is ordered and the order is load-bearing (see the reopen loop), so it is
# spelled out rather than derived. The assertion is what makes that safe: a step
# added to the formula but missing from STEPS would otherwise be a gate that
# silently never re-runs. Engine control beads carry gc.kind (workflow-finalize,
# retry, ralph, scope, fanout, ...) and real steps leave it unset, so they are
# excluded by that property rather than by name — which stays correct if the
# engine grows a kind or this formula gains a [steps.retry].
#
# ESCAPES: this is a TOML basic string. TOML eats one level of backslash before
# bash or jq sees it, and an escape TOML does not recognise fails the whole file
# at parse time — so a jq regex needing a literal dot, or a tab written as an
# escape, is a live landmine here. Keep the code below backslash-free: ltrimstr
# rather than sub(), xargs rather than tr, space-joined rather than @tsv. This
# comment is backslash-free for the same reason.
STEPS="load-context workspace-setup focus run-tests simplify review finalize"
WANT=$(echo $STEPS | xargs -n1 | sort | xargs)
HAVE=$(echo "$ALL" | jq -r '[.[] | select(.metadata."gc.step_ref" and (.metadata."gc.kind"|not)) | .metadata."gc.step_ref" | ltrimstr("mol-focus-review.")] | unique | join(" ")')
if [ "$WANT" != "$HAVE" ]; then
  echo "FATAL: STEPS is out of sync with the compiled formula under root $ROOT" >&2
  echo "  STEPS lists: $WANT" >&2
  echo "  graph has:   $HAVE" >&2
  exit 1
fi

# Resolve exactly one step bead per step_ref in ONE jq pass, before the first
# write, so a discovery failure is non-mutating. The exactly-1 assertion also
# catches a dropped --all: closed steps would match 0 and abort here rather than
# silently no-op the re-arm.
declare -A SID
while read -r S ID N; do
  if [ "$N" != "1" ]; then
    echo "FATAL: step $S under root $ROOT matched $N beads (need exactly 1)" >&2
    exit 1
  fi
  SID[$S]=$ID
done < <(echo "$ALL" | jq -r --arg steps "$STEPS" '
  ($steps | split(" ")) as $want
  | (reduce .[] as $b ({}; .[$b.metadata."gc.step_ref" // "none"] += [$b.id])) as $by
  | $want[] | . as $s
  | (($by["mol-focus-review." + $s]) // [] | unique) as $ids
  | [$s, ($ids[0] // "-"), ($ids | length | tostring)] | join(" ")')

# Write the verdict and the new rejection_reason BEFORE re-arming: the retry's
# load-context reads rejection_reason, so re-arming first would race a worker
# onto the stale reason. review_verdict is the ONLY thing finalize trusts, and
# closing a step does NOT communicate a verdict (the `finalize needs=[review]`
# edge is satisfied by closure alone, so an unwritten marker arms the auto-close
# on rejected work: EnterpriseBench-coada D2). One call, so there is no window
# where the verdict is visible against a stale rejection_reason.
bd update {{issue}} --set-metadata review_verdict=reject \
  --set-metadata rejection_reason="<specific issue to fix>" \
  --set-metadata last_reject_sha="$CUR_SHA" \
  --set-metadata reject_count="$COUNT"

# Reopen FIRST, in forward dep order, and unassign only afterwards. Every step
# still carries the assignee from its last run (closed steps retain it), and the
# pool claim hook skips any bead that has an assignee, so reopening a still-
# assigned step is invisible to other workers. Forward order also means each
# step's blocker is already open before the step itself reopens, so no step is
# ever transiently dep-satisfied on the way through. `bd update` takes many ids,
# so each pass is ONE call: the graph moves in two steps, not fourteen.
ORDERED=(); for S in $STEPS; do ORDERED+=("${SID[$S]}"); done
bd update "${ORDERED[@]}" --status=open
echo "re-armed: ${ORDERED[*]}"

# Only now clear the assignees, in REVERSE, so `load-context` (the sole
# dep-satisfied step) loses its assignee LAST, once the graph is fully
# consistent. The opposite order would clear THIS review step's own assignee
# while `simplify` was still closed, leaving review open + dep-satisfied +
# unassigned: claimable by a second worker while this very script is still
# running inside review's own body, racing writes to review_verdict. The reverse
# is DERIVED from STEPS, never restated: a hand-inverted copy silently desyncs
# the moment a step is added, stranding it with a dead worker's assignee.
REVERSED=(); for S in $STEPS; do REVERSED=("${SID[$S]}" "${REVERSED[@]}"); done
bd update "${REVERSED[@]}" --assignee=""

bd update {{issue}} --assignee="" --status=open
gc runtime drain-ack
```

Do NOT close this review step: it was reopened above and must stay open, blocked
behind the reopened `simplify`, so it cannot be re-offered until the body
genuinely re-runs. Drain instead. A fresh pool worker now picks up `load-context`,
reads the rejection_reason, and the body applies the remedy. Do NOT try to fix it
yourself in this session: the reject→retry loop is the point.

**If passing — record the verdict explicitly, then proceed to finalize:**
```bash
# Clear the retry counters too: they live on the target, which outlives this
# molecule, so a future re-sling would inherit them and escalate early.
bd update {{issue}} --set-metadata review_verdict=pass \
  --set-metadata rejection_reason="" \
  --set-metadata reject_count="0" \
  --set-metadata last_reject_sha=""
```

**Exit criteria:** `review_verdict` is set to exactly one of
pass / reject / escalate on `{{issue}}`, AND (if not pass) the worker drained."""

[[steps]]
id = "finalize"
metadata = { "gc.continuation_group" = "main", "gc.session_affinity" = "require" }
title = "Finalize: commit, land on main, close bead, drain"
needs = ["review"]
description = """
Close out the work — but ONLY if the review actually passed.

**Do not assume it did.** Reaching this step proves nothing: the graph edge
`finalize needs=[review]` is satisfied by the review step CLOSING, and the
review step closes on its reject and hard-fail paths too. A rejected review
arms this step exactly like a passing one (EnterpriseBench-coada D2; hit twice
— near-miss on jn73.1, again on jn73.2 where this step was told to close a
BLOCKED bead holding a frozen fix list). Verify the verdict yourself.

**0. GATE — read the review verdict. Refuse unless it is `pass`:**
```bash
VERDICT=$(bd show {{issue}} --json | jq -r '.[0].metadata.review_verdict // empty')
STATUS=$(bd show {{issue}} --json | jq -r '.[0].status // "unknown"')

if [ "$VERDICT" != "pass" ]; then
  echo "FATAL: review_verdict=${VERDICT:-<unset>} (need 'pass') — refusing to finalize {{issue}}." >&2
  echo "An unset verdict is NOT a pass: it means the review never reached a decision," >&2
  echo "or ran under a formula older than the coada fix. Treat it as a reject." >&2
  exit 1
fi
if [ "$STATUS" = "blocked" ]; then
  echo "FATAL: {{issue}} is BLOCKED — refusing to close it regardless of verdict." >&2
  exit 1
fi

# A bead can still arrive here CLOSED: the run-tests backstop that repairs a
# premature close is itself an instruction a worker can skip. Do not walk past
# it — step 4's `bd close` would then run against an already-closed bead, and if
# bd errors on that, this step exits non-zero AFTER the commits already landed,
# wedging the bead exactly the way change #4 exists to prevent (on retry there is
# nothing left to land, so it wedges permanently). Reopen and continue: the work
# is real, the verdict is pass, and the land block below is what makes the close
# honest.
if [ "$STATUS" = "closed" ]; then
  echo "WARN: {{issue}} reached finalize already CLOSED — an upstream step closed it out of turn." >&2
  echo "  Reopening so the land block runs and step 4's close is the one that sticks." >&2
  bd update {{issue}} --status open
  bd update {{issue}} --notes "Reopened by mol-focus-review.finalize: arrived here already closed (premature close upstream of the land gate, EnterpriseBench-p5wrm). Landing now; this step owns the close."
fi
```

If the gate fires: do NOT commit, do NOT close `{{issue}}`, do NOT edit the
target's metadata. Hard-fail THIS step (`gc.outcome=fail`,
`gc.failure_class=hard`, `gc.failure_reason=finalize_refused_review_not_passed`),
leave the target exactly as you found it, and drain. The reject→retry loop
re-queues the target on its own; finalize is not the retry path.

**1. Re-enter the per-bead worktree, then ensure everything is committed:**
```bash
# The finalize step may run in a fresh session/worker. Without this guard its
# git checks operate on the shared main tree, find nothing to commit, and close
# the bead as if the work had merged (EnterpriseBench-73pw close-without-merge
# class). Fail loud rather than silently finalize the wrong tree.
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then echo "FATAL: no per-bead worktree for {{issue}}; refusing to finalize in the wrong tree" >&2; exit 1; fi
# The directory check alone is not enough, and this is the gap that lets every
# p5wrm guard below report green while nothing lands: if work_dir points at a
# tree sitting on {{base_branch}} (the beads carry a conflicting gc.work_dir with
# gc.work_branch=main), then HEAD == {{base_branch}}, the "nothing to land" branch
# is taken, the merge-base invariant is trivially TRUE, and the bead closes with
# its commits still stranded on work/{{issue}}. Pin the branch, not just the path.
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: work_dir $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to finalize the wrong tree" >&2
  exit 1
fi
cd "$WT"
git status
```
If uncommitted changes, commit them:
```bash
git add <files>
git commit -m "<type>: <description>"
```

**2. Record what was done and the diff summary on the bead:**
```bash
DIFF_STAT=$(git diff --stat {{base_branch}}...HEAD)
bd update {{issue}} --notes "Implementation complete. Summary: <what was done, key decisions, files changed>. Self-reviewed with /simplify + /code-review, acceptance criteria verified."
bd update {{issue}} --set-metadata impl_complete=true
bd update {{issue}} --set-metadata base_branch={{base_branch}}
bd update {{issue}} --set-metadata diff_stat="$DIFF_STAT"
```

**3. Land the work on {{base_branch}} — a bead must NOT close while its commits
are unreachable (EnterpriseBench-p5wrm).** Run this entire block as one script;
if it exits non-zero, do NOT close the bead. Hard-fail this step
(`gc.outcome=fail`, `gc.failure_class=hard`, `gc.failure_reason=land_failed`),
leave the commits on `work/{{issue}}` and the bead OPEN, and drain — a human or
reconciler resolves the divergence. Do NOT hand-merge or force anything.
```bash
# mol-focus-review historically committed to work/{{issue}} and closed WITHOUT
# ever merging, so every worker's commits stranded on a work/* branch while the
# bead read DONE (87 commits / 20 branches, 10 closed beads shipping nothing
# when p5wrm was filed). Land here; keep close conditional on it.
#
# Concurrency: the whole worker pool finalizes against the same local
# {{base_branch}}. A plain --ff-only would fail permanently for the 2nd+
# concurrent bead (its branch point falls behind), re-creating the wedge. So we
# rebase onto the CURRENT base tip under a shared lock, then fast-forward only.
# SELF-CONTAINED ON PURPOSE — re-derive the worktree and cd here. Do NOT rely on
# the `cd "$WT"` in step 1: this block is a separate fenced script, the harness
# resets cwd between tool calls, and step 3's own preamble admits finalize may run
# in a fresh session. A wrong cwd here is not cosmetic — it is the whole bug. If
# cwd is the base tree, HEAD *is* $BASE, the "nothing to land" path is taken, and
# the bead closes with its commits still on work/{{issue}}. Verified reproducible.
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then echo "FATAL: no per-bead worktree for {{issue}} — refusing to land from the wrong tree" >&2; exit 1; fi
WT_BRANCH=$(git -C "$WT" symbolic-ref --short HEAD 2>/dev/null || echo "<detached>")
if [ "$WT_BRANCH" != "work/{{issue}}" ]; then
  echo "FATAL: work_dir $WT is on '$WT_BRANCH', not 'work/{{issue}}' — refusing to land from the wrong tree" >&2
  exit 1
fi
cd "$WT"

BASE="{{base_branch}}"
WORK="refs/heads/work/{{issue}}"
GITDIR=$(git rev-parse --git-common-dir)
LOCK="$GITDIR/mol-focus-merge.lock"

# Everything below asserts against $WORK — the BRANCH REF — never against HEAD.
# HEAD is whatever tree the worker happens to be standing in; the branch ref is
# the thing whose commits must reach $BASE. Gating on HEAD made the invariant a
# TAUTOLOGY: "rev-list --count $BASE..HEAD == 0" and "merge-base --is-ancestor
# HEAD $BASE" are the same predicate, so on the "nothing to land" path the gate
# could never fire — it rubber-stamped precisely the case it existed to catch.

# Ask "are there commits to land", NOT "is there a net diff". `git diff --quiet
# $BASE...$WORK` is a CONTENT test: a branch whose commits cancel out (a revert
# pair, or work an earlier attempt already landed) reports clean, skips the land
# block, and then fails the invariant below — wedging the bead as unclosable
# forever. Count commits instead.
if [ "$(git rev-list --count "$BASE".."$WORK")" -eq 0 ]; then
  echo "nothing ahead of $BASE — no commits to land"
else
  # Serialize the $BASE ref update across concurrent finalizes; the lock is held
  # for the whole rebase+ff and released on unlock or process exit. Bounded: an
  # unbounded flock lets one worker stuck mid-rebase stall every other finalize
  # in the pool indefinitely.
  exec 9>"$LOCK"
  if ! flock -w 300 9; then
    echo "FATAL: timed out after 300s waiting for the $BASE land lock ($LOCK)." >&2
    echo "Another finalize is wedged holding it — refusing to close {{issue}}." >&2
    exit 1
  fi

  # Rebase onto the current $BASE tip (other workers may have landed since this
  # worktree was cut). A conflict means we cannot land cleanly and mechanically
  # — refuse; the commits stay on work/{{issue}}.
  if ! git rebase "$BASE"; then
    # If the abort ALSO fails, the worktree is left mid-rebase and every retry
    # dies on "you are in the middle of a rebase" with no trail back to here.
    # Say so instead of swallowing it.
    if ! git rebase --abort; then
      echo "FATAL: rebase of work/{{issue}} onto $BASE failed AND 'git rebase --abort' failed." >&2
      echo "  The worktree is stuck mid-rebase and needs manual recovery before any retry can work." >&2
      exit 1
    fi
    echo "FATAL: work/{{issue}} will not rebase cleanly onto $BASE — refusing to close." >&2
    exit 1
  fi

  # Fast-forward $BASE from the worktree that holds it (never a rewrite). The
  # $BASE tree is a ref-holder only — all real work happens in per-bead
  # worktrees — so advancing its files to match $BASE is correct.
  MAIN_WT=$(git worktree list --porcelain | grep -B2 "^branch refs/heads/$BASE$" | sed -n 's/^worktree //p' | head -1)
  if [ -z "$MAIN_WT" ]; then
    echo "FATAL: no worktree holds $BASE; cannot land safely — refusing to close." >&2
    exit 1
  fi
  if ! git -C "$MAIN_WT" merge --ff-only "work/{{issue}}"; then
    # Almost always this is the human's tree, not a git problem: $MAIN_WT is a
    # real checkout someone works in, and git correctly refuses to clobber
    # locally-modified or untracked files that the incoming commits touch. Name
    # them — "dirty base tree?" sends the next reader on a hunt.
    echo "FATAL: ff-only merge of work/{{issue}} into $BASE failed — refusing to close." >&2
    echo "Uncommitted state in the $BASE tree ($MAIN_WT):" >&2
    git -C "$MAIN_WT" status --porcelain >&2
    echo "Paths this bead's commits touch:" >&2
    git diff --name-only "$BASE".."$WORK" >&2
    echo "If those sets intersect, the local edits must be committed or stashed before this can land." >&2
    echo "NOTE: no retry can clear this on its own — the collision is in the $BASE tree, not the branch." >&2
    exit 1
  fi
  # Capture the landed SHA while STILL HOLDING the lock. Read after the unlock,
  # it can name a tip another bead's finalize just advanced to — the close reason
  # would then credit this bead with someone else's commit, which is precisely
  # the attribution fog that made the vdeyx/s1o2n forensics slow.
  LANDED_SHA=$(git rev-parse --short "$BASE")
  # Hand it to step 4 through bd, NOT through a shell variable. Step 4 is a
  # separate fenced block = a separate process: cwd survives across tool calls,
  # shell vars do NOT. A bare "$LANDED_SHA" there expands to empty and the close
  # reason lands as "...landed on main at ." — an empty-ish close reason, which is
  # the exact fingerprint this SHA was added to eliminate.
  bd update {{issue}} --set-metadata landed_sha="$LANDED_SHA"
  flock -u 9
fi

# THE INVARIANT — the whole point of p5wrm. Assert the WORK BRANCH reached $BASE.
# Not HEAD: HEAD is wherever the worker is standing, and gating on it made this a
# tautology that passed on exactly the broken path. $WORK is the thing that has to
# land, so $WORK is what we check.
if ! git merge-base --is-ancestor "$WORK" "$BASE"; then
  echo "FATAL: work/{{issue}} is NOT reachable from $BASE — refusing to close {{issue}}." >&2
  echo "  The commits are still stranded on the work branch. This is the p5wrm violation;" >&2
  echo "  closing now would make the bead assert work that did not ship." >&2
  exit 1
fi
if [ -z "${LANDED_SHA:-}" ]; then   # "nothing to land" path — already on $BASE
  LANDED_SHA=$(git rev-parse --short "$BASE")
  bd update {{issue}} --set-metadata landed_sha="$LANDED_SHA"
fi
echo "OK: work/{{issue}} landed on $BASE at $LANDED_SHA"
```
Pushing/syncing $BASE to a remote is the rig's own concern, not this step — an
autonomous worker never pushes.

**4. Close the bead** — only now, with the commits provably on {{base_branch}}.
Record the landed SHA in the close reason: an empty close_reason is what made
the vdeyx/s1o2n forensics hard, and it is the fingerprint of an unsanctioned
close (a bare `bd close` from a step that had no business closing anything).

Self-contained, like step 3, and for the same reason: this is a separate process.
It re-asserts the invariant immediately before closing rather than trusting step
3's verdict — the gap between step 3's gate and this close spans an entire
tool-call boundary (seconds to minutes), and anything that moves {{base_branch}}
off the landed commit in that window (a human `git reset --hard`, a force-push
into the base tree) would otherwise produce exactly the state the gate exists to
prevent: bead closed, commits not on {{base_branch}}. The check is one command;
the window it closes is the widest one left.
```bash
WT=$(bd show {{issue}} --json | jq -r '.[0].metadata.work_dir // empty')
if [ -z "$WT" ] || [ ! -d "$WT" ]; then echo "FATAL: no per-bead worktree for {{issue}} — refusing to close" >&2; exit 1; fi

# THE INVARIANT, re-checked at the moment of the close. This is the assertion the
# whole bead exists to enforce, so make it the last thing that runs before it.
if ! git -C "$WT" merge-base --is-ancestor "refs/heads/work/{{issue}}" "{{base_branch}}"; then
  echo "FATAL: work/{{issue}} is no longer reachable from {{base_branch}} — refusing to close." >&2
  echo "  It landed in step 3, so {{base_branch}} was moved off it since (rewind? force-push?)." >&2
  echo "  Closing now would assert work that is not on {{base_branch}}. Re-run finalize." >&2
  exit 1
fi

# Read the SHA back from bd, not from a shell variable — step 3 ran in a different
# process and its variables are gone.
LANDED_SHA=$(bd show {{issue}} --json | jq -r '.[0].metadata.landed_sha // empty')
if [ -z "$LANDED_SHA" ]; then echo "FATAL: no landed_sha recorded by step 3 — did the land block run? Refusing to close." >&2; exit 1; fi

bd close {{issue}} -r "DONE: reviewed (review_verdict=pass) and landed on {{base_branch}} at $LANDED_SHA."
```

**5. Drain — you are done:**
```bash
gc runtime drain-ack
```

**Exit criteria:** `work/{{issue}}` is reachable from `{{base_branch}}`, the bead
is closed, and the worker drained. If landing failed, the bead is still OPEN and
this step hard-failed — nothing was closed."""
