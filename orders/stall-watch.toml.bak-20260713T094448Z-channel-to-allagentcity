# Stall-watch — eager, autonomous stall escalation to the human.
#
# Closes the "mayor-is-the-trigger" gap: detection of stalled work already
# existed (bin/mayor-health-surfacer) but only ran 2x/day and nudged MAYOR
# with "surface to stephanie at next interaction" — so stalls stayed invisible
# until Stephanie asked for status. This order runs the same detector every
# 15m, dedups findings against .gc/stall-watch-state.json, and pushes NEW /
# re-alerting stalls STRAIGHT to #gascity-maintenance (C0B25SS12CD). Mayor is
# the responder, never the trigger.
#
# Pushes only human-relevant signatures (WORK_STALLED, CAPACITY DOWN/>=80%,
# SESSIONS blocked/degraded). Normal asleep/suspended sessions + transient
# INFRA recoveries are filtered out. One channel post per run, max; each
# finding re-alerts at most once per 6h (STALL_WATCH_REALERT_HOURS).
#
# Greenlit by Stephanie 2026-06-08 (eager push contract) after discovering
# the #gascity-maintenance inbound binding had been silently dropping her
# messages for 8+ days.

[order]
description = "Every 15m: detect stalled work / down capacity / blocked sessions and push new+re-alerting findings straight to #gascity-maintenance. Dedup'd; silent when clean."
trigger = "cooldown"
interval = "15m"
exec = "/home/ds/gas-city/bin/stall-watch --push"
timeout = "5m"
