# city-selftest — run the bin/*.test regression suites and escalate red ones.
# Order name comes from the file basename: city-selftest.
#
# Created 2026-07-16. Authority: Stephanie, in-session (approved standing this
# order up after the incident below).
#
# Why: routed-bead-nudger.test was found RED for two days. The gc-xk1hg
# readiness gate landed in bin/routed-bead-nudger on 07-14 without a matching
# stub update, so `gc bd ... ready` returned '[]', READY_SET emptied, every
# candidate was filtered out, and all four behavioural assertions went to zero
# — on the LIVE backstop for the warm-pool-idle ("bead never claimed") stall.
# Nothing noticed, because nothing ran the suites: they executed only when a
# human remembered. The suites are the only regression cover the backstop
# scripts have. A check nobody runs is not a check.
#
# Read-only and idempotent: every bin/*.test is hermetic (mktemp -d fixtures,
# `gc`/`gh` stubs on PATH; tmp-reaper.test sources its reaper with
# TMP_REAPER_LIB=1 so no real /tmp scan runs). Verified 2026-07-16 before this
# order was created. Re-running changes nothing, so it is safe to re-fire.
# Fail-open on timeout (gastownhall/gascity#2893): a killed run escalates
# nothing and the next tick retries — it never blocks other work.
#
# Cadence: the whole suite runs in ~4s, so 6h is nearly free and bounds
# discovery of a regression at 6h instead of the two days this incident took.
# The true trigger is "a bin/ script changed"; a cooldown scan is the
# level-triggered approximation, which is the shape that cannot drift — see
# docs/design/durable-execution-walkthrough-pr-state-poller.md.
#
# Timeout math: CITY_SELFTEST_TIMEOUT caps EACH suite at 60s, so four suites
# are worst-case 240s, under the 300s order timeout. Raising the per-suite cap
# without raising `timeout` would let one hung suite eat the whole order and
# escalate nothing — the exact silent-failure shape this order exists to catch.
#
# Escalation: posts NEW failures and RECOVERED transitions to
# #gascity-maintenance (C0B25SS12CD), same channel and mechanism as stall-watch.
# Dedup'd against .gc/city-selftest-state.json; re-alerts at most daily while a
# suite stays red; silent when green. It reports only — a red suite is a
# human's call, never an automated fix or quarantine.
#
# Undo: delete this file, or rename to city-selftest.toml.disabled with the
# reason in its header. The suites still run by hand:
#   bash /home/ds/gas-city/bin/city-selftest          # dry-run
#   bash /home/ds/gas-city/bin/city-selftest --push   # live

[order]
description = "Every 6h: run the bin/*.test regression suites (the only cover for the city's backstop scripts) and push NEW failures / recoveries to #gascity-maintenance. Dedup'd; re-alerts at most daily while red; silent when green."
trigger = "cooldown"
interval = "6h"
exec = "/home/ds/gas-city/bin/city-selftest --push"
timeout = "300s"
idempotent = true

[order.env]
# Per-suite cap. 4 suites x 60s = 240s < the 300s order timeout above.
CITY_SELFTEST_TIMEOUT = "60"
# While a suite stays red, re-alert at most once a day rather than every tick.
CITY_SELFTEST_REALERT_HOURS = "24"
