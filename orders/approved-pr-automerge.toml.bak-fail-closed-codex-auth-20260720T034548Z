# approved-pr-automerge — Stephanie directive (mayor gc-429887). Whenever WE
# approve a gastownhall/gascity PR, enable GitHub auto-merge so it enters the merge
# queue (GitHub merges when checks pass) — never hand-merge again. NEVER merges
# directly; only ENABLES auto-merge. Deterministic + ZFC-clean.
#
# Hard gate (AMENDED gc-429945 — Codex-inclusive review required): ENABLE auto-merge
# only on a CURRENT Codex-inclusive APPROVE record (.gc/pr-pipeline/reviews/pr-<N>.md
# that mentions codex AND has an approve/take-the-good verdict, mtime >= latest
# commit). A bare GitHub approval is NOT sufficient -> instead DISPATCH our
# multi-model mol-pr-review (incl Codex), bounded + deduped, so a later tick enables
# once the Codex artifact lands. CURRENCY mitigation: commit after the review => skip.
# Hard carve-out: azanar PRs never auto-merge. Idempotent. Audit: every action.
#
# LIVE (--apply) per the directive (Stephanie wants it active). Squash is our style.
[order]
description = "Every 15m: ENABLE GitHub auto-merge (--squash --auto) on open non-draft gastownhall/gascity PRs with a CURRENT Codex-inclusive approve review; for github-approved-but-no-Codex PRs, DISPATCH a bounded mol-pr-review instead (Codex is a hard merge-queue precondition). Currency-checked, azanar-excluded, idempotent, fully audited. Only ENABLES auto-merge — GitHub merges when checks pass."
trigger = "cron"
schedule = "*/15 * * * *"
exec = "/home/ds/gas-city/bin/approved-pr-automerge --apply --nudge-mayor"
timeout = "5m"
