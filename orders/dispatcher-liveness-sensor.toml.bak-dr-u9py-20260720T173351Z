# dispatcher-liveness-sensor — out-of-band LOG-based liveness sensor for the
# control-dispatcher (gc-yn516). Catches the port-0 wedge (gc-74rxa/gc-462084) and the
# silent-hang class in MINUTES via the trace log — a bead-STATE health check structurally
# cannot see this (dispatcher looks active + roots look routed while its work-query
# resolves Dolt at 127.0.0.1:0 and reads zero work). Alerts mayor, cooldown-deduped.
[order]
description = "Every 5m: grep core.control-dispatcher-trace.log for the port-0 wedge (>=5 '127.0.0.1:0' errors in ~6m) and the silent-hang (newest line >12m old) signatures; mail mayor cooldown-deduped. Out-of-band log sensor for the class that bead-state health checks miss (gc-yn516; caught 27h late as gc-462084)."
trigger = "cooldown"
interval = "5m"
exec = "/home/ds/gas-city/bin/dispatcher-liveness-sensor --nudge-mayor"
timeout = "60s"
idempotent = true
