# RETIRED 2026-07-21 (order-layer consolidation, city audit sec 3 + epic gc-28w2).
# Evidence: weekly cron since 2026-05-28; NEVER produced an artifact
# (ls /home/ds/.gc/routing-report-* -> no matches, 2026-07-21). The FCTR
# Phase-2 consumer it measured for never shipped; Phase 1 was measure-only.
# Undo: rename back to .toml if the FCTR Phase-2 routing consumer ships and
# the ship gate (stamped Haiku share >= 25%) needs measuring again;
# bin/route-decide-report is retained on disk.
# Weekly routing-decision distribution report.
#
# Aggregates routing.* metadata stamped by the Formula-Compile-Time
# Router (FCTR) over the past 7 days. Phase 1 of the routing rollout
# (see /tmp/routing-layer-rfc-v3.md §4.7) is measure-only — formulas
# do not yet consume the stamped tier. This order shows what FCTR
# would have routed if the consumer side were live.
#
# Exit criteria for Phase 2 ship gate: stamped Haiku share ≥ 25%.

[order]
description = "Weekly Monday 09:30 EDT: aggregate FCTR routing decisions (model_tier, grounded_review, human_gate) stamped on beads in the past 7 days across all rigs."
trigger = "cron"
schedule = "30 9 * * 1"
exec = "/home/ds/gas-city/bin/route-decide-report --window 7d --output /home/ds/.gc/routing-report-$(date -u +%Y%m%d).json"
timeout = "5m"
