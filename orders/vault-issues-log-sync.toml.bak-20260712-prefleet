# vault-issues-log-sync — keep each rig's Obsidian `<Project> Issues Log.md`
# bead-state summary current so the log never goes fully stale when a PL misses
# its VAULT_NOTES morning check.
#
# WHY (2026-07-12, Stephanie via task): the AOA Issues Log went ~7 days stale
# (last content 2026-07-05, predating the 2026-07-10 arch review) because the
# narrative log depends on the PL's VAULT_NOTES directive firing every morning.
# The arch-review note stays fresh because velocity-audit-sensor mechanically
# nudges its refresh; the Issues Log had no equivalent mechanical backstop.
#
# WHAT: ZFC split. The PL still writes the NARRATIVE log (dated `### YYYY-MM-DD`
# entries with learnings + fixes) — that is model work and this order never
# touches it. This order does the MECHANICAL part only: regenerate a single
# fenced "Bead state (auto-synced <date>)" block at the TOP of each note from
# `gc bd --rig <slug> list`. Deterministic counting + formatting, no judgment.
#
# SAFETY (why this is not a clobber risk):
#   * SECTION-SCOPED: only rewrites content between the gc:issues-log-sync fence
#     markers; manual dated entries below the fence are never read or written.
#   * IDEMPOTENT: per-note sha256 sentinel (~/.gc/vault-issues-sync-sentinels/),
#     so the vault only gets a write when the rendered block actually changes —
#     no Syncthing churn. Verified: back-to-back runs → updated 0, skipped 1.
#   * READ-ONLY on beads; skips any note whose `project:` frontmatter does not
#     resolve to a live rig (suspended rigs / non-rig notes left untouched).
#   * DRY_RUN=1 supported for review; VAULT_PROJECTS_DIR scopes a manual run to
#     one folder (used to seed AOA on 2026-07-12 without touching other notes).
#
# trigger=cooldown deliberately (no zero-lastRun bootstrap trap; same reasoning
# as vault-status-mirror.toml / decision-ledger-push.toml).
#
# UNDO: this is non-destructive and section-scoped. To pause, add an
# [[orders.overrides]] enabled=false block in city.toml (change-control skill),
# or rename this file to .toml.disabled. To stop it managing a specific note,
# delete that note's gc:issues-log-sync fence (it will not be re-inserted unless
# the H1 anchor is present) or remove the note's `project-issues` tag.
[order]
description = "Every 6h: regenerate the fenced bead-state summary at the top of each rig's Obsidian '<Project> Issues Log.md' from gc bd state. Section-scoped + sha-idempotent; never touches the human-written narrative log."
trigger = "cooldown"
interval = "6h"
exec = "/home/ds/gas-city/bin/vault-issues-log-sync"
timeout = "5m"
idempotent = true

# Scoped to AOA 2026-07-12 per Stephanie: she asked to keep the AOA Issues Log
# current; the sync mechanism is generalizable to all rigs but writing an
# auto-block into ~9 other vault notes is a broader vault footprint than she
# asked for. Remove VAULT_PROJECTS_DIR (or point it at /home/ds/brain/Projects)
# to generalize once she okays the fleet-wide rollout.
[order.env]
VAULT_PROJECTS_DIR = "/home/ds/brain/Projects/AOA"
