sh -c 'for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; r=$(bd ready --include-ephemeral --assignee="$id" --json --limit=20 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && r=$(printf "%s" "$r" | jq -c '\''[.[] | select(((.metadata|type) != "object" or ((.metadata["gc.disarmed"]) as $d | $d == null or $d == false or (($d|type) == "string" and (($d|ascii_downcase|gsub("^\\s+|\\s+$";"")) | . == "" or . == "false")))))]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; printf "[]"'