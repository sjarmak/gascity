sh -c 'target="$1"; ready_json=$(bd ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --json --limit 0 | jq '\''[.[] | select((.metadata|type) != "object" or (.metadata|has("gc.disarmed")|not) or ((.metadata["gc.disarmed"]) as $d | $d == false or (($d|type) == "string" and (($d|ascii_downcase|gsub("^\\s+|\\s+$";"")) | . == "" or . == "false"))))]'\'') || exit $?; legacy_candidates=$(bd ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")]'\'') || exit $?; legacy_ephemeral_json=$(printf "[]"); printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s "(add // []) | unique_by(.id) | length"' -- worker-pool