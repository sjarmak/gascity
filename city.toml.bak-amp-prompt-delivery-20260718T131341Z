[providers.amp]
base = "builtin:amp"
# 2026-07-17: Amp-native mayor profile. New mayor threads start in high mode;
# resumed threads retain their creation mode. Global/project plugins provide
# hooks, safety, shared assets, and high-mode specialist delegation.
args = ["--no-ide", "--mode", "high"]
supports_hooks = true
instructions_file = "AGENTS.md"
resume_command = "amp --no-ide --mode high threads continue {{.SessionKey}}"

[providers.amp-medium]
