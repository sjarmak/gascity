#!/usr/bin/env bash
# lint-mem-cap-test — self-test for scripts/lib/lint-mem-cap.sh and
# scripts/lint-run.sh (gc-vrva1q).
#
# Exercises the memory-fence decision matrix with a fake systemd-run on a
# fully controlled PATH: an accepted cap actually applies and propagates a
# real kill's exit status; a value systemd rejects is a hard failure that
# never runs the wrapped command; a missing/unreachable systemd manager
# warns on stderr and falls back to plain execution; the explicit opt-out
# stays silent. Also covers lint-run.sh's own argv construction: GOMEMLIMIT
# reaches the child, --concurrency is injected only for "run" and never for
# "fmt", and a caller-supplied --concurrency/-j is never overridden.
#
# Run directly:    scripts/lint-mem-cap-test
# Run via go test: go test ./scripts -run TestLintMemCap

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mem_cap_lib="$repo_root/scripts/lib/lint-mem-cap.sh"
lint_run="$repo_root/scripts/lint-run.sh"

work="$(mktemp -d "${TMPDIR:-/var/tmp}/gc-lint-mem-cap-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT

failures=0
fail() {
  echo "FAIL: $*" >&2
  failures=$((failures + 1))
}

for f in "$mem_cap_lib" "$lint_run"; do
  [[ -f "$f" ]] || { echo "FAIL: missing $f" >&2; exit 1; }
done

if shellcheck --version >/dev/null 2>&1; then
  if ! shellcheck -e SC2119,SC2120,SC1091 "$mem_cap_lib" "$lint_run" "${BASH_SOURCE[0]}"; then
    fail "shellcheck reported issues"
  fi
elif command -v shellcheck >/dev/null 2>&1; then
  echo "warning: shellcheck on PATH but not runnable (untrusted mise shim?); skipping shell lint" >&2
else
  echo "note: shellcheck not installed; skipping lint" >&2
fi

# ── fake systemd-run variants ────────────────────────────────────────────

# Accepts any MemoryMax matching systemd's own grammar (digits + K/M/G/T,
# no "i", no trailing "B"); rejects everything else, including Go's GiB
# spelling — mirrors real systemd's behavior closely enough to exercise the
# bad-value branch without a live systemd manager.
write_fake_systemd_run() {
  local path="$1" log="$2"
  cat >"$path" <<FAKE
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "\$*" >>"$log"
mem=""
swap=""
args=("\$@")
for ((i=0; i<\${#args[@]}; i++)); do
  if [[ "\${args[i]}" == -p && "\${args[i+1]}" == MemoryMax=* ]]; then
    mem="\${args[i+1]#MemoryMax=}"
  fi
  if [[ "\${args[i]}" == -p && "\${args[i+1]}" == MemorySwapMax=* ]]; then
    swap="\${args[i+1]#MemorySwapMax=}"
  fi
done
if [[ -n "\$mem" && ! "\$mem" =~ ^[0-9]+[KMGT]?\$ ]]; then
  echo "fake systemd-run: invalid MemoryMax value: \$mem" >&2
  exit 1
fi
if [[ -n "\$swap" && ! "\$swap" =~ ^[0-9]+[KMGT]?\$ ]]; then
  echo "fake systemd-run: invalid MemorySwapMax value: \$swap" >&2
  exit 1
fi
while [[ \$# -gt 0 && "\$1" != "--" ]]; do shift; done
if [[ \$# -gt 0 ]]; then shift; fi
exec "\$@"
FAKE
  chmod +x "$path"
}

# A fake systemd-run that actually enforces a byte ceiling against a
# growing allocator, so the "cap really kills" path is proven rather than
# just argv-checked: it lets the child run only up to a fixed number of
# reads of its stdout progress log before SIGKILLing it.
write_fake_systemd_run_enforcing() {
  local path="$1" log="$2" max_lines="$3"
  cat >"$path" <<FAKE
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "\$*" >>"$log"
while [[ \$# -gt 0 && "\$1" != "--" ]]; do shift; done
if [[ \$# -gt 0 ]]; then shift; fi
"\$@" &
child=\$!
count=0
while kill -0 "\$child" 2>/dev/null; do
  count=\$((count + 1))
  if [[ "\$count" -ge $max_lines ]]; then
    kill -KILL "\$child" 2>/dev/null || true
    wait "\$child" 2>/dev/null || true
    exit 137
  fi
  sleep 0.05
done
wait "\$child"
FAKE
  chmod +x "$path"
}

write_fake_systemd_run_down() {
  local path="$1" log="$2"
  cat >"$path" <<FAKE
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "\$*" >>"$log"
echo "Failed to connect to bus: No medium found" >&2
exit 1
FAKE
  chmod +x "$path"
}

write_growing_hog() {
  local path="$1"
  cat >"$path" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
i=0
while true; do
  i=$((i + 1))
  echo "tick $i"
  sleep 0.05
done
FAKE
  chmod +x "$path"
}

write_argv_echo_lint() {
  local path="$1" log="$2"
  cat >"$path" <<FAKE
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$log"
FAKE
  chmod +x "$path"
}

minimal_toolbox() {
  local dir="$1"
  mkdir -p "$dir"
  local tool
  for tool in bash sh cat true false grep sed cut tr sleep env kill touch dirname mktemp; do
    ln -sf "$(type -P "$tool")" "$dir/$tool" 2>/dev/null || true
  done
}

# All scenarios below drive gc_lint_mem_cap_exec the same way production
# does: `bash -c "set -euo pipefail; source ...; gc_lint_mem_cap_exec ..."`.
# lint-run.sh runs under `set -euo pipefail` itself, and
# gc_lint_mem_cap_available returns non-zero for every non-"ok" outcome --
# a plain `bash -c "source ...; ..."` with errexit OFF (as this file used
# to invoke it) cannot see a bug that only bites under errexit, and it
# missed exactly that bug once already (round 3, gc-vrva1q).
# run_capped is invoked as: env -i PATH=... VAR=... run_capped 'quoted-arg'
# `env -i` clears the environment for isolation, which also strips any
# shell function definitions -- so this must be a real command, not a
# function. It re-execs bash itself with the errexit/nounset/pipefail
# options production actually runs under.
cat >"$work/run_capped" <<RUNCAPPED
#!/usr/bin/env bash
set -euo pipefail
source '$mem_cap_lib'
eval "gc_lint_mem_cap_exec \$*"
RUNCAPPED
chmod +x "$work/run_capped"
run_capped="$work/run_capped"

# ── C1: an accepted cap value really kills an overshoot ─────────────────
scenario="$work/enforcing"
mkdir -p "$scenario"
sdr_log="$scenario/systemd-run.log"
: >"$sdr_log"
minimal_toolbox "$scenario/bin"
write_fake_systemd_run_enforcing "$scenario/bin/systemd-run" "$sdr_log" 5
write_growing_hog "$scenario/hog"

set +e
out="$(env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX=300M GC_LINT_MEMORY_SWAP_MAX=100M \
  "$run_capped" "'$scenario/hog'" 2>&1)"
status=$?
set -e
if [[ "$status" -ne 137 ]]; then
  fail "C1: expected exit 137 from an enforced overshoot, got $status: $out"
fi
# gc_lint_mem_cap_available makes two probe calls (manager-reachable, then
# value-accepted) before the real capped exec: three total.
if [[ "$(wc -l <"$sdr_log" | tr -d '[:space:]')" -ne 3 ]]; then
  fail "C1: expected exactly three systemd-run invocations (2 probes + 1 real), got $(cat "$sdr_log")"
fi
# The real (third) invocation must actually carry both ceilings -- catches
# a regression that strips -p MemoryMax= or -p MemorySwapMax= from the
# real exec while leaving the probes intact.
real_invocation="$(tail -n1 "$sdr_log")"
if [[ "$real_invocation" != *"-p MemoryMax=300M"* ]]; then
  fail "C1: real systemd-run invocation missing -p MemoryMax=300M: $real_invocation"
fi
if [[ "$real_invocation" != *"-p MemorySwapMax=100M"* ]]; then
  fail "C1: real systemd-run invocation missing -p MemorySwapMax=100M: $real_invocation"
fi
# gc-vrva1q round 2: a cap-hit kill must be a legible stderr diagnostic, not
# a bare exit code -- the whole point being that a seat that hits the cap
# can read why, without reading this script. The fake systemd-run enforces
# the kill exactly like the real cgroup would (SIGKILL, exit 137); no
# systemctl exists on this scenario's PATH, so this also exercises the
# SIGKILL-consistent-but-unconfirmed fallback wording, not the confirmed
# Result=oom-kill path.
if ! grep -qi "memory cap" <<<"$out"; then
  fail "C1: cap-hit kill did not report a legible memory-cap diagnostic on stderr: $out"
fi
if [[ "$out" != *"GC_LINT_MEMORY_MAX=300M"* ]]; then
  fail "C1: cap-hit diagnostic did not name the value in force: $out"
fi
if ! grep -qi "GC_LINT_MEMORY_MAX" <<<"$out"; then
  fail "C1: cap-hit diagnostic did not name the variable that sets the cap: $out"
fi
if ! grep -qiE "raise|reduce" <<<"$out"; then
  fail "C1: cap-hit diagnostic did not tell the reader their options: $out"
fi

# ── C2: a value systemd rejects is a hard failure, command never runs ───
scenario="$work/bad-value"
mkdir -p "$scenario"
sdr_log="$scenario/systemd-run.log"
: >"$sdr_log"
minimal_toolbox "$scenario/bin"
write_fake_systemd_run "$scenario/bin/systemd-run" "$sdr_log"
marker="$scenario/ran"
cat >"$scenario/hog" <<FAKE
#!/usr/bin/env bash
touch "$marker"
FAKE
chmod +x "$scenario/hog"

for bad in 12GiB 12GB 12Gi 12g bogus infinity Infinity; do
  set +e
  out="$(env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX="$bad" \
    "$run_capped" "'$scenario/hog'" 2>&1)"
  status=$?
  set -e
  if [[ "$status" -eq 0 ]]; then
    fail "C2: GC_LINT_MEMORY_MAX=$bad was accepted (silently uncapped); want a hard failure"
  fi
  if [[ -e "$marker" ]]; then
    fail "C2: GC_LINT_MEMORY_MAX=$bad let the wrapped command run"
    rm -f "$marker"
  fi
  if ! grep -qi "rejected" <<<"$out"; then
    fail "C2: GC_LINT_MEMORY_MAX=$bad did not report a rejection: $out"
  fi
done

# a bad swap ceiling must be caught by the same probe, not surface later
# as a raw systemd error from the real invocation.
set +e
out="$(env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX=7G GC_LINT_MEMORY_SWAP_MAX=bogus \
  "$run_capped" "'$scenario/hog'" 2>&1)"
status=$?
set -e
if [[ "$status" -eq 0 ]]; then
  fail "C2: GC_LINT_MEMORY_SWAP_MAX=bogus was accepted (silently uncapped); want a hard failure"
fi
if [[ -e "$marker" ]]; then
  fail "C2: GC_LINT_MEMORY_SWAP_MAX=bogus let the wrapped command run"
  rm -f "$marker"
fi
if ! grep -qi "rejected" <<<"$out"; then
  fail "C2: GC_LINT_MEMORY_SWAP_MAX=bogus did not report a rejection: $out"
fi

# accepted spellings must still work through the same probe.
for good in 7G 300M 1T; do
  set +e
  out="$(env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX="$good" \
    "$run_capped" "'$scenario/hog'" 2>&1)"
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    fail "C2: GC_LINT_MEMORY_MAX=$good was rejected; want accepted: $out"
  fi
  if [[ ! -e "$marker" ]]; then
    fail "C2: GC_LINT_MEMORY_MAX=$good did not run the wrapped command"
  fi
  rm -f "$marker"
done

# ── C3: no responsive systemd manager warns and falls back to plain ─────
scenario="$work/no-manager"
mkdir -p "$scenario"
sdr_log="$scenario/systemd-run.log"
: >"$sdr_log"
minimal_toolbox "$scenario/bin"
write_fake_systemd_run_down "$scenario/bin/systemd-run" "$sdr_log"
cat >"$scenario/hog" <<'FAKE'
#!/usr/bin/env bash
echo "hog ran"
FAKE
chmod +x "$scenario/hog"

set +e
out="$(env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX=300M \
  "$run_capped" "'$scenario/hog'" 2>&1)"
status=$?
set -e
if [[ "$status" -ne 0 ]]; then
  fail "C3: expected the fallback to run and exit 0, got $status: $out"
fi
if ! grep -qi "WARNING" <<<"$out"; then
  fail "C3: no-manager fallback did not warn: $out"
fi
if ! grep -qF "hog ran" <<<"$out"; then
  fail "C3: no-manager fallback did not run the wrapped command: $out"
fi

# the documented escape hatch (GC_LINT_NO_MEM_CAP=1) must reach exec even
# when a systemd manager IS reachable -- this is the round-3 errexit bug's
# other victim: `status="$(gc_lint_mem_cap_available)"` without `|| true`
# killed the function before the no-manager case ever ran.
scenario2="$work/no-manager-optout-with-manager"
mkdir -p "$scenario2"
minimal_toolbox "$scenario2/bin"
write_fake_systemd_run "$scenario2/bin/systemd-run" "$scenario2/systemd-run.log"
cat >"$scenario2/hog" <<'FAKE'
#!/usr/bin/env bash
echo "hog ran"
FAKE
chmod +x "$scenario2/hog"
set +e
out="$(env -i PATH="$scenario2/bin" GC_LINT_MEMORY_MAX=7G GC_LINT_NO_MEM_CAP=1 \
  "$run_capped" "'$scenario2/hog'" 2>&1)"
status=$?
set -e
if [[ "$status" -ne 0 ]]; then
  fail "C3b: GC_LINT_NO_MEM_CAP=1 with a reachable manager did not run cleanly, got $status: $out"
fi
if ! grep -qF "hog ran" <<<"$out"; then
  fail "C3b: GC_LINT_NO_MEM_CAP=1 with a reachable manager did not run the wrapped command: $out"
fi

# ── C4: explicit opt-out stays silent ────────────────────────────────────
set +e
out="$(env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX=300M GC_LINT_NO_MEM_CAP=1 \
  "$run_capped" "'$scenario/hog'" 2>&1)"
status=$?
set -e
if [[ "$status" -ne 0 ]]; then
  fail "C4: opt-out fallback did not run cleanly, got $status: $out"
fi
if grep -qi "WARNING" <<<"$out"; then
  fail "C4: opt-out fallback warned; want silent: $out"
fi

# ── C4b: an unrecognized probe status fails loud instead of no-op-passing ─
set +e
out="$(bash -c "
  set -euo pipefail
  source '$mem_cap_lib'
  gc_lint_mem_cap_available() { echo something-unexpected; return 1; }
  gc_lint_mem_cap_exec /bin/true
" 2>&1)"
status=$?
set -e
if [[ "$status" -eq 0 ]]; then
  fail "C4b: an unrecognized cap status returned success without running anything; want a hard failure"
fi
if ! grep -qi "unrecognized status" <<<"$out"; then
  fail "C4b: an unrecognized cap status did not report the internal-error diagnostic: $out"
fi

# ── C4c: shipped defaults are the measured-safe values, not decoration ──
# Round 1's defect was a ceiling set ABOVE every measured peak (12G /
# 10GiB against an 8.08-9.85 GiB measured range), so it never engaged.
# Pin the actual shipped numbers so a future edit can't silently widen
# them back past the peak without this test noticing.
defaults_out="$(bash -c "
  set -euo pipefail
  source '$mem_cap_lib'
  printf '%s %s\n' \"\$GC_LINT_MEMORY_MAX\" \"\$GC_LINT_MEMORY_SWAP_MAX\"
")"
if [[ "$defaults_out" != "7G 2G" ]]; then
  fail "C4c: default GC_LINT_MEMORY_MAX/GC_LINT_MEMORY_SWAP_MAX = '$defaults_out', want '7G 2G'"
fi
gomemlimit_default="$(grep -oE 'GC_LINT_GOMEMLIMIT:=[^}]+' "$lint_run" | cut -d= -f2)"
if [[ "$gomemlimit_default" != "3GiB" ]]; then
  fail "C4c: default GC_LINT_GOMEMLIMIT = '$gomemlimit_default', want '3GiB'"
fi

# ── C5: lint-run.sh argv construction ────────────────────────────────────
scenario="$work/argv"
mkdir -p "$scenario"
sdr_log="$scenario/systemd-run.log"
: >"$sdr_log"
minimal_toolbox "$scenario/bin"
write_fake_systemd_run "$scenario/bin/systemd-run" "$sdr_log"
lint_log="$scenario/lint.log"
: >"$lint_log"
write_argv_echo_lint "$scenario/golangci-lint" "$lint_log"

# shellcheck disable=SC2120
run_lint() {
  : >"$lint_log"
  env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX=7G "$@" \
    "$lint_run" "$scenario/golangci-lint" "${lint_args[@]}"
}

lint_args=(run ./...)
run_lint
if [[ "$(cat "$lint_log")" != "run --concurrency 1 ./..." ]]; then
  fail "C5: run with no caller concurrency = $(cat "$lint_log"), want 'run --concurrency 1 ./...'"
fi

lint_args=(run --concurrency 4 ./...)
run_lint
if [[ "$(cat "$lint_log")" != "run --concurrency 4 ./..." ]]; then
  fail "C5: caller-supplied --concurrency was overridden: $(cat "$lint_log")"
fi

lint_args=(run -j4 ./...)
run_lint
if [[ "$(cat "$lint_log")" != "run -j4 ./..." ]]; then
  fail "C5: caller-supplied -j was overridden: $(cat "$lint_log")"
fi

lint_args=(fmt --diff ./...)
run_lint
if [[ "$(cat "$lint_log")" == *"--concurrency"* ]]; then
  fail "C5: fmt received --concurrency, which golangci-lint fmt rejects: $(cat "$lint_log")"
fi
if [[ "$(cat "$lint_log")" != "fmt --diff ./..." ]]; then
  fail "C5: fmt argv unexpected: $(cat "$lint_log")"
fi

# GOMEMLIMIT must reach the child.
write_argv_echo_lint "$scenario/golangci-lint" "$lint_log"
cat >"$scenario/golangci-lint" <<FAKE
#!/usr/bin/env bash
printf 'GOMEMLIMIT=%s\n' "\${GOMEMLIMIT:-<unset>}" >>"$lint_log"
FAKE
chmod +x "$scenario/golangci-lint"
lint_args=(run ./...)
: >"$lint_log"
env -i PATH="$scenario/bin" GC_LINT_MEMORY_MAX=7G GC_LINT_GOMEMLIMIT=4GiB \
  "$lint_run" "$scenario/golangci-lint" "${lint_args[@]}"
if [[ "$(cat "$lint_log")" != "GOMEMLIMIT=4GiB" ]]; then
  fail "C5: GOMEMLIMIT did not reach the child: $(cat "$lint_log")"
fi

if [[ "$failures" -ne 0 ]]; then
  echo "lint-mem-cap-test: $failures failure(s)" >&2
  exit 1
fi
echo "lint-mem-cap-test: all scenarios passed"
